
{{ 'iamw-brain-landing.css' | asset_url | stylesheet_tag }}
<section class="iamw-brain-section iamw-routine-bundle" style="--iamw-bg:{{ section.settings.background }};--iamw-text:{{ section.settings.text_color }};--iamw-accent:{{ section.settings.accent_color }};--iamw-radius:{{ section.settings.border_radius }}px;--iamw-content:{{ section.settings.content_width }}px;--iamw-pad-desktop:{{ section.settings.padding_desktop }}px;--iamw-pad-mobile:{{ section.settings.padding_mobile }}px;--iamw-heading-desktop:{{ section.settings.heading_size_desktop }}px;--iamw-heading-mobile:{{ section.settings.heading_size_mobile }}px;{% if section.settings.button_color != blank %}--iamw-button:{{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}--iamw-button-text:{{ section.settings.button_text_color }};{% endif %}" >
  <div class="iamw-brain-wrap">
    <div class="iamw-center" style="text-align:{{ section.settings.text_alignment }}">
      {% if section.settings.eyebrow != blank %}<div class="iamw-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="iamw-heading">{{ section.settings.heading }}</h2>{% endif %}
      {% assign pills = section.blocks | where: 'type', 'pill' %}
      {% if pills.size > 0 %}
        <div class="iamw-pill-row">
          {% for block in pills %}
            {% if block.settings.label != blank %}<span class="iamw-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>{% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="iamw-routine-bundle__panel iamw-brain-card">
      <div class="iamw-routine-bundle__copy">
        {% if section.settings.card_heading != blank %}<h3>{{ section.settings.card_heading }}</h3>{% endif %}
        {% if section.settings.description != blank %}<div class="iamw-copy iamw-muted">{{ section.settings.description }}</div>{% endif %}
        {% assign supports = section.blocks | where: 'type', 'support' %}
        {% if supports.size > 0 %}
          <div class="iamw-routine-bundle__supports">
            {% for block in supports %}
              {% if block.settings.text != blank %}
                <div class="iamw-routine-bundle__support" {{ block.shopify_attributes }}>
                  <div class="iamw-iconbox">{% render 'iamw-icon', name: block.settings.icon, color: section.settings.text_color %}</div>
                  <span>{{ block.settings.text }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <a class="iamw-btn{% if section.settings.button_style == 'outline' %} iamw-btn--outline{% endif %}" href="{{ section.settings.button_link | default: '#brain-product-offer' }}">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>
      <div class="iamw-routine-bundle__image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600,900,1200,1500', sizes: '(min-width:768px) 50vw, 100vw', alt: section.settings.image_alt }}
        {% else %}
          <div class="iamw-placeholder">Choose the Smart Routine bundle image</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
<style>
#shopify-section-{{ section.id }} .iamw-center{max-width:840px;margin:0 auto 24px}
#shopify-section-{{ section.id }} .iamw-routine-bundle__panel{display:grid;grid-template-columns:1fr}
#shopify-section-{{ section.id }} .iamw-routine-bundle__copy{padding:28px}
#shopify-section-{{ section.id }} .iamw-routine-bundle__copy h3{font-size:34px;line-height:1.02;margin:0 0 12px;color:var(--iamw-text)}
#shopify-section-{{ section.id }} .iamw-routine-bundle__supports{display:grid;gap:12px;margin-top:22px}
#shopify-section-{{ section.id }} .iamw-routine-bundle__support{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700}
#shopify-section-{{ section.id }} .iamw-routine-bundle__copy .iamw-btn{margin-top:22px}
#shopify-section-{{ section.id }} .iamw-routine-bundle__image{min-height:300px;background:#efe7f6}
#shopify-section-{{ section.id }} .iamw-routine-bundle__image img{display:block;width:100%;height:100%;min-height:300px;object-fit:cover}
@media(min-width:800px){
  #shopify-section-{{ section.id }} .iamw-routine-bundle__panel{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}
  #shopify-section-{{ section.id }} .iamw-routine-bundle__copy{padding:44px}
  #shopify-section-{{ section.id }} .iamw-routine-bundle__supports{grid-template-columns:repeat(3,minmax(0,1fr))}
  #shopify-section-{{ section.id }} .iamw-routine-bundle__image img{min-height:430px}
}
</style>

{% schema %}
{
  "name": "IAMW Routine Bundle",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SMART NUTRITION. BRIGHTER DAYS."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Smart Routine Bundle for Brain Support"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Card heading",
      "default": "A simple daily routine for brighter tomorrows"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A complete, great tasting bundle with key nutrients to help support focus, learning, memory and everyday brain development.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "IAMWELL Smart Routine bundle"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP THE BUNDLE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f3e9ff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4b168f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ff9a1f"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 24,
      "max": 52,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Padding desktop",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Padding mobile",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#5a1aa8"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Brain Support"
        }
      ]
    },
    {
      "type": "support",
      "name": "Support item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "brain",
              "label": "Brain"
            },
            {
              "value": "shield",
              "label": "Shield"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Kid approved taste"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "IAMW Routine Bundle",
      "blocks": [
        {
          "type": "pill",
          "settings": {
            "label": "Brain Support"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Focus & Learning"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Daily Nutrition"
          }
        },
        {
          "type": "pill",
          "settings": {
            "label": "Great Taste"
          }
        },
        {
          "type": "support",
          "settings": {
            "icon": "leaf",
            "text": "Kid approved taste"
          }
        },
        {
          "type": "support",
          "settings": {
            "icon": "heart",
            "text": "Trusted by parents"
          }
        },
        {
          "type": "support",
          "settings": {
            "icon": "star",
            "text": "Complete daily support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
