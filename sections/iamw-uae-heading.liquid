{% style %}
  #shopify-section-{{ section.id }} .iamw-uae-heading {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .iamw-uae-heading__inner {
    width: min(calc(100% - 32px), {{ section.settings.page_width }}px);
    margin: 0 auto;
    text-align: {{ section.settings.alignment }};
  }
  #shopify-section-{{ section.id }} .iamw-uae-heading__title {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 700;
    text-transform: {{ section.settings.text_transform }};
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .iamw-uae-heading__title {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<section class="iamw-uae-heading">
  <div class="iamw-uae-heading__inner">
    {% if section.settings.heading != blank %}
      <h2 class="iamw-uae-heading__title">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "IAMW UAE Heading",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Section heading"},
    {"type":"select","id":"alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"select","id":"text_transform","label":"Text case","options":[{"value":"none","label":"Normal"},{"value":"uppercase","label":"Uppercase"}],"default":"uppercase"},
    {"type":"range","id":"heading_size","label":"Desktop heading size","min":16,"max":64,"step":1,"unit":"px","default":24},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":14,"max":48,"step":1,"unit":"px","default":22},
    {"type":"range","id":"page_width","label":"Page width","min":800,"max":1600,"step":20,"unit":"px","default":1260},
    {"type":"range","id":"padding_top","label":"Padding top","min":0,"max":120,"step":2,"unit":"px","default":18},
    {"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":120,"step":2,"unit":"px","default":0},
    {"type":"color","id":"background","label":"Background","default":"#f8f1ff"},
    {"type":"color","id":"text_color","label":"Text color","default":"#000000"}
  ],
  "presets": [{"name":"IAMW UAE Heading"}]
}
{% endschema %}
