{{ 'iamw-brain-landing.css' | asset_url | stylesheet_tag }}

<section class="iamw-brain-section iamw-final-cta" style="--iamw-bg:{{ section.settings.background }};--iamw-text:{{ section.settings.text_color }};--iamw-accent:{{ section.settings.accent_color }};--iamw-radius:{{ section.settings.border_radius }}px;--iamw-content:{{ section.settings.content_width }}px;--iamw-pad-desktop:{{ section.settings.padding_desktop }}px;--iamw-pad-mobile:{{ section.settings.padding_mobile }}px;--iamw-heading-desktop:{{ section.settings.heading_size_desktop }}px;--iamw-heading-mobile:{{ section.settings.heading_size_mobile }}px;--iamw-button:{{ section.settings.button_color }};--iamw-button-text:{{ section.settings.button_text_color }};">
  <div class="iamw-brain-wrap">
    <div class="iamw-final-cta__panel iamw-brain-card">
      <div class="iamw-final-cta__image">
        {% if section.settings.image != blank %}
          <picture>
            {% if section.settings.mobile_image != blank %}
              <source media="(max-width:767px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
            {% endif %}
            {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600,900,1200,1500', sizes: '(min-width:768px) 45vw, 100vw', alt: section.settings.image_alt }}
          </picture>
        {% else %}
          <div class="iamw-placeholder">Choose a parent and child image</div>
        {% endif %}
      </div>

      <div class="iamw-final-cta__copy">
        {% if section.settings.eyebrow != blank %}<div class="iamw-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="iamw-heading">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.description != blank %}<div class="iamw-copy iamw-muted">{{ section.settings.description }}</div>{% endif %}

        {% if section.settings.button_text != blank %}
          <a class="iamw-btn{% if section.settings.button_style == 'outline' %} iamw-btn--outline{% endif %}" href="{{ section.settings.button_link | default: '#brain-product-offer' }}">
            {{ section.settings.button_text }} <span aria-hidden="true">→</span>
          </a>
        {% endif %}

        {% if section.settings.benefit_1 != blank or section.settings.benefit_2 != blank or section.settings.benefit_3 != blank %}
          <div class="iamw-final-cta__benefits">
            {% if section.settings.benefit_1 != blank %}
              <div class="iamw-final-cta__benefit">
                <div class="iamw-iconbox">{% render 'iamw-icon', name: 'brain', color: section.settings.text_color %}</div>
                <span>{{ section.settings.benefit_1 }}</span>
              </div>
            {% endif %}
            {% if section.settings.benefit_2 != blank %}
              <div class="iamw-final-cta__benefit">
                <div class="iamw-iconbox">{% render 'iamw-icon', name: 'star', color: section.settings.text_color %}</div>
                <span>{{ section.settings.benefit_2 }}</span>
              </div>
            {% endif %}
            {% if section.settings.benefit_3 != blank %}
              <div class="iamw-final-cta__benefit">
                <div class="iamw-iconbox">{% render 'iamw-icon', name: 'heart', color: section.settings.text_color %}</div>
                <span>{{ section.settings.benefit_3 }}</span>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
#shopify-section-{{ section.id }} .iamw-final-cta__panel{display:grid;grid-template-columns:1fr}
#shopify-section-{{ section.id }} .iamw-final-cta__image{min-height:280px}
#shopify-section-{{ section.id }} .iamw-final-cta__image img{display:block;width:100%;height:100%;min-height:280px;object-fit:cover}
#shopify-section-{{ section.id }} .iamw-final-cta__copy{padding:28px;text-align:{{ section.settings.text_alignment }}}
#shopify-section-{{ section.id }} .iamw-final-cta__copy .iamw-btn{margin-top:22px}
#shopify-section-{{ section.id }} .iamw-final-cta__benefits{display:grid;gap:12px;margin-top:22px}
#shopify-section-{{ section.id }} .iamw-final-cta__benefit{display:flex;gap:10px;align-items:center;font-size:13px;font-weight:700;text-align:left}
@media(min-width:800px){
  #shopify-section-{{ section.id }} .iamw-final-cta__panel{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}
  #shopify-section-{{ section.id }} .iamw-final-cta__copy{padding:44px;display:flex;flex-direction:column;justify-content:center}
  #shopify-section-{{ section.id }} .iamw-final-cta__benefits{grid-template-columns:repeat(3,minmax(0,1fr))}
  #shopify-section-{{ section.id }} .iamw-final-cta__image img{min-height:420px}
}
</style>

{% schema %}
{
  "name": "IAMW Final CTA",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"BRIGHT MINDS. HAPPIER TOMORROWS."},
    {"type":"text","id":"heading","label":"Heading","default":"Give your child a brighter everyday."},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Help support their focus, learning, memory and growing minds with a simple daily routine.</p>"},
    {"type":"text","id":"button_text","label":"Button text","default":"SHOP THE SMART ROUTINE BUNDLE"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"image_picker","id":"image","label":"Lifestyle image"},
    {"type":"image_picker","id":"mobile_image","label":"Mobile image"},
    {"type":"text","id":"image_alt","label":"Image alt text","default":"Happy parent and child"},
    {"type":"text","id":"benefit_1","label":"Benefit 1","default":"Brain support for growing kids"},
    {"type":"text","id":"benefit_2","label":"Benefit 2","default":"Great tasting and kid approved"},
    {"type":"text","id":"benefit_3","label":"Benefit 3","default":"Trusted by parents"},
    {"type":"color","id":"background","label":"Background","default":"#f4ebff"},
    {"type":"color","id":"text_color","label":"Text color","default":"#4b168f"},
    {"type":"color","id":"accent_color","label":"Accent color","default":"#ff9a1f"},
    {"type":"range","id":"heading_size_desktop","label":"Heading size desktop","min":28,"max":72,"step":2,"unit":"px","default":52},
    {"type":"range","id":"heading_size_mobile","label":"Heading size mobile","min":24,"max":52,"step":2,"unit":"px","default":36},
    {"type":"range","id":"content_width","label":"Content width","min":900,"max":1400,"step":20,"unit":"px","default":1180},
    {"type":"range","id":"padding_desktop","label":"Padding desktop","min":20,"max":100,"step":4,"unit":"px","default":56},
    {"type":"range","id":"padding_mobile","label":"Padding mobile","min":16,"max":72,"step":4,"unit":"px","default":32},
    {"type":"range","id":"border_radius","label":"Border radius","min":0,"max":40,"step":2,"unit":"px","default":24},
    {"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},
    {"type":"select","id":"button_style","label":"Button style","options":[{"value":"solid","label":"Solid"},{"value":"outline","label":"Outline"}],"default":"solid"},
    {"type":"color","id":"button_color","label":"Button color","default":"#5a1aa8"},
    {"type":"color","id":"button_text_color","label":"Button text color","default":"#ffffff"}
  ],
  "presets": [{"name":"IAMW Final CTA"}]
}
{% endschema %}
