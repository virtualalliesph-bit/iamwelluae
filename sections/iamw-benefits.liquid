<section class="iamw-benefits iamw-benefits--{{ section.id }}">
  <div class="iamw-benefits__inner">
    <header class="iamw-benefits__header">
      {% if section.settings.eyebrow != blank %}<div class="iamw-benefits__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.intro != blank %}<div class="iamw-benefits__intro rte">{{ section.settings.intro }}</div>{% endif %}
    </header>

    <div class="iamw-benefits__grid">
      <div class="iamw-benefits__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500,800,1200,1600', sizes: '(min-width: 900px) 48vw, 100vw', class: 'iamw-benefits__image', alt: section.settings.heading }}
        {% else %}
          <div class="iamw-benefits__placeholder">Add section image</div>
        {% endif %}
      </div>

      <div class="iamw-benefits__list">
        {% for block in section.blocks %}
          <details class="iamw-benefits__item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span class="iamw-benefits__summary-main">
                {% if block.settings.icon != blank %}
                  <span class="iamw-benefits__icon">{{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>
                {% endif %}
                <span>{{ block.settings.title }}</span>
              </span>
              <span class="iamw-benefits__plus">+</span>
            </summary>
            {% if block.settings.text != blank %}<div class="iamw-benefits__text rte">{{ block.settings.text }}</div>{% endif %}
          </details>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="iamw-benefits__footer">
        <a href="#{{ section.settings.cta_anchor | default: 'iamw-products' }}" class="iamw-benefits__cta">{{ section.settings.cta_label }}</a>
        {% if section.settings.microcopy != blank %}<div class="iamw-benefits__micro">{{ section.settings.microcopy }}</div>{% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
.iamw-benefits--{{ section.id }}{--purple:{{ section.settings.purple }};--orange:{{ section.settings.orange }};--text:{{ section.settings.text_color }};--muted:{{ section.settings.muted }};--border:{{ section.settings.border_color }};background:{{ section.settings.background }};color:var(--text);padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px}.iamw-benefits--{{ section.id }} *{box-sizing:border-box}.iamw-benefits--{{ section.id }} .iamw-benefits__inner{max-width:1240px;margin:0 auto}.iamw-benefits--{{ section.id }} .iamw-benefits__header{text-align:center;max-width:820px;margin:0 auto 34px}.iamw-benefits--{{ section.id }} .iamw-benefits__eyebrow{color:var(--purple);font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px}.iamw-benefits--{{ section.id }} h2{font-size:clamp(32px,4vw,48px);line-height:1.05;letter-spacing:-.035em;margin:0 0 12px}.iamw-benefits--{{ section.id }} .iamw-benefits__intro{color:var(--muted);font-size:16px;line-height:1.6}.iamw-benefits--{{ section.id }} .iamw-benefits__grid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:38px;align-items:start}.iamw-benefits--{{ section.id }} .iamw-benefits__media{border-radius:16px;overflow:hidden;background:#f4edf8;min-height:500px}.iamw-benefits--{{ section.id }} .iamw-benefits__image{display:block;width:100%;height:500px;object-fit:cover}.iamw-benefits--{{ section.id }} .iamw-benefits__placeholder{min-height:500px;display:grid;place-items:center;color:var(--muted)}.iamw-benefits--{{ section.id }} .iamw-benefits__list{display:flex;flex-direction:column;gap:10px}.iamw-benefits--{{ section.id }} .iamw-benefits__item{border:1px solid var(--border);border-radius:12px;background:#fff;overflow:hidden}.iamw-benefits--{{ section.id }} summary{cursor:pointer;list-style:none;min-height:64px;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-weight:800}.iamw-benefits--{{ section.id }} summary::-webkit-details-marker{display:none}.iamw-benefits--{{ section.id }} .iamw-benefits__summary-main{display:flex;align-items:center;gap:12px}.iamw-benefits--{{ section.id }} .iamw-benefits__icon{width:38px;height:38px;display:block;flex:0 0 38px}.iamw-benefits--{{ section.id }} .iamw-benefits__icon img{width:100%;height:100%;object-fit:contain}.iamw-benefits--{{ section.id }} .iamw-benefits__plus{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:var(--purple);color:#fff;transition:transform .2s ease}.iamw-benefits--{{ section.id }} details[open] .iamw-benefits__plus{transform:rotate(45deg)}.iamw-benefits--{{ section.id }} .iamw-benefits__text{padding:0 16px 16px;color:var(--muted);font-size:14px;line-height:1.6}.iamw-benefits--{{ section.id }} .iamw-benefits__footer{text-align:center;margin-top:30px}.iamw-benefits--{{ section.id }} .iamw-benefits__cta{display:inline-flex;min-height:48px;padding:12px 24px;border-radius:10px;background:var(--orange);color:#17131f;text-decoration:none;font-weight:900}.iamw-benefits--{{ section.id }} .iamw-benefits__micro{margin-top:8px;color:var(--muted);font-size:12px}
@media(max-width:899px){.iamw-benefits--{{ section.id }}{padding-left:16px;padding-right:16px}.iamw-benefits--{{ section.id }} .iamw-benefits__grid{grid-template-columns:1fr}.iamw-benefits--{{ section.id }} .iamw-benefits__media,.iamw-benefits--{{ section.id }} .iamw-benefits__image,.iamw-benefits--{{ section.id }} .iamw-benefits__placeholder{min-height:380px;height:380px}}
{% endstyle %}

{% schema %}
{
  "name":"IAMW Benefits",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHY I AM WELL GUMMIES?"},
    {"type":"text","id":"heading","label":"Heading","default":"Everyday nutrition support for your growing child."},
    {"type":"richtext","id":"intro","label":"Intro","default":"<p>Designed to complement balanced meals as part of a consistent daily routine.</p>"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"cta_label","label":"Button label","default":"ORDER NOW"},
    {"type":"text","id":"cta_anchor","label":"Button anchor","default":"iamw-products"},
    {"type":"text","id":"microcopy","label":"Microcopy","default":"Kid-friendly mixed berry gummy • Food supplement"},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"},
    {"type":"color","id":"purple","label":"Purple","default":"#42106b"},
    {"type":"color","id":"orange","label":"Orange","default":"#ff9d16"},
    {"type":"color","id":"text_color","label":"Text","default":"#17131f"},
    {"type":"color","id":"muted","label":"Muted text","default":"#655f69"},
    {"type":"color","id":"border_color","label":"Border","default":"#e6ddeb"},
    {"type":"range","id":"padding_top","label":"Top spacing","min":20,"max":120,"step":4,"unit":"px","default":52},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":20,"max":120,"step":4,"unit":"px","default":52}
  ],
  "blocks":[
    {"type":"benefit","name":"Benefit","settings":[
      {"type":"image_picker","id":"icon","label":"Icon"},
      {"type":"text","id":"title","label":"Title","default":"Daily nutrition support"},
      {"type":"richtext","id":"text","label":"Text","default":"<p>Add the supporting explanation here.</p>"},
      {"type":"checkbox","id":"open_by_default","label":"Open by default","default":false}
    ]}
  ],
  "presets":[{"name":"IAMW Benefits","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]}]
}
{% endschema %}
