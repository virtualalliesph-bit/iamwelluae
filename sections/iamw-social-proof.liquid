<section class="iamw-proof iamw-proof--{{ section.id }}">
  <div class="iamw-proof__inner">
    <header class="iamw-proof__header">
      {% if section.settings.eyebrow != blank %}<div class="iamw-proof__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.intro != blank %}<div class="iamw-proof__intro rte">{{ section.settings.intro }}</div>{% endif %}
    </header>

    <div class="iamw-proof__track" data-proof-track>
      {% for block in section.blocks %}
        <article class="iamw-proof__card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,520,720,900', sizes: '(min-width:900px) 24vw, 80vw', class: 'iamw-proof__image', alt: block.settings.alt_text }}
          {% else %}
            <div class="iamw-proof__placeholder">Add review screenshot</div>
          {% endif %}
          {% if block.settings.caption != blank %}<div class="iamw-proof__caption">{{ block.settings.caption }}</div>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
.iamw-proof--{{ section.id }}{background:{{ section.settings.background }};padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;color:{{ section.settings.text_color }}}.iamw-proof--{{ section.id }} *{box-sizing:border-box}.iamw-proof--{{ section.id }} .iamw-proof__inner{max-width:1240px;margin:0 auto}.iamw-proof--{{ section.id }} .iamw-proof__header{text-align:center;max-width:840px;margin:0 auto 28px}.iamw-proof--{{ section.id }} .iamw-proof__eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:900;color:{{ section.settings.purple }};margin-bottom:8px}.iamw-proof--{{ section.id }} h2{font-size:clamp(32px,4vw,46px);line-height:1.05;letter-spacing:-.035em;margin:0}.iamw-proof--{{ section.id }} .iamw-proof__intro{color:{{ section.settings.muted }};margin-top:10px}.iamw-proof--{{ section.id }} .iamw-proof__track{display:grid;grid-template-columns:repeat({{ section.settings.columns }},minmax(0,1fr));gap:16px}.iamw-proof--{{ section.id }} .iamw-proof__card{border:1px solid {{ section.settings.border_color }};border-radius:14px;overflow:hidden;background:#fff}.iamw-proof--{{ section.id }} .iamw-proof__image{display:block;width:100%;height:auto}.iamw-proof--{{ section.id }} .iamw-proof__placeholder{min-height:360px;display:grid;place-items:center;color:{{ section.settings.muted }};background:#faf8fb}.iamw-proof--{{ section.id }} .iamw-proof__caption{padding:10px 12px;font-size:12px;color:{{ section.settings.muted }}}
@media(max-width:899px){.iamw-proof--{{ section.id }}{padding-left:16px;padding-right:16px}.iamw-proof--{{ section.id }} .iamw-proof__track{display:flex;overflow:auto;scroll-snap-type:x mandatory;padding-bottom:8px}.iamw-proof--{{ section.id }} .iamw-proof__card{flex:0 0 78vw;scroll-snap-align:start}}
{% endstyle %}

{% schema %}
{
  "name":"IAMW Social Proof",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"REAL PARENTS • REAL MOMENTS"},
    {"type":"text","id":"heading","label":"Heading","default":"Real routines. Feedback from I Am Well families."},
    {"type":"richtext","id":"intro","label":"Intro","default":"<p>Use authentic customer messages, feedback and family photos here.</p>"},
    {"type":"range","id":"columns","label":"Desktop columns","min":2,"max":5,"step":1,"default":4},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"},
    {"type":"color","id":"purple","label":"Purple","default":"#42106b"},
    {"type":"color","id":"text_color","label":"Text","default":"#17131f"},
    {"type":"color","id":"muted","label":"Muted text","default":"#655f69"},
    {"type":"color","id":"border_color","label":"Border","default":"#e6ddeb"},
    {"type":"range","id":"padding_top","label":"Top spacing","min":20,"max":120,"step":4,"unit":"px","default":52},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":20,"max":120,"step":4,"unit":"px","default":52}
  ],
  "blocks":[
    {"type":"proof","name":"Proof image","limit":12,"settings":[
      {"type":"image_picker","id":"image","label":"Image"},
      {"type":"text","id":"alt_text","label":"Image alt text","default":"I Am Well customer feedback"},
      {"type":"text","id":"caption","label":"Caption"}
    ]}
  ],
  "presets":[{"name":"IAMW Social Proof","blocks":[{"type":"proof"},{"type":"proof"},{"type":"proof"},{"type":"proof"}]}]
}
{% endschema %}
