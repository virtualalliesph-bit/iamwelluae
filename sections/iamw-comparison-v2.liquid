
{{ 'iamw-brain-landing.css' | asset_url | stylesheet_tag }}
<section class="iamw-brain-section iamw-comparison-v2" style="--iamw-bg:{{ section.settings.background }};--iamw-text:{{ section.settings.text_color }};--iamw-accent:{{ section.settings.accent_color }};--iamw-radius:{{ section.settings.border_radius }}px;--iamw-content:{{ section.settings.content_width }}px;--iamw-pad-desktop:{{ section.settings.padding_desktop }}px;--iamw-pad-mobile:{{ section.settings.padding_mobile }}px;--iamw-heading-desktop:{{ section.settings.heading_size_desktop }}px;--iamw-heading-mobile:{{ section.settings.heading_size_mobile }}px;{% if section.settings.button_color != blank %}--iamw-button:{{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}--iamw-button-text:{{ section.settings.button_text_color }};{% endif %}" >
  <div class="iamw-brain-wrap">
    <div class="iamw-center" style="text-align:{{ section.settings.text_alignment }}">
      {% if section.settings.eyebrow != blank %}<div class="iamw-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="iamw-heading">{{ section.settings.heading }}</h2>{% endif %}
    </div>
    <div class="iamw-comparison-v2__wrap iamw-brain-card">
      <table class="iamw-comparison-v2__table">
        <thead>
          <tr>
            <th>{{ section.settings.feature_label }}</th>
            <th>{{ section.settings.iamwell_label }}</th>
            <th>{{ section.settings.other_label }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.settings.feature != blank %}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.feature }}</td>
                <td class="is-yes">{% if block.settings.iamwell %}{{ section.settings.check_icon }}{% else %}{{ section.settings.x_icon }}{% endif %}</td>
                <td class="is-no">{% if block.settings.other %}{{ section.settings.check_icon }}{% else %}{{ section.settings.x_icon }}{% endif %}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
<style>
#shopify-section-{{ section.id }} .iamw-center{max-width:820px;margin:0 auto 26px}
#shopify-section-{{ section.id }} .iamw-comparison-v2__wrap{overflow:auto;background:#fff}
#shopify-section-{{ section.id }} .iamw-comparison-v2__table{width:100%;border-collapse:collapse;min-width:620px}
#shopify-section-{{ section.id }} .iamw-comparison-v2__table th,#shopify-section-{{ section.id }} .iamw-comparison-v2__table td{padding:15px 18px;border-bottom:1px solid rgba(91,27,166,.1);text-align:left}
#shopify-section-{{ section.id }} .iamw-comparison-v2__table th{font-size:13px;background:#fff;color:var(--iamw-text)}
#shopify-section-{{ section.id }} .iamw-comparison-v2__table th:nth-child(2){background:#5a1aa8;color:#fff;text-align:center}
#shopify-section-{{ section.id }} .iamw-comparison-v2__table th:nth-child(3){background:#f2f0f4;text-align:center}
#shopify-section-{{ section.id }} .iamw-comparison-v2__table td:nth-child(2){background:#f1e8ff;text-align:center;font-weight:900;color:#16a05d}
#shopify-section-{{ section.id }} .iamw-comparison-v2__table td:nth-child(3){background:#fafafa;text-align:center;font-weight:900;color:#d33c3c}
</style>

{% schema %}
{
  "name": "IAMW Comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A SMARTER CHOICE FOR GROWING MINDS."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why families choose IAMWELL"
    },
    {
      "type": "text",
      "id": "feature_label",
      "label": "Feature column label",
      "default": "What your child gets"
    },
    {
      "type": "text",
      "id": "iamwell_label",
      "label": "IAMWELL column label",
      "default": "IAMWELL Smart Routine"
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "Other column label",
      "default": "Other brands"
    },
    {
      "type": "text",
      "id": "check_icon",
      "label": "Check icon",
      "default": "✓"
    },
    {
      "type": "text",
      "id": "x_icon",
      "label": "X icon",
      "default": "×"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f4ebff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4b168f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ff9a1f"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 24,
      "max": 52,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Padding desktop",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Padding mobile",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Supports focus and learning"
        },
        {
          "type": "checkbox",
          "id": "iamwell",
          "label": "IAMWELL has this",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "other",
          "label": "Other brands have this",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "IAMW Comparison",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature": "Supports focus and learning",
            "iamwell": true,
            "other": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Helps support memory and brain development",
            "iamwell": true,
            "other": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Complete daily nutrition in one routine",
            "iamwell": true,
            "other": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Great tasting and kid approved",
            "iamwell": true,
            "other": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Designed with picky eaters in mind",
            "iamwell": true,
            "other": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
