{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'IAMW-UAE-Product-Form-' | append: section.id
%}
<section id="iamw-uae-product-hero-{{ section.id }}" class="iamw-uae-product-hero">
  <div class="iamw-uae-product-hero__inner">
    <div class="iamw-uae-product-hero__media">
      {% if product.media.size > 0 %}
        <div class="iamw-uae-product-hero__stage">
          {% for media in product.media %}
            <div class="iamw-uae-product-hero__media-item{% unless forloop.first %} is-hidden{% endunless %}" data-iamw-media="{{ media.id }}">
              {% case media.media_type %}
                {% when 'image' %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'iamw-uae-product-hero__image' }}
                {% when 'video' %}{{ media | video_tag: controls: true, image_size: '1200x', class: 'iamw-uae-product-hero__video' }}
                {% when 'external_video' %}{{ media | external_video_tag: class: 'iamw-uae-product-hero__video' }}
                {% else %}{{ media | media_tag: class: 'iamw-uae-product-hero__image' }}
              {% endcase %}
            </div>
          {% endfor %}
        </div>
        {% if product.media.size > 1 %}
          <div class="iamw-uae-product-hero__thumbs">
            {% for media in product.media limit: 8 %}
              <button type="button" class="iamw-uae-product-hero__thumb{% if forloop.first %} is-active{% endif %}" data-iamw-thumb="{{ media.id }}">
                {% if media.preview_image %}{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'iamw-uae-product-hero__thumb-image' }}{% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </div>
    <div class="iamw-uae-product-hero__details">
      <h1 class="iamw-uae-product-hero__title">{{ product.title }}</h1>
      <div class="iamw-uae-product-hero__rating"><span class="iamw-uae-product-hero__stars">★★★★★</span><span>Customer reviews</span></div>
      <div class="iamw-uae-product-hero__price" data-iamw-price>{{ current_variant.price | money_with_currency }}</div>
      {% form 'product', product, id: form_id, class: 'iamw-uae-product-hero__form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-iamw-variant-id>
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <fieldset class="iamw-uae-product-hero__option" data-option-index="{{ forloop.index0 }}">
              <legend>{{ option.name }}</legend>
              <div class="iamw-uae-product-hero__option-values">
                {% for value in option.values %}<button type="button" class="iamw-uae-product-hero__option-button{% if option.selected_value == value %} is-selected{% endif %}" data-option-value="{{ value | escape }}">{{ value }}</button>{% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        {% endunless %}
        <div class="iamw-uae-product-hero__checkout">{{ form | payment_button }}</div>
      {% endform %}
      {% if product.description != blank %}<div class="iamw-uae-product-hero__description rte">{{ product.description }}</div>{% endif %}
    </div>
  </div>
</section>
<style>
#iamw-uae-product-hero-{{ section.id }}{background:#fff;color:#161116;padding:36px 0 84px}.iamw-uae-product-hero__inner{width:min(1260px,calc(100% - 48px));margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:12px}.iamw-uae-product-hero__stage{border-radius:12px;overflow:hidden}.iamw-uae-product-hero__media-item.is-hidden{display:none}.iamw-uae-product-hero__image,.iamw-uae-product-hero__video{display:block;width:100%;aspect-ratio:1/1;object-fit:cover}.iamw-uae-product-hero__thumbs{display:flex;gap:8px;margin-top:10px;overflow:auto}.iamw-uae-product-hero__thumb{width:64px;height:64px;padding:0;border:1px solid #ddd;border-radius:8px;overflow:hidden;background:#fff}.iamw-uae-product-hero__thumb.is-active{border:2px solid #42106b}.iamw-uae-product-hero__thumb-image{width:100%;height:100%;object-fit:cover}.iamw-uae-product-hero__details{padding:32px 12px}.iamw-uae-product-hero__title{font-size:24px;text-transform:uppercase;margin:0}.iamw-uae-product-hero__rating{display:flex;gap:8px;margin-top:12px}.iamw-uae-product-hero__stars{color:#fbb60d}.iamw-uae-product-hero__price{color:#42106b;font-size:24px;font-weight:700;margin:14px 0 16px}.iamw-uae-product-hero__option{border:0;padding:0;margin:0 0 14px}.iamw-uae-product-hero__option-values{display:flex;flex-wrap:wrap;gap:8px}.iamw-uae-product-hero__option-button{border:1px solid #42106b;background:#fff;color:#42106b;border-radius:8px;padding:10px 14px}.iamw-uae-product-hero__option-button.is-selected{background:#42106b;color:#fff}.iamw-uae-product-hero__checkout{margin-top:18px}.shopify-payment-button__button{min-height:52px!important;border-radius:8px!important;background:#ff8f23!important;color:#fff!important;font-weight:800!important}.iamw-uae-product-hero__description{margin-top:20px;font-size:14px;line-height:1.6}@media(max-width:749px){#iamw-uae-product-hero-{{ section.id }}{padding:20px 0 48px}.iamw-uae-product-hero__inner{width:calc(100% - 32px);grid-template-columns:1fr;gap:24px}.iamw-uae-product-hero__details{padding:0}}
</style>
<script>(()=>{const root=document.getElementById('iamw-uae-product-hero-{{ section.id }}');if(!root)return;root.querySelectorAll('[data-iamw-thumb]').forEach(t=>t.addEventListener('click',()=>{const id=t.dataset.iamwThumb;root.querySelectorAll('[data-iamw-media]').forEach(i=>i.classList.toggle('is-hidden',i.dataset.iamwMedia!==id));root.querySelectorAll('[data-iamw-thumb]').forEach(x=>x.classList.toggle('is-active',x===t))}));const variants={{ product.variants | json }};const selected={{ current_variant.options | json }};const input=root.querySelector('[data-iamw-variant-id]');const price=root.querySelector('[data-iamw-price]');root.querySelectorAll('[data-option-index]').forEach(g=>g.querySelectorAll('[data-option-value]').forEach(b=>b.addEventListener('click',()=>{const idx=Number(g.dataset.optionIndex);selected[idx]=b.dataset.optionValue;g.querySelectorAll('[data-option-value]').forEach(x=>x.classList.toggle('is-selected',x===b));const m=variants.find(v=>v.options.every((val,i)=>val===selected[i]));if(m&&input){input.value=m.id;if(price)price.textContent=(m.price/100).toFixed(2)}})))} )();</script>
{% schema %}{"name":"IAMW UAE Product Hero","settings":[],"presets":[{"name":"IAMW UAE Product Hero"}]}{% endschema %}