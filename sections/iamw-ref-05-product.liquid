</style>




<script>

(function() {

  function initIAMWFeaturedProduct() {

    const section =
      document.getElementById(
        'IAMW-PRODUCT-{{ section.id }}'
      );


    if (!section) {
      return;
    }


    if (
      section.dataset.iamwReady ===
      'true'
    ) {
      return;
    }


    section.dataset.iamwReady =
      'true';



    /*
      GALLERY
    */

    const mainImage =
      section.querySelector(
        '.iamw-product__main-image'
      );


    const thumbs =
      section.querySelectorAll(
        '[data-iamw-product-thumb]'
      );


    thumbs.forEach(
      function(thumb) {

        thumb.addEventListener(
          'click',
          function() {

            if (!mainImage) {
              return;
            }


            const src =
              thumb.getAttribute(
                'data-image-src'
              );


            const alt =
              thumb.getAttribute(
                'data-image-alt'
              );


            if (src) {

              mainImage.src =
                src;


              mainImage.removeAttribute(
                'srcset'
              );


              mainImage.removeAttribute(
                'sizes'
              );

            }


            if (alt) {
              mainImage.alt = alt;
            }


            thumbs.forEach(
              function(item) {

                item.classList.remove(
                  'is-active'
                );

              }
            );


            thumb.classList.add(
              'is-active'
            );

          }
        );

      }
    );



    /*
      PRODUCT FORM
    */

    const variantInput =
      section.querySelector(
        '[data-iamw-variant-input]'
      );


    const variantSelect =
      section.querySelector(
        '[data-iamw-variant-select]'
      );


    const buyNowButton =
      section.querySelector(
        '[data-iamw-buy-now]'
      );


    const addCartButton =
      section.querySelector(
        '[data-iamw-add-cart]'
      );


    const price =
      section.querySelector(
        '[data-iamw-price]'
      );


    const comparePrice =
      section.querySelector(
        '[data-iamw-compare-price]'
      );



    if (variantSelect) {

      variantSelect.addEventListener(
        'change',
        function() {

          const option =
            variantSelect.options[
              variantSelect.selectedIndex
            ];


          const available =
            option.getAttribute(
              'data-available'
            ) === 'true';


          if (variantInput) {

            variantInput.value =
              option.value;

          }


          if (price) {

            price.textContent =
              option.getAttribute(
                'data-price'
              ) || '';

          }


          if (comparePrice) {

            const compare =
              option.getAttribute(
                'data-compare'
              );


            if (compare) {

              comparePrice.textContent =
                compare;


              comparePrice.style.display =
                '';

            } else {

              comparePrice.textContent =
                '';


              comparePrice.style.display =
                'none';

            }

          }


          if (buyNowButton) {

            buyNowButton.disabled =
              !available;


            buyNowButton.textContent =
              available
                ? {{ section.settings.buy_now_text | json }}
                : 'SOLD OUT';

          }


          if (addCartButton) {

            addCartButton.disabled =
              !available;


            addCartButton.textContent =
              available
                ? {{ section.settings.add_to_cart_text | json }}
                : 'SOLD OUT';

          }

        }
      );

    }



    /*
      BOX POPUP
    */

    const overlay =
      document.getElementById(
        'IAMW-BOX-OVERLAY-{{ section.id }}'
      );


    const yesButton =
      overlay
        ? overlay.querySelector(
            '[data-box-yes]'
          )
        : null;


    const noButton =
      overlay
        ? overlay.querySelector(
            '[data-box-no]'
          )
        : null;


    const closeButton =
      overlay
        ? overlay.querySelector(
            '[data-box-close]'
          )
        : null;


    const quantityInput =
      overlay
        ? overlay.querySelector(
            '[data-box-qty]'
          )
        : null;


    const minusButton =
      overlay
        ? overlay.querySelector(
            '[data-box-minus]'
          )
        : null;


    const plusButton =
      overlay
        ? overlay.querySelector(
            '[data-box-plus]'
          )
        : null;



    const boxVariantId =
      {% if selected_box_variant != blank %}
        {{ selected_box_variant.id | json }}
      {% else %}
        null
      {% endif %};



    const boxAvailable =
      {% if selected_box_variant != blank %}
        {{ selected_box_variant.available | json }}
      {% else %}
        false
      {% endif %};



    let pendingMainVariantId =
      null;


    let pendingMainQuantity =
      1;



    function getMainVariantId() {

      if (!variantInput) {
        return null;
      }


      return Number(
        variantInput.value
      );

    }



    function getMainQuantity() {

      const quantityInputMain =
        section.querySelector(
          '[data-iamw-main-quantity]'
        );


      if (!quantityInputMain) {
        return 1;
      }


      return (
        parseInt(
          quantityInputMain.value,
          10
        ) || 1
      );

    }



    function showPopup() {

      if (!overlay) {
        return;
      }


      overlay.classList.add(
        'is-open'
      );


      overlay.setAttribute(
        'aria-hidden',
        'false'
      );


      document.body.style.overflow =
        'hidden';

    }



    function hidePopup() {

      if (!overlay) {
        return;
      }


      overlay.classList.remove(
        'is-open'
      );


      overlay.setAttribute(
        'aria-hidden',
        'true'
      );


      document.body.style.overflow =
        '';

    }



    function addItems(items) {

      return fetch(
        window.Shopify.routes.root +
        'cart/add.js',
        {

          method:
            'POST',

          headers: {

            'Content-Type':
              'application/json',

            'Accept':
              'application/json'

          },

          body:
            JSON.stringify({
              items: items
            })

        }
      )
      .then(
        function(response) {

          if (!response.ok) {

            return response
              .json()
              .catch(
                function() {
                  return {};
                }
              )
              .then(
                function(errorData) {

                  throw new Error(
                    errorData.description ||
                    errorData.message ||
                    'Unable to add your order.'
                  );

                }
              );

          }


          return response.json();

        }
      );

    }



    function checkout() {

      window.location.href =
        window.Shopify.routes.root +
        'checkout';

    }



    /*
      BUY NOW
    */

    if (buyNowButton) {

      buyNowButton.addEventListener(
        'click',
        function(event) {

          event.preventDefault();


          const selectedVariantId =
            getMainVariantId();


          if (!selectedVariantId) {

            alert(
              'Please select the Shopify product first.'
            );

            return;

          }


          pendingMainVariantId =
            selectedVariantId;


          pendingMainQuantity =
            getMainQuantity();


          if (overlay) {

            showPopup();

            return;

          }


          buyNowButton.disabled =
            true;


          addItems([
            {
              id:
                pendingMainVariantId,

              quantity:
                pendingMainQuantity
            }
          ])
          .then(
            function() {

              checkout();

            }
          )
          .catch(
            function(error) {

              console.error(
                error
              );


              buyNowButton.disabled =
                false;


              alert(
                error.message
              );

            }
          );

        }
      );

    }



    /*
      YES BOX
    */

    if (
      yesButton &&
      boxVariantId
    ) {

      yesButton.addEventListener(
        'click',
        function() {

          if (!pendingMainVariantId) {

            alert(
              'Main product is missing. Please select the product first.'
            );

            return;

          }


          if (!boxAvailable) {
            return;
          }


          const boxQuantity =
            quantityInput
              ? (
                  parseInt(
                    quantityInput.value,
                    10
                  ) || 1
                )
              : 1;


          yesButton.disabled =
            true;


          if (noButton) {
            noButton.disabled = true;
          }


          addItems([
            {
              id:
                pendingMainVariantId,

              quantity:
                pendingMainQuantity
            },
            {
              id:
                Number(
                  boxVariantId
                ),

              quantity:
                boxQuantity
            }
          ])
          .then(
            function() {

              hidePopup();

              checkout();

            }
          )
          .catch(
            function(error) {

              console.error(
                error
              );


              yesButton.disabled =
                false;


              if (noButton) {
                noButton.disabled =
                  false;
              }


              alert(
                error.message
              );

            }
          );

        }
      );

    }



    /*
      NO BOX
    */

    if (noButton) {

      noButton.addEventListener(
        'click',
        function() {

          if (!pendingMainVariantId) {

            alert(
              'Main product is missing. Please select the product first.'
            );

            return;

          }


          noButton.disabled =
            true;


          if (yesButton) {
            yesButton.disabled = true;
          }


          addItems([
            {
              id:
                pendingMainVariantId,

              quantity:
                pendingMainQuantity
            }
          ])
          .then(
            function() {

              hidePopup();

              checkout();

            }
          )
          .catch(
            function(error) {

              console.error(
                error
              );


              noButton.disabled =
                false;


              if (
                yesButton &&
                boxAvailable
              ) {

                yesButton.disabled =
                  false;

              }


              alert(
                error.message
              );

            }
          );

        }
      );

    }



    /*
      QUANTITY
    */

    if (
      minusButton &&
      quantityInput
    ) {

      minusButton.addEventListener(
        'click',
        function() {

          let qty =
            parseInt(
              quantityInput.value,
              10
            ) || 1;


          if (qty > 1) {

            quantityInput.value =
              qty - 1;

          }

        }
      );

    }



    if (
      plusButton &&
      quantityInput
    ) {

      plusButton.addEventListener(
        'click',
        function() {

          let qty =
            parseInt(
              quantityInput.value,
              10
            ) || 1;


          quantityInput.value =
            qty + 1;

        }
      );

    }



    /*
      CLOSE
    */

    if (closeButton) {

      closeButton.addEventListener(
        'click',
        function() {

          hidePopup();

        }
      );

    }



    if (overlay) {

      overlay.addEventListener(
        'click',
        function(event) {

          if (
            event.target === overlay
          ) {

            hidePopup();

          }

        }
      );

    }

  }



  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initIAMWFeaturedProduct
    );

  } else {

    initIAMWFeaturedProduct();

  }



  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.target &&
        event.target.id ===
        'IAMW-PRODUCT-{{ section.id }}'
      ) {

        event.target.dataset.iamwReady =
          'false';


        initIAMWFeaturedProduct();

      }

    }
  );

})();

</script>




