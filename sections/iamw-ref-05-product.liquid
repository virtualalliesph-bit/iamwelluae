{% comment %}
  I AM WELL
  Featured Product

  IMPORTANT:
  - Select the main Shopify product in Theme Editor
  - BUY NOW opens box popup first
  - YES = main product + box added together
  - NO = main product only
  - Then redirects to checkout
  - Anchor target = #iamw-product
{% endcomment %}


{% assign selected_product = section.settings.product %}
{% assign current_variant = blank %}

{% if selected_product != blank %}
  {% assign current_variant = selected_product.selected_or_first_available_variant %}
{% endif %}


{% assign product_form_id = 'IAMWProductForm-' | append: section.id %}


{% assign box_product = all_products[section.settings.box_product_handle] %}
{% assign selected_box_variant = blank %}


{% if box_product != blank %}

  {% assign selected_box_variant = box_product.selected_or_first_available_variant %}

  {% if section.settings.box_variant_id != blank %}

    {% for box_variant in box_product.variants %}

      {% assign box_variant_string = box_variant.id | append: '' %}

      {% if box_variant_string == section.settings.box_variant_id %}
        {% assign selected_box_variant = box_variant %}
      {% endif %}

    {% endfor %}

  {% endif %}

{% endif %}



<div
  id="iamw-product"
  class="iamw-product-anchor"
></div>


<section
  id="IAMW-PRODUCT-{{ section.id }}"
  class="iamw-product"
  style="
    --page-width: {{ section.settings.page_width }}px;

    --pad-x: {{ section.settings.padding_x }}px;
    --pad-x-mobile: {{ section.settings.mobile_padding_x }}px;

    --pad-top: {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;

    --column-gap: {{ section.settings.column_gap }}px;
    --content-gap: {{ section.settings.content_gap }}px;
    --thumb-gap: {{ section.settings.thumb_gap }}px;
    --accordion-gap: {{ section.settings.accordion_gap }}px;

    --radius: {{ section.settings.radius }}px;

    --purple: {{ section.settings.purple }};
    --orange: {{ section.settings.orange }};
    --cream: {{ section.settings.cream }};
    --soft: {{ section.settings.soft_background }};
    --background: {{ section.settings.background }};
    --text: {{ section.settings.text_color }};
    --muted: {{ section.settings.muted }};
    --border: {{ section.settings.border_color }};

    --title-size: {{ section.settings.title_size }}px;
    --body-size: {{ section.settings.body_size }}px;
    --price-size: {{ section.settings.price_size }}px;

    --title-mobile: {{ section.settings.mobile_title_size }}px;
    --body-mobile: {{ section.settings.mobile_body_size }}px;
    --price-mobile: {{ section.settings.mobile_price_size }}px;
  "
>


  <div class="iamw-product__shell">


    {% if selected_product == blank %}

      <div class="iamw-product__warning">

        <strong>
          Select the Shopify product first.
        </strong>

        <span>
          Open this section in the Theme Editor and choose the Smart Routine Starter Pack under “Select Shopify product”.
        </span>

      </div>

    {% endif %}



    <div class="iamw-product__grid">


      {% comment %}
        ==============================
        GALLERY
        ==============================
      {% endcomment %}

      <div class="iamw-product__gallery">

        <div class="iamw-product__main-media">


          {% if selected_product != blank and selected_product.featured_image != blank %}

            {% assign main_image = selected_product.featured_image %}

            <img
              id="IAMWMainImage-{{ section.id }}"
              class="iamw-product__main-image"
              src="{{ main_image | image_url: width: 1400 }}"
              srcset="
                {{ main_image | image_url: width: 500 }} 500w,
                {{ main_image | image_url: width: 800 }} 800w,
                {{ main_image | image_url: width: 1100 }} 1100w,
                {{ main_image | image_url: width: 1400 }} 1400w
              "
              sizes="(min-width: 990px) 50vw, 100vw"
              alt="{{ selected_product.title | escape }}"
              width="{{ main_image.width }}"
              height="{{ main_image.height }}"
              loading="eager"
            >


          {% elsif section.settings.fallback_image != blank %}

            {% assign main_image = section.settings.fallback_image %}

            <img
              id="IAMWMainImage-{{ section.id }}"
              class="iamw-product__main-image"
              src="{{ main_image | image_url: width: 1400 }}"
              alt="{{ section.settings.custom_title | default: 'I Am Well Smart Gummies' | escape }}"
              width="{{ main_image.width }}"
              height="{{ main_image.height }}"
              loading="eager"
            >


          {% else %}

            <div class="iamw-product__placeholder iamw-product__placeholder--main">

              SELECT SHOPIFY PRODUCT

            </div>

          {% endif %}

        </div>



        {% if selected_product != blank %}

          {% if selected_product.images.size > 1 %}

            <div class="iamw-product__thumbs">

              {% for image in selected_product.images limit: section.settings.thumbnail_limit %}

                <button
                  type="button"
                  class="iamw-product__thumb {% if image.id == selected_product.featured_image.id %}is-active{% endif %}"
                  data-iamw-product-thumb
                  data-image-src="{{ image | image_url: width: 1400 }}"
                  data-image-alt="{{ image.alt | default: selected_product.title | escape }}"
                  aria-label="View product image {{ forloop.index }}"
                >

                  <img
                    src="{{ image | image_url: width: 180 }}"
                    alt=""
                    width="180"
                    height="180"
                    loading="lazy"
                    class="iamw-product__thumb-image"
                  >

                </button>

              {% endfor %}

            </div>

          {% endif %}

        {% endif %}

      </div>



      {% comment %}
        ==============================
        CONTENT
        ==============================
      {% endcomment %}

      <div class="iamw-product__content">


        {% if section.settings.audience_tabs != blank %}

          <div class="iamw-product__audience">
            {{ section.settings.audience_tabs }}
          </div>

        {% endif %}



        {% if section.settings.stars != blank or section.settings.rating_text != blank %}

          <div class="iamw-product__rating">

            {% if section.settings.stars != blank %}

              <span class="iamw-product__stars">
                {{ section.settings.stars }}
              </span>

            {% endif %}


            {% if section.settings.rating_text != blank %}

              <span>
                {{ section.settings.rating_text }}
              </span>

            {% endif %}

          </div>

        {% endif %}



        {% if section.settings.kicker != blank %}

          <div class="iamw-product__kicker">
            {{ section.settings.kicker }}
          </div>

        {% endif %}



        {% comment %}
          ==============================
          TITLE + PRICE + PURCHASE CTA
          ==============================
        {% endcomment %}

        <div class="iamw-product__purchase-top">

          {% if section.settings.custom_title != blank %}
            <h2 class="iamw-product__title">
              {{ section.settings.custom_title }}
            </h2>
          {% elsif selected_product != blank %}
            <h2 class="iamw-product__title">
              {{ selected_product.title }}
            </h2>
          {% endif %}

          {% if selected_product != blank and current_variant != blank %}
            <div class="iamw-product__price-row">
              <span
                class="iamw-product__compare-price"
                data-iamw-compare-price
                {% unless current_variant.compare_at_price > current_variant.price %}
                  style="display:none;"
                {% endunless %}
              >
                {% if current_variant.compare_at_price > current_variant.price %}
                  {{ current_variant.compare_at_price | money }}
                {% endif %}
              </span>

              <span
                class="iamw-product__price"
                data-iamw-price
              >
                {{ current_variant.price | money }}
              </span>
            </div>
          {% endif %}

          {% if selected_product != blank and current_variant != blank %}
            {% form 'product',
              selected_product,
              id: product_form_id,
              class: 'iamw-product__form iamw-product__form--top'
            %}

              <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
                data-iamw-variant-input
              >

              <input
                type="hidden"
                name="quantity"
                value="1"
                data-iamw-main-quantity
              >

              {% if selected_product.variants.size > 1 %}
                <div class="iamw-product__variant-wrap">
                  <label for="IAMWVariant-{{ section.id }}">
                    Choose option
                  </label>

                  <select
                    id="IAMWVariant-{{ section.id }}"
                    class="iamw-product__variant-select"
                    data-iamw-variant-select
                  >
                    {% for variant in selected_product.variants %}
                      <option
                        value="{{ variant.id }}"
                        data-price="{{ variant.price | money }}"
                        data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                        data-available="{{ variant.available }}"
                        {% if variant.id == current_variant.id %}selected{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                      >
                        {{ variant.title }}
                        {% unless variant.available %}— Sold out{% endunless %}
                      </option>
                    {% endfor %}
                  </select>
                </div>
              {% endif %}

              {% if section.settings.show_buy_now %}
                <button
                  type="button"
                  class="iamw-product__buy-now"
                  data-iamw-buy-now
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  {% if current_variant.available %}
                    {{ section.settings.buy_now_text }}
                  {% else %}
                    SOLD OUT
                  {% endif %}
                </button>
              {% endif %}

              {% if section.settings.show_add_to_cart %}
                <button
                  type="submit"
                  name="add"
                  class="iamw-product__add-cart"
                  data-iamw-add-cart
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  {% if current_variant.available %}
                    {{ section.settings.add_to_cart_text }}
                  {% else %}
                    SOLD OUT
                  {% endif %}
                </button>
              {% endif %}

            {% endform %}
          {% else %}
            <button
              type="button"
              class="iamw-product__buy-now"
              disabled
            >
              SELECT PRODUCT FIRST
            </button>
          {% endif %}

        </div>

        {% if section.settings.intro != blank %}
          <div class="iamw-product__rte iamw-product__intro">
            {{ section.settings.intro }}
          </div>
        {% endif %}


        {% comment %}
          ==============================
          ACCORDIONS
          ==============================
        {% endcomment %}

        {% assign has_accordions = false %}


        {% for block in section.blocks %}

          {% if block.type == 'accordion' %}

            {% if block.settings.title != blank %}
              {% assign has_accordions = true %}
            {% endif %}

          {% endif %}

        {% endfor %}



        {% if has_accordions %}

          <div class="iamw-product__accordions">

            {% for block in section.blocks %}

              {% if block.type == 'accordion' %}

                {% if block.settings.title != blank %}

                  <details
                    class="iamw-product__accordion"
                    {% if block.settings.open_by_default %}open{% endif %}
                    {{ block.shopify_attributes }}
                  >

                    <summary class="iamw-product__accordion-summary">

                      <div class="iamw-product__accordion-left">


                        {% if block.settings.icon_image != blank %}

                          <span
                            class="iamw-product__accordion-icon"
                            style="
                              width: {{ block.settings.icon_size }}px;
                              height: {{ block.settings.icon_size }}px;
                            "
                          >

                            {{
                              block.settings.icon_image
                              | image_url: width: 160
                              | image_tag:
                                loading: 'lazy',
                                class: 'iamw-product__icon-image'
                            }}

                          </span>


                        {% elsif block.settings.icon_svg != blank %}

                          <span
                            class="iamw-product__accordion-icon iamw-product__svg"
                            style="
                              width: {{ block.settings.icon_size }}px;
                              height: {{ block.settings.icon_size }}px;
                            "
                          >

                            {{ block.settings.icon_svg }}

                          </span>

                        {% endif %}


                        <span>
                          {{ block.settings.title }}
                        </span>

                      </div>


                      <span class="iamw-product__arrow">
                        ↓
                      </span>

                    </summary>



                    {% if block.settings.text != blank %}

                      <div class="iamw-product__accordion-body">

                        <div class="iamw-product__rte">
                          {{ block.settings.text }}
                        </div>

                      </div>

                    {% endif %}

                  </details>

                {% endif %}

              {% endif %}

            {% endfor %}

          </div>

        {% endif %}



        {% if section.settings.ingredients_link_text != blank %}

          {% if section.settings.ingredients_link != blank %}

            <a
              href="{{ section.settings.ingredients_link }}"
              class="iamw-product__ingredients-link"
            >
              {{ section.settings.ingredients_link_text }}
            </a>

          {% else %}

            <span class="iamw-product__ingredients-link">
              {{ section.settings.ingredients_link_text }}
            </span>

          {% endif %}

        {% endif %}



        {% if section.settings.microcopy != blank %}

          <div class="iamw-product__microcopy">
            {{ section.settings.microcopy }}
          </div>

        {% endif %}

      </div>

    </div>

  </div>

</section>




{% comment %}
  ==============================
  BOX POPUP
  ==============================
{% endcomment %}


{% if section.settings.enable_box_popup %}

  {% if box_product != blank and selected_box_variant != blank %}

    <div
      id="IAMW-BOX-OVERLAY-{{ section.id }}"
      class="iamw-box-overlay"
      aria-hidden="true"
    >

      <div
        class="iamw-box-popup"
        role="dialog"
        aria-modal="true"
        aria-label="{{ section.settings.box_heading | escape }}"
      >


        <button
          type="button"
          class="iamw-box-close"
          data-box-close
          aria-label="Close"
        >
          ×
        </button>



        {% if section.settings.box_popup_image != blank %}

          <div class="iamw-box-image-wrap">

            {{
              section.settings.box_popup_image
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                class: 'iamw-box-image'
            }}

          </div>

        {% endif %}



        <div class="iamw-box-content">


          {% if section.settings.box_heading != blank %}

            <h3 class="iamw-box-heading">
              {{ section.settings.box_heading }}
            </h3>

          {% endif %}


          {% if section.settings.box_description != blank %}

            <div class="iamw-box-description">
              {{ section.settings.box_description }}
            </div>

          {% endif %}



          <div
            class="iamw-box-availability"
            data-box-availability
          >

            {% if selected_box_variant.available %}
              {{ section.settings.box_available_note }}
            {% else %}
              {{ section.settings.box_unavailable_note }}
            {% endif %}

          </div>



          <div
            class="iamw-box-quantity"
            data-box-quantity-wrap
          >

            <button
              type="button"
              class="iamw-box-qty-button"
              data-box-minus
            >
              −
            </button>


            <input
              type="number"
              value="1"
              min="1"
              class="iamw-box-qty-input"
              data-box-qty
            >


            <button
              type="button"
              class="iamw-box-qty-button"
              data-box-plus
            >
              +
            </button>

          </div>



          <button
            type="button"
            class="iamw-box-yes"
            data-box-yes
          >

            {{ section.settings.box_add_button_label }}

          </button>



          <button
            type="button"
            class="iamw-box-no"
            data-box-no
          >

            {{ section.settings.box_checkout_button_label }}

          </button>

        </div>

      </div>

    </div>

  {% endif %}

{% endif %}




<style>

#iamw-product {
  scroll-margin-top:
    30px;
}


.iamw-product-anchor {
  width:
    100%;

  height:
    0;
}



#IAMW-PRODUCT-{{ section.id }} {
  width:
    100%;

  padding:
    var(--pad-top)
    var(--pad-x)
    var(--pad-bottom);

  background:
    var(--background);

  color:
    var(--text);
}


#IAMW-PRODUCT-{{ section.id }} * {
  box-sizing:
    border-box;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__shell {
  width:
    100%;

  max-width:
    var(--page-width);

  margin:
    0 auto;
}



#IAMW-PRODUCT-{{ section.id }}
.iamw-product__warning {
  margin-bottom:
    24px;

  padding:
    18px 20px;

  display:
    flex;

  flex-direction:
    column;

  gap:
    4px;

  border:
    2px solid var(--orange);

  border-radius:
    12px;

  background:
    #fff8ed;

  color:
    var(--text);

  font-size:
    14px;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__warning strong {
  color:
    var(--purple);

  font-size:
    16px;
}



#IAMW-PRODUCT-{{ section.id }}
.iamw-product__grid {
  display:
    grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(0,1fr);

  gap:
    var(--column-gap);

  align-items:
    start;
}



/* GALLERY */

#IAMW-PRODUCT-{{ section.id }}
.iamw-product__gallery {
  width:
    100%;

  min-width:
    0;

  display:
    flex;

  flex-direction:
    column;

  gap:
    var(--thumb-gap);
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__main-media {
  width:
    100%;

  aspect-ratio:
    1 / 1;

  padding:
    {{ section.settings.image_inner_padding }}px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  overflow:
    hidden;

  background:
    var(--cream);

  border-radius:
    var(--radius);
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__main-image {
  display:
    block;

  width:
    100%;

  height:
    100%;

  max-width:
    100%;

  max-height:
    100%;

  object-fit:
    contain;

  object-position:
    center;

  margin:
    0;

  border:
    0;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__placeholder--main {
  width:
    100%;

  height:
    100%;

  display:
    grid;

  place-items:
    center;

  padding:
    30px;

  color:
    var(--muted);

  text-align:
    center;

  font-weight:
    800;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__thumbs {
  display:
    flex;

  gap:
    var(--thumb-gap);

  overflow-x:
    auto;

  padding:
    2px 2px 8px;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__thumb {
  flex:
    0 0 {{ section.settings.thumbnail_size }}px;

  width:
    {{ section.settings.thumbnail_size }}px;

  height:
    {{ section.settings.thumbnail_size }}px;

  padding:
    2px;

  overflow:
    hidden;

  border:
    2px solid transparent;

  border-radius:
    9px;

  background:
    #fff;

  cursor:
    pointer;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__thumb.is-active {
  border-color:
    var(--purple);
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__thumb-image {
  width:
    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    cover;

  border-radius:
    6px;
}



/* CONTENT */

#IAMW-PRODUCT-{{ section.id }}
.iamw-product__content {
  min-width:
    0;

  display:
    flex;

  flex-direction:
    column;

  gap:
    var(--content-gap);
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__audience {
  width:
    fit-content;

  padding:
    9px 18px;

  background:
    var(--soft);

  color:
    var(--purple);

  border-radius:
    999px;

  font-size:
    calc(var(--body-size) * .88);

  font-weight:
    800;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__rating {
  display:
    flex;

  align-items:
    center;

  flex-wrap:
    wrap;

  gap:
    8px;

  font-size:
    calc(var(--body-size) * .88);
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__stars {
  color:
    var(--orange);
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__kicker {
  color:
    var(--purple);

  font-size:
    calc(var(--body-size) * .78);

  font-weight:
    800;

  letter-spacing:
    .1em;

  text-transform:
    uppercase;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__title {
  margin:
    0;

  color:
    var(--text);

  font-size:
    var(--title-size);

  line-height:
    1.05;

  letter-spacing:
    -.025em;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__rte {
  color:
    var(--text);

  font-size:
    var(--body-size);

  line-height:
    1.65;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__rte p:first-child {
  margin-top:
    0;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__rte p:last-child {
  margin-bottom:
    0;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__price-row {
  display:
    flex;

  align-items:
    center;

  flex-wrap:
    wrap;

  gap:
    10px;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__compare-price {
  color:
    var(--muted);

  text-decoration:
    line-through;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__price {
  color:
    var(--orange);

  font-size:
    var(--price-size);

  font-weight:
    900;
}




#IAMW-PRODUCT-{{ section.id }}
.iamw-product__purchase-top {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

#IAMW-PRODUCT-{{ section.id }}
.iamw-product__purchase-top .iamw-product__title {
  margin-bottom: 2px;
}

#IAMW-PRODUCT-{{ section.id }}
.iamw-product__purchase-top .iamw-product__price-row {
  margin-top: 0;
  margin-bottom: 4px;
}

#IAMW-PRODUCT-{{ section.id }}
.iamw-product__form--top {
  margin-top: 2px;
}

#IAMW-PRODUCT-{{ section.id }}
.iamw-product__intro {
  margin-top: 4px;
}

/* ACCORDIONS */

#IAMW-PRODUCT-{{ section.id }}
.iamw-product__accordions {
  display:
    flex;

  flex-direction:
    column;

  gap:
    var(--accordion-gap);
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__accordion {
  overflow:
    hidden;

  background:
    #fff;

  border:
    1px solid var(--border);

  border-radius:
    calc(var(--radius) * .7);
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__accordion-summary {
  min-height:
    64px;

  padding:
    13px 16px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    14px;

  list-style:
    none;

  cursor:
    pointer;

  font-weight:
    800;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__accordion-summary::-webkit-details-marker {
  display:
    none;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__accordion-left {
  display:
    flex;

  align-items:
    center;

  gap:
    12px;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__accordion-icon {
  flex:
    0 0 auto;
}


#IAMW-PRODUCT-{{ section.id }}
.iamw-product__icon-image,
#IAMW-PRODUCT-{{ section.id }}
.iamw-product__svg svg {
  width:
