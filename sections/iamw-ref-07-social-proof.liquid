{% comment %}
  I AM WELL
  Social Proof Carousel + Metrics

  Supports:
  - Photo slides
  - Shopify-hosted video slides
  - Quote / testimonial slides
  - Mixed carousel
  - Manual arrows
  - Dots
  - Swipe
  - Autoplay toggle
  - Autoplay speed
  - Pause on hover
  - Pause after interaction
  - Metric cards below carousel
{% endcomment %}

<section
  id="IAMW-SOCIAL-{{ section.id }}"
  class="iamw-social"
  style="
    --page-width: {{ section.settings.page_width }}px;

    --pad-x: {{ section.settings.padding_x }}px;
    --pad-x-mobile: {{ section.settings.mobile_padding_x }}px;

    --pad-top: {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;

    --section-gap: {{ section.settings.section_gap }}px;
    --slide-gap: {{ section.settings.slide_gap }}px;
    --metric-gap: {{ section.settings.metric_gap }}px;

    --radius: {{ section.settings.radius }}px;

    --background: {{ section.settings.background }};
    --card-bg: {{ section.settings.card_background }};
    --purple: {{ section.settings.purple }};
    --orange: {{ section.settings.orange }};
    --cream: {{ section.settings.cream }};
    --text: {{ section.settings.text_color }};
    --muted: {{ section.settings.muted }};
    --border: {{ section.settings.border_color }};

    --heading-size: {{ section.settings.heading_size }}px;
    --body-size: {{ section.settings.body_size }}px;
    --quote-size: {{ section.settings.quote_size }}px;

    --heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --body-mobile: {{ section.settings.mobile_body_size }}px;
    --quote-mobile: {{ section.settings.mobile_quote_size }}px;

    --slide-width: {{ section.settings.slide_width }}px;
    --slide-height: {{ section.settings.slide_height }}px;
  "
>

  <div class="iamw-social__shell">

    {% comment %}
      SECTION HEADER
    {% endcomment %}

    {% if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.intro != blank
    %}

      <div class="iamw-social__head">

        {% if section.settings.eyebrow != blank %}
          <div class="iamw-social__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="iamw-social__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="iamw-social__rte">
            {{ section.settings.intro }}
          </div>
        {% endif %}

      </div>

    {% endif %}


    {% comment %}
      CHECK FOR SLIDES
    {% endcomment %}

    {% assign has_slides = false %}

    {% for block in section.blocks %}
      {% if block.type == 'media_slide' or block.type == 'quote_slide' %}
        {% assign has_slides = true %}
      {% endif %}
    {% endfor %}


    {% if has_slides %}

      <div
        class="iamw-social__carousel"
        data-iamw-carousel
      >

        <div class="iamw-social__viewport">

          <div
            class="iamw-social__track"
            data-iamw-track
          >

            {% for block in section.blocks %}

              {% if block.type == 'media_slide' %}

                <article
                  class="iamw-social__slide iamw-social__slide--media"
                  data-iamw-slide
                  {{ block.shopify_attributes }}
                >

                  <div class="iamw-social__media">

                    {% if block.settings.video != blank %}

                      {{
                        block.settings.video
                        | video_tag:
                          controls: true,
                          autoplay: false,
                          muted: false,
                          loop: false,
                          playsinline: true,
                          class: 'iamw-social__video'
                      }}

                    {% elsif block.settings.image != blank %}

                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '320,480,640,800,1000,1200',
                          sizes: '320px',
                          class: 'iamw-social__image'
                      }}

                    {% else %}

                      <div class="iamw-social__placeholder">
                        <span>ADD PHOTO OR VIDEO</span>
                      </div>

                    {% endif %}

                  </div>


                  {% if block.settings.caption != blank
                    or block.settings.name != blank
                  %}

                    <div class="iamw-social__media-caption">

                      {% if block.settings.caption != blank %}
                        <div class="iamw-social__caption">
                          {{ block.settings.caption }}
                        </div>
                      {% endif %}

                      {% if block.settings.name != blank %}
                        <div class="iamw-social__name">
                          {{ block.settings.name }}
                        </div>
                      {% endif %}

                    </div>

                  {% endif %}

                </article>


              {% elsif block.type == 'quote_slide' %}

                {% if block.settings.quote != blank
                  or block.settings.name != blank
                %}

                  <article
                    class="iamw-social__slide iamw-social__slide--quote"
                    data-iamw-slide
                    {{ block.shopify_attributes }}
                  >

                    {% if block.settings.photo != blank %}

                      <div class="iamw-social__quote-avatar">

                        {{
                          block.settings.photo
                          | image_url: width: 180
                          | image_tag:
                            loading: 'lazy',
                            class: 'iamw-social__avatar-image'
                        }}

                      </div>

                    {% endif %}


                    {% if block.settings.stars != blank %}

                      <div class="iamw-social__stars">
                        {{ block.settings.stars }}
                      </div>

                    {% endif %}


                    {% if block.settings.quote != blank %}

                      <div class="iamw-social__quote">
                        {{ block.settings.quote }}
                      </div>

                    {% endif %}


                    {% if block.settings.name != blank
                      or block.settings.meta != blank
                    %}

                      <div class="iamw-social__quote-footer">

                        {% if block.settings.name != blank %}
                          <strong>
                            {{ block.settings.name }}
                          </strong>
                        {% endif %}

                        {% if block.settings.meta != blank %}
                          <span>
                            {{ block.settings.meta }}
                          </span>
                        {% endif %}

                      </div>

                    {% endif %}

                  </article>

                {% endif %}

              {% endif %}

            {% endfor %}

          </div>

        </div>


        {% if section.settings.show_controls %}

          <div class="iamw-social__controls">

            <button
              type="button"
              class="iamw-social__arrow"
              data-iamw-prev
              aria-label="Previous reviews"
            >
              ‹
            </button>


            {% if section.settings.show_dots %}
              <div
                class="iamw-social__dots"
                data-iamw-dots
              >
              </div>
            {% endif %}


            <button
              type="button"
              class="iamw-social__arrow"
              data-iamw-next
              aria-label="Next reviews"
            >
              ›
            </button>

          </div>

        {% endif %}

      </div>

    {% endif %}


    {% comment %}
      METRIC CARDS
    {% endcomment %}

    {% assign has_metrics = false %}

    {% for block in section.blocks %}

      {% if block.type == 'metric' %}

        {% if block.settings.value != blank
          or block.settings.text != blank
        %}
          {% assign has_metrics = true %}
        {% endif %}

      {% endif %}

    {% endfor %}


    {% if has_metrics %}

      <div class="iamw-social__metrics">

        {% for block in section.blocks %}

          {% if block.type == 'metric' %}

            {% if block.settings.value != blank
              or block.settings.text != blank
            %}

              <div
                class="iamw-social__metric"
                {{ block.shopify_attributes }}
              >

                {% if block.settings.icon_image != blank %}

                  <span
                    class="iamw-social__metric-icon"
                    style="
                      width: {{ block.settings.icon_size }}px;
                      height: {{ block.settings.icon_size }}px;
                    "
                  >

                    {{
                      block.settings.icon_image
                      | image_url: width: 160
                      | image_tag:
                        loading: 'lazy',
                        class: 'iamw-social__metric-icon-image'
                    }}

                  </span>

                {% elsif block.settings.icon_svg != blank %}

                  <span
                    class="iamw-social__metric-icon iamw-social__svg"
                    style="
                      width: {{ block.settings.icon_size }}px;
                      height: {{ block.settings.icon_size }}px;
                    "
                  >
                    {{ block.settings.icon_svg }}
                  </span>

                {% endif %}


                <div class="iamw-social__metric-copy">

                  {% if block.settings.value != blank %}
                    <div class="iamw-social__metric-value">
                      {{ block.settings.value }}
                    </div>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="iamw-social__metric-text">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}

                </div>

              </div>

            {% endif %}

          {% endif %}

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>


<style>

