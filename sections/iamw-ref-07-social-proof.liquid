}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__media-caption {
  padding:
    16px 18px;

  display:
    flex;

  flex-direction:
    column;

  gap:
    6px;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__caption {
  color:
    var(--text);

  font-size:
    calc(var(--body-size) * .88);

  line-height:
    1.5;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__name {
  color:
    var(--purple);

  font-size:
    calc(var(--body-size) * .82);

  font-weight:
    900;
}


/* QUOTE CARDS */

#IAMW-SOCIAL-{{ section.id }}
.iamw-social__slide--quote {
  padding:
    28px;

  display:
    flex;

  flex-direction:
    column;

  justify-content:
    center;

  gap:
    18px;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__quote-avatar {
  width:
    58px;

  height:
    58px;

  overflow:
    hidden;

  border-radius:
    50%;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__avatar-image {
  width:
    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    cover;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__stars {
  color:
    var(--orange);

  font-size:
    calc(var(--body-size) * 1.1);

  letter-spacing:
    .04em;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__quote {
  color:
    var(--text);

  font-size:
    var(--quote-size);

  line-height:
    1.55;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__quote-footer {
  display:
    flex;

  flex-direction:
    column;

  gap:
    4px;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__quote-footer strong {
  color:
    var(--purple);

  font-size:
    calc(var(--body-size) * .9);
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__quote-footer span {
  color:
    var(--muted);

  font-size:
    calc(var(--body-size) * .78);
}


/* CONTROLS */

#IAMW-SOCIAL-{{ section.id }}
.iamw-social__controls {
  margin-top:
    24px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    16px;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__arrow {
  width:
    42px;

  height:
    42px;

  padding:
    0;

  display:
    grid;

  place-items:
    center;

  border:
