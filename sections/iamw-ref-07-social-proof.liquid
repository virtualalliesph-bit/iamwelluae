    var(--text);
}


#IAMW-SOCIAL-{{ section.id }} * {
  box-sizing: border-box;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__shell {
  width: 100%;

  max-width:
    var(--page-width);

  margin:
    0 auto;

  display:
    flex;

  flex-direction:
    column;

  gap:
    var(--section-gap);
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__head {
