  min-height:
    var(--slide-height);

  overflow:
    hidden;

  background:
    var(--cream);
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__image,
#IAMW-SOCIAL-{{ section.id }}
.iamw-social__video {
  width:
    100%;

  height:
    100%;

  min-height:
    var(--slide-height);

  display:
    block;

  object-fit:
    {{ section.settings.media_fit }};
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__placeholder {
