  cursor:
    pointer;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__arrow:hover {
  border-color:
    var(--purple);

  color:
    var(--purple);
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__dots {
  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    7px;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__dot {
  width:
    8px;

  height:
    8px;

  padding:
    0;

  border:
    0;

  border-radius:
    50%;

  background:
    #d2cad7;

  cursor:
    pointer;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__dot.is-active {
  background:
