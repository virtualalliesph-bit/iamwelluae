/* METRICS */

#IAMW-SOCIAL-{{ section.id }}
.iamw-social__metrics {
  display:
    grid;

  grid-template-columns:
    repeat(
      {{ section.settings.metric_columns }},
      minmax(0,1fr)
    );

  gap:
    var(--metric-gap);
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__metric {
  min-height:
    110px;

  padding:
    20px;

  display:
    flex;

  align-items:
    flex-start;

  gap:
    12px;

  background:
    #ffffff;

  border:
    1px solid var(--border);

  border-radius:
    var(--radius);
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__metric-icon {
  flex:
    0 0 auto;

  display:
    block;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__metric-icon-image {
  width:
    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    contain;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__svg svg {
  width:
    100%;

  height:
    100%;

  display:
    block;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__metric-copy {
  display:
    flex;

  flex-direction:
    column;

  gap:
    5px;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__metric-value {
  color:
    var(--purple);

  font-size:
    calc(var(--heading-size) * .62);

  font-weight:
    900;

  line-height:
    1;
}


#IAMW-SOCIAL-{{ section.id }}
.iamw-social__metric-text {
  color:
    var(--text);

  font-size:
    calc(var(--body-size) * .9);

  line-height:
    1.4;
}


/* MOBILE */

@media screen and (max-width: 749px) {

  #IAMW-SOCIAL-{{ section.id }} {
    padding-left:
      var(--pad-x-mobile);

    padding-right:
      var(--pad-x-mobile);
  }


  #IAMW-SOCIAL-{{ section.id }}
  .iamw-social__heading {
    font-size:
      var(--heading-mobile);
  }


  #IAMW-SOCIAL-{{ section.id }}
  .iamw-social__rte {
    font-size:
      var(--body-mobile);
  }


  #IAMW-SOCIAL-{{ section.id }}
  .iamw-social__quote {
    font-size:
      var(--quote-mobile);
  }


  #IAMW-SOCIAL-{{ section.id }}
  .iamw-social__slide {
    flex-basis:
      {{ section.settings.mobile_slide_width }}px;

    min-height:
      {{ section.settings.mobile_slide_height }}px;
  }


  #IAMW-SOCIAL-{{ section.id }}
  .iamw-social__media,
  #IAMW-SOCIAL-{{ section.id }}
  .iamw-social__image,
  #IAMW-SOCIAL-{{ section.id }}
  .iamw-social__video,
  #IAMW-SOCIAL-{{ section.id }}
  .iamw-social__placeholder {
    min-height:
      {{ section.settings.mobile_slide_height }}px;
  }


  #IAMW-SOCIAL-{{ section.id }}
  .iamw-social__metrics {
    grid-template-columns:
      1fr;
  }

}

</style>


<script>

(function() {

  function initIAMWSocialCarousel() {

    const section =
      document.getElementById(
        'IAMW-SOCIAL-{{ section.id }}'
      );

    if (!section) return;


    const carousel =
      section.querySelector(
        '[data-iamw-carousel]'
      );

    if (!carousel) return;


    const track =
      carousel.querySelector(
        '[data-iamw-track]'
      );


    const slides =
      carousel.querySelectorAll(
        '[data-iamw-slide]'
      );


    const prev =
      carousel.querySelector(
        '[data-iamw-prev]'
      );


    const next =
      carousel.querySelector(
        '[data-iamw-next]'
      );


    const dotsWrap =
      carousel.querySelector(
        '[data-iamw-dots]'
      );


    if (!track || !slides.length) return;


    let index = 0;
    let autoplayTimer = null;
    let interactionTimer = null;
    let isPaused = false;


    const autoplayEnabled =
      {{ section.settings.autoplay | json }};


    const autoplaySpeed =
      {{ section.settings.autoplay_speed | times: 1000 }};


    const pauseOnHover =
      {{ section.settings.pause_on_hover | json }};


    const pauseOnInteraction =
      {{ section.settings.pause_on_interaction | json }};


    function visibleCount() {

      if (window.innerWidth < 750) {
        return 1;
      }


      if (window.innerWidth < 1100) {
        return 2;
      }


      return {{ section.settings.desktop_visible_slides }};

    }


    function maxIndex() {

      return Math.max(
        0,
        slides.length - visibleCount()
      );

    }


    function slideStep() {

      if (!slides[0]) return 0;


      const rect =
        slides[0].getBoundingClientRect();


      const trackStyle =
        window.getComputedStyle(track);


      const gap =
        parseFloat(trackStyle.gap) || 0;


      return rect.width + gap;

    }


    function update() {

      const max =
        maxIndex();


      if (index > max) {
        index = max;
      }


      if (index < 0) {
        index = 0;
      }


      track.style.transform =
        'translateX(-' +
        (index * slideStep()) +
        'px)';


      if (dotsWrap) {

        const dots =
          dotsWrap.querySelectorAll(
            '.iamw-social__dot'
          );


        dots.forEach(
          function(dot, dotIndex) {

            dot.classList.toggle(
              'is-active',
              dotIndex === index
            );

          }
        );

      }

    }


    function buildDots() {

      if (!dotsWrap) return;


      dotsWrap.innerHTML = '';


      const count =
        maxIndex() + 1;


      for (
        let i = 0;
        i < count;
        i++
      ) {

        const dot =
          document.createElement(
            'button'
          );


        dot.type =
          'button';


        dot.className =
          'iamw-social__dot';


        if (i === index) {

          dot.classList.add(
            'is-active'
          );

        }


        dot.setAttribute(
          'aria-label',
          'Go to carousel position ' +
          (i + 1)
        );


        dot.addEventListener(
          'click',
          function() {

            index = i;

            update();

            handleInteraction();

          }
        );


        dotsWrap.appendChild(
          dot
        );

      }

    }


    function nextSlide() {

      const max =
        maxIndex();


      if (max <= 0) return;


      if (index >= max) {

        index = 0;

      } else {

        index =
          index + 1;

      }


      update();

    }


    function prevSlide() {

      const max =
        maxIndex();


      if (max <= 0) return;


      if (index <= 0) {

        index = max;

      } else {

        index =
          index - 1;

      }


      update();

    }


    function stopAutoplay() {

      if (autoplayTimer) {

        window.clearInterval(
          autoplayTimer
        );


        autoplayTimer =
          null;

      }

    }


    function startAutoplay() {

      if (!autoplayEnabled) return;


      if (slides.length <= visibleCount()) {
        return;
      }


      stopAutoplay();


      autoplayTimer =
        window.setInterval(
          function() {

            if (!isPaused) {

              nextSlide();

            }

          },
          autoplaySpeed
        );

    }


    function pauseAutoplay() {

      isPaused =
        true;

    }


    function resumeAutoplay() {

      isPaused =
        false;

    }


    function handleInteraction() {

      if (!pauseOnInteraction) {
        return;
      }


      pauseAutoplay();


      if (interactionTimer) {

        window.clearTimeout(
          interactionTimer
        );

      }


      interactionTimer =
        window.setTimeout(
          function() {

            resumeAutoplay();

          },
          autoplaySpeed
        );

    }


    if (prev) {

      prev.addEventListener(
        'click',
        function() {

          prevSlide();

          handleInteraction();

        }
      );

    }


    if (next) {

      next.addEventListener(
        'click',
        function() {

          nextSlide();

          handleInteraction();

        }
      );

    }


    if (pauseOnHover) {

      carousel.addEventListener(
        'mouseenter',
        pauseAutoplay
      );


      carousel.addEventListener(
        'mouseleave',
        resumeAutoplay
      );

    }


    let touchStartX = 0;


    track.addEventListener(
      'touchstart',
      function(event) {

        touchStartX =
          event.touches[0].clientX;


        if (pauseOnInteraction) {

          pauseAutoplay();

        }

      },
      {
        passive: true
      }
    );


    track.addEventListener(
      'touchend',
      function(event) {

        const touchEndX =
          event.changedTouches[0].clientX;


        const difference =
          touchStartX -
          touchEndX;


        if (
          Math.abs(difference) >
          45
        ) {

          if (difference > 0) {

            index =
              Math.min(
                index + 1,
                maxIndex()
              );

          } else {

            index =
              Math.max(
                index - 1,
                0
              );

          }


          update();

        }


        handleInteraction();

      },
      {
        passive: true
      }
    );


    document.addEventListener(
      'visibilitychange',
      function() {

        if (document.hidden) {

          pauseAutoplay();

        } else {

          resumeAutoplay();

        }

      }
    );


    window.addEventListener(
      'resize',
      function() {

        index =
          Math.min(
            index,
            maxIndex()
          );


        buildDots();

        update();

      }
    );


    buildDots();

    update();

    startAutoplay();

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initIAMWSocialCarousel
    );

  } else {

    initIAMWSocialCarousel();

  }


  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.target &&
        event.target.id ===
        'IAMW-SOCIAL-{{ section.id }}'
      ) {

        initIAMWSocialCarousel();

      }

    }
  );

})();

</script>


