
{% assign iamw_bundle_count = 0 %}
{% for block in section.blocks %}
  {% if block.type == 'bundle' and block.settings.product != blank %}
    {% assign iamw_bundle_count = iamw_bundle_count | plus: 1 %}
  {% endif %}
{% endfor %}

<section id="iamw-{{ section.id }}" class="iamw-landing">
  <div class="iamw-hero">
    <div class="iamw-wrap iamw-two">
      <div class="iamw-copy">
        <div class="iamw-kicker">{{ section.settings.hero_eyebrow }}</div>
        <h1>{{ section.settings.hero_heading }}</h1>
        <div class="iamw-rte">{{ section.settings.hero_body }}</div>
        <a class="iamw-btn" href="#iamw-products-{{ section.id }}">{{ section.settings.hero_cta_label }}</a>
      </div>
      <div class="iamw-media">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480,720,960,1200,1400', class: 'iamw-img' }}
        {% else %}
          <div class="iamw-placeholder">Choose hero image</div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="iamw-benefits">
    <div class="iamw-wrap iamw-two iamw-two--reverse">
      <div class="iamw-media">
        {% if section.settings.benefits_image != blank %}
          {{ section.settings.benefits_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480,720,960,1200', class: 'iamw-img' }}
        {% else %}
          <div class="iamw-placeholder">Choose benefits image</div>
        {% endif %}
      </div>
      <div>
        <div class="iamw-kicker">{{ section.settings.benefits_eyebrow }}</div>
        <h2>{{ section.settings.benefits_heading }}</h2>
        <div class="iamw-rte iamw-muted">{{ section.settings.benefits_intro }}</div>
        <div class="iamw-accordion">
          {% for i in (1..6) %}
            {% capture title_key %}benefit_{{ i }}_title{% endcapture %}
            {% capture text_key %}benefit_{{ i }}_text{% endcapture %}
            {% if section.settings[title_key] != blank %}
              <details {% if forloop.first %}open{% endif %}>
                <summary>{{ section.settings[title_key] }} <span>+</span></summary>
                <div class="iamw-rte">{{ section.settings[text_key] }}</div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="iamw-tabs-section">
    <div class="iamw-wrap">
      <div class="iamw-center">
        <div class="iamw-kicker">{{ section.settings.tabs_eyebrow }}</div>
        <h2>{{ section.settings.tabs_heading }}</h2>
      </div>
      <div class="iamw-tab-buttons" role="tablist">
        {% for i in (1..4) %}
          {% capture title_key %}tab_{{ i }}_title{% endcapture %}
          <button type="button" class="iamw-tab-btn{% if forloop.first %} is-active{% endif %}" data-iamw-tab="{{ i }}">{{ section.settings[title_key] }}</button>
        {% endfor %}
      </div>
      {% for i in (1..4) %}
        {% capture heading_key %}tab_{{ i }}_heading{% endcapture %}
        {% capture text_key %}tab_{{ i }}_text{% endcapture %}
        {% capture image_key %}tab_{{ i }}_image{% endcapture %}
        <div class="iamw-tab-panel{% if forloop.first %} is-active{% endif %}" data-iamw-panel="{{ i }}">
          <div class="iamw-two">
            <div>
              <h3>{{ section.settings[heading_key] }}</h3>
              <div class="iamw-rte">{{ section.settings[text_key] }}</div>
            </div>
            <div class="iamw-media">
              {% if section.settings[image_key] != blank %}
                {{ section.settings[image_key] | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480,720,1000', class: 'iamw-img' }}
              {% else %}
                <div class="iamw-placeholder">Choose tab image</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="iamw-products" id="iamw-products-{{ section.id }}">
    <div class="iamw-wrap">
      <div class="iamw-center">
        <div class="iamw-kicker">{{ section.settings.products_eyebrow }}</div>
        <h2>{{ section.settings.products_heading }}</h2>
        <div class="iamw-rte iamw-muted">{{ section.settings.products_intro }}</div>
      </div>
      <div class="iamw-product-grid{% if iamw_bundle_count == 1 %} is-single{% endif %}">
        {% for block in section.blocks %}
          {% if block.type == 'bundle' %}
            {% assign p = block.settings.product %}
            <article class="iamw-product-card" {{ block.shopify_attributes }}>
              {% if p != blank %}
                <div class="iamw-product-media">
                  {% if p.featured_image %}
                    {{ p.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '420,650,850,1000', class: 'iamw-product-image' }}
                  {% endif %}
                </div>
                <div class="iamw-badge">{{ block.settings.badge }}</div>
                <div class="iamw-kicker">{{ block.settings.kicker }}</div>
                <h3>{% if block.settings.title_override != blank %}{{ block.settings.title_override }}{% else %}{{ p.title }}{% endif %}</h3>
                <div class="iamw-price">{{ p.selected_or_first_available_variant.price | money }}</div>
                <div class="iamw-rte iamw-muted">{{ block.settings.description }}</div>
                {% if p.variants.size > 1 %}
                  <label class="iamw-label" for="iamw-variant-{{ section.id }}-{{ block.id }}">Choose option</label>
                  <select class="iamw-select" id="iamw-variant-{{ section.id }}-{{ block.id }}" data-iamw-variant>
                    {% for variant in p.variants %}
                      <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}
                      </option>
                    {% endfor %}
                  </select>
                {% else %}
                  <input type="hidden" data-iamw-variant value="{{ p.selected_or_first_available_variant.id }}">
                {% endif %}
                <button type="button" class="iamw-btn iamw-buy" data-iamw-buy {% unless p.selected_or_first_available_variant.available %}disabled{% endunless %}>
                  {{ block.settings.button_label }}
                </button>
                <div class="iamw-micro">{{ block.settings.microcopy }}</div>
              {% else %}
                <div class="iamw-placeholder iamw-placeholder--product">Select a Shopify product in this bundle block.</div>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="iamw-promo">
    <div class="iamw-wrap iamw-two">
      <div class="iamw-media">
        {% if section.settings.promo_image != blank %}
          {{ section.settings.promo_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480,720,960,1200', class: 'iamw-img' }}
        {% else %}
          <div class="iamw-placeholder">Choose promo image</div>
        {% endif %}
      </div>
      <div class="iamw-copy">
        <div class="iamw-kicker">{{ section.settings.promo_eyebrow }}</div>
        <h2>{{ section.settings.promo_heading }}</h2>
        <div class="iamw-rte">{{ section.settings.promo_body }}</div>
        <a class="iamw-btn" href="#iamw-products-{{ section.id }}">{{ section.settings.promo_cta_label }}</a>
      </div>
    </div>
  </div>

  <div class="iamw-proof">
    <div class="iamw-wrap">
      <div class="iamw-center">
        <div class="iamw-kicker">{{ section.settings.proof_eyebrow }}</div>
        <h2>{{ section.settings.proof_heading }}</h2>
        <div class="iamw-rte iamw-muted">{{ section.settings.proof_intro }}</div>
      </div>
      <div class="iamw-proof-grid">
        {% for block in section.blocks %}
          {% if block.type == 'proof' %}
            <div class="iamw-proof-card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,520,720,900', class: 'iamw-proof-image' }}
              {% else %}
                <div class="iamw-placeholder iamw-proof-ph">Add customer screenshot</div>
              {% endif %}
              {% if block.settings.caption != blank %}<div class="iamw-proof-caption">{{ block.settings.caption }}</div>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="iamw-testimonials">
    <div class="iamw-wrap">
      <div class="iamw-center">
        <div class="iamw-kicker">{{ section.settings.testimonials_eyebrow }}</div>
        <h2>{{ section.settings.testimonials_heading }}</h2>
      </div>
      <div class="iamw-testimonial-grid">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            <blockquote class="iamw-testimonial" {{ block.shopify_attributes }}>
              <div class="iamw-stars">{{ block.settings.stars }}</div>
              <p>“{{ block.settings.quote }}”</p>
              <footer><strong>{{ block.settings.name }}</strong>{% if block.settings.meta != blank %}<span>{{ block.settings.meta }}</span>{% endif %}</footer>
            </blockquote>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="iamw-compare">
    <div class="iamw-wrap">
      <div class="iamw-center">
        <div class="iamw-kicker">{{ section.settings.compare_eyebrow }}</div>
        <h2>{{ section.settings.compare_heading }}</h2>
        <div class="iamw-rte iamw-muted">{{ section.settings.compare_body }}</div>
      </div>
      <div class="iamw-table-wrap">
        <table class="iamw-table">
          <thead><tr><th>Feature</th><th>I Am Well</th><th>Other products</th></tr></thead>
          <tbody>
            {% for i in (1..5) %}
              {% capture row_key %}compare_{{ i }}{% endcapture %}
              <tr><td>{{ section.settings[row_key] }}</td><td class="yes">✓</td><td class="no">×</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="iamw-center"><a class="iamw-btn" href="#iamw-products-{{ section.id }}">{{ section.settings.compare_cta_label }}</a></div>
    </div>
  </div>
</section>

<style>
#iamw-{{ section.id }}{--purple:#42106b;--orange:#ff9418;--ink:#17131f;--muted:#655f69;--line:#e7ddeb;--soft:#f7effb;color:var(--ink);font-family:inherit}
#iamw-{{ section.id }} *{box-sizing:border-box}
#iamw-{{ section.id }} .iamw-wrap{max-width:1180px;margin:0 auto;padding:64px 24px}
#iamw-{{ section.id }} .iamw-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}
#iamw-{{ section.id }} .iamw-two--reverse{grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr)}
#iamw-{{ section.id }} h1,#iamw-{{ section.id }} h2,#iamw-{{ section.id }} h3{margin:0;color:var(--purple);letter-spacing:-.035em}
#iamw-{{ section.id }} h1{font-size:clamp(42px,6vw,74px);line-height:.98}
#iamw-{{ section.id }} h2{font-size:clamp(34px,4.5vw,54px);line-height:1.03}
#iamw-{{ section.id }} h3{font-size:clamp(24px,3vw,34px);line-height:1.08}
#iamw-{{ section.id }} .iamw-kicker{font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:800;color:var(--orange);margin-bottom:12px}
#iamw-{{ section.id }} .iamw-rte{font-size:16px;line-height:1.68}
#iamw-{{ section.id }} .iamw-rte p{margin:12px 0 0}
#iamw-{{ section.id }} .iamw-muted{color:var(--muted)}
#iamw-{{ section.id }} .iamw-copy .iamw-rte{margin-top:16px}
#iamw-{{ section.id }} .iamw-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;margin-top:22px;padding:13px 26px;border:0;border-radius:999px;background:var(--purple);color:#fff;text-decoration:none;font:inherit;font-weight:800;cursor:pointer}
#iamw-{{ section.id }} .iamw-btn[disabled]{opacity:.45;cursor:not-allowed}
#iamw-{{ section.id }} .iamw-media{border-radius:22px;overflow:hidden;background:var(--soft)}
#iamw-{{ section.id }} .iamw-img{display:block;width:100%;height:auto}
#iamw-{{ section.id }} .iamw-placeholder{min-height:420px;display:grid;place-items:center;padding:24px;text-align:center;color:var(--muted);background:var(--soft)}
#iamw-{{ section.id }} .iamw-center{text-align:center;max-width:820px;margin:0 auto 30px}
#iamw-{{ section.id }} .iamw-benefits,#iamw-{{ section.id }} .iamw-products,#iamw-{{ section.id }} .iamw-testimonials{background:#fff}
#iamw-{{ section.id }} .iamw-tabs-section,#iamw-{{ section.id }} .iamw-promo,#iamw-{{ section.id }} .iamw-compare{background:var(--soft)}
#iamw-{{ section.id }} .iamw-accordion{margin-top:24px;border-top:1px solid var(--line)}
#iamw-{{ section.id }} details{border-bottom:1px solid var(--line);padding:0}
#iamw-{{ section.id }} summary{display:flex;justify-content:space-between;gap:16px;cursor:pointer;list-style:none;padding:18px 0;font-weight:800;color:var(--purple)}
#iamw-{{ section.id }} summary::-webkit-details-marker{display:none}
#iamw-{{ section.id }} details[open] summary span{transform:rotate(45deg)}
#iamw-{{ section.id }} details .iamw-rte{padding:0 0 18px;color:var(--muted)}
#iamw-{{ section.id }} .iamw-tab-buttons{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:26px}
#iamw-{{ section.id }} .iamw-tab-btn{border:1px solid var(--line);background:#fff;color:var(--purple);border-radius:999px;padding:11px 17px;font:inherit;font-weight:800;cursor:pointer}
#iamw-{{ section.id }} .iamw-tab-btn.is-active{background:var(--purple);color:#fff;border-color:var(--purple)}
#iamw-{{ section.id }} .iamw-tab-panel{display:none;background:#fff;border:1px solid var(--line);border-radius:20px;padding:28px}
#iamw-{{ section.id }} .iamw-tab-panel.is-active{display:block}
#iamw-{{ section.id }} .iamw-product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;max-width:1040px;margin:0 auto}
#iamw-{{ section.id }} .iamw-product-grid.is-single{grid-template-columns:minmax(0,720px);justify-content:center}
#iamw-{{ section.id }} .iamw-product-card{border:1px solid var(--line);border-radius:20px;padding:22px;background:#fff;overflow:hidden}
#iamw-{{ section.id }} .iamw-product-media{border-radius:14px;background:var(--soft);overflow:hidden;margin-bottom:18px}
#iamw-{{ section.id }} .iamw-product-image{display:block;width:100%;height:auto}
#iamw-{{ section.id }} .iamw-badge{display:inline-flex;padding:7px 11px;border-radius:999px;background:#fff2df;color:#8c4e00;font-size:11px;font-weight:900;margin-bottom:10px}
#iamw-{{ section.id }} .iamw-price{font-size:22px;font-weight:900;color:var(--ink);margin:8px 0 12px}
#iamw-{{ section.id }} .iamw-label{display:block;font-size:13px;font-weight:800;margin:18px 0 6px}
#iamw-{{ section.id }} .iamw-select{width:100%;min-height:46px;border:1px solid var(--line);border-radius:10px;padding:8px 12px;background:#fff;color:var(--ink)}
#iamw-{{ section.id }} .iamw-buy{width:100%}
#iamw-{{ section.id }} .iamw-micro{font-size:12px;color:var(--muted);text-align:center;margin-top:8px}
#iamw-{{ section.id }} .iamw-placeholder--product{min-height:260px}
#iamw-{{ section.id }} .iamw-proof-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
#iamw-{{ section.id }} .iamw-proof-card{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#fff}
#iamw-{{ section.id }} .iamw-proof-image{display:block;width:100%;height:auto}
#iamw-{{ section.id }} .iamw-proof-ph{min-height:300px}
#iamw-{{ section.id }} .iamw-proof-caption{padding:10px 12px;font-size:12px;color:var(--muted)}
#iamw-{{ section.id }} .iamw-testimonial-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
#iamw-{{ section.id }} .iamw-testimonial{margin:0;padding:22px;border:1px solid var(--line);border-radius:16px;background:#fff}
#iamw-{{ section.id }} .iamw-testimonial p{line-height:1.6}
#iamw-{{ section.id }} .iamw-testimonial footer{display:flex;flex-direction:column;gap:3px;font-size:13px;color:var(--muted)}
#iamw-{{ section.id }} .iamw-stars{color:var(--orange);letter-spacing:.04em}
#iamw-{{ section.id }} .iamw-table-wrap{overflow:auto;border:1px solid var(--line);border-radius:16px;background:#fff;max-width:920px;margin:0 auto 10px}
#iamw-{{ section.id }} .iamw-table{width:100%;border-collapse:collapse;min-width:620px}
#iamw-{{ section.id }} .iamw-table th,#iamw-{{ section.id }} .iamw-table td{padding:16px;border-bottom:1px solid var(--line);text-align:left}
#iamw-{{ section.id }} .iamw-table th{color:var(--purple)}
#iamw-{{ section.id }} .iamw-table .yes{color:#208a50;font-weight:900;text-align:center}
#iamw-{{ section.id }} .iamw-table .no{color:#a44c4c;font-weight:900;text-align:center}
@media(max-width:900px){
  #iamw-{{ section.id }} .iamw-wrap{padding:48px 16px}
  #iamw-{{ section.id }} .iamw-two,#iamw-{{ section.id }} .iamw-two--reverse{grid-template-columns:1fr;gap:26px}
  #iamw-{{ section.id }} .iamw-hero .iamw-copy{order:1}
  #iamw-{{ section.id }} .iamw-hero .iamw-media{order:2}
  #iamw-{{ section.id }} .iamw-product-grid{grid-template-columns:1fr}
  #iamw-{{ section.id }} .iamw-proof-grid,#iamw-{{ section.id }} .iamw-testimonial-grid{display:flex;overflow:auto;scroll-snap-type:x mandatory;padding-bottom:8px}
  #iamw-{{ section.id }} .iamw-proof-card,#iamw-{{ section.id }} .iamw-testimonial{flex:0 0 82vw;scroll-snap-align:start}
}
</style>

<script>
(() => {
  const root = document.getElementById('iamw-{{ section.id }}');
  if (!root || root.dataset.iamwReady === 'true') return;
  root.dataset.iamwReady = 'true';

  root.querySelectorAll('[data-iamw-tab]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.iamwTab;
      root.querySelectorAll('[data-iamw-tab]').forEach((b) => b.classList.toggle('is-active', b === button));
      root.querySelectorAll('[data-iamw-panel]').forEach((p) => p.classList.toggle('is-active', p.dataset.iamwPanel === id));
    });
  });

  root.querySelectorAll('[data-iamw-buy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const card = button.closest('.iamw-product-card');
      const variantField = card && card.querySelector('[data-iamw-variant]');
      if (!variantField || !variantField.value) return;
      const original = button.textContent;
      button.disabled = true;
      button.textContent = 'GOING TO CHECKOUT…';
      try {
        const base = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
        const res = await fetch(base + 'cart/add.js', {
          method: 'POST',
          headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
          body: JSON.stringify({items:[{id:Number(variantField.value), quantity:1}]})
        });
        if (!res.ok) throw new Error('Unable to add item');
        window.location.assign('/checkout');
      } catch (e) {
        button.disabled = false;
        button.textContent = original;
        alert('Please try again.');
      }
    });
  });
})();
</script>

