{% comment %}
  I AM WELL
  Reference Section 03
  Image + Accordion Education Section

  CTA options:
  1. Scroll to section
  2. Regular link
{% endcomment %}

<section
  id="IAMW-ACC-{{ section.id }}"
  class="iamw-acc"
  style="
    --page-width: {{ section.settings.page_width }}px;

    --pad-x: {{ section.settings.padding_x }}px;
    --pad-x-mobile: {{ section.settings.mobile_padding_x }}px;

    --pad-top: {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;

    --section-gap: {{ section.settings.section_gap }}px;
    --column-gap: {{ section.settings.column_gap }}px;
    --accordion-gap: {{ section.settings.accordion_gap }}px;

    --radius: {{ section.settings.radius }}px;

    --purple: {{ section.settings.purple }};
    --orange: {{ section.settings.orange }};
    --cream: {{ section.settings.cream }};
    --background: {{ section.settings.background }};
    --text: {{ section.settings.text_color }};
    --muted: {{ section.settings.muted }};
    --border: {{ section.settings.border_color }};

    --heading-size: {{ section.settings.heading_size }}px;
    --body-size: {{ section.settings.body_size }}px;
    --accordion-title-size: {{ section.settings.accordion_title_size }}px;

    --heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --body-mobile: {{ section.settings.mobile_body_size }}px;
    --accordion-title-mobile: {{ section.settings.mobile_accordion_title_size }}px;
  "
>

  <div class="iamw-acc__shell">


    {% comment %}
      HEADER
    {% endcomment %}

    {% if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.intro != blank
    %}

      <div class="iamw-acc__head">

        {% if section.settings.eyebrow != blank %}

          <div class="iamw-acc__eyebrow">
            {{ section.settings.eyebrow }}
          </div>

        {% endif %}


        {% if section.settings.heading != blank %}

          <h2 class="iamw-acc__heading">
            {{ section.settings.heading }}
          </h2>

        {% endif %}


        {% if section.settings.intro != blank %}

          <div class="iamw-acc__rte iamw-acc__intro">
            {{ section.settings.intro }}
          </div>

        {% endif %}

      </div>

    {% endif %}



    {% comment %}
      IMAGE + ACCORDIONS
    {% endcomment %}

    <div class="iamw-acc__grid">


      <div class="iamw-acc__media">

        {% if section.settings.image != blank %}

          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '480,720,960,1200,1600',
              sizes: '(min-width: 990px) 48vw, 100vw',
              class: 'iamw-acc__image'
          }}

        {% else %}

          <div class="iamw-acc__placeholder">
            <span>
              ADD EDUCATIONAL / LIFESTYLE IMAGE
            </span>
          </div>

        {% endif %}

      </div>



      {% assign has_accordion = false %}

      {% for block in section.blocks %}

        {% if block.type == 'accordion' %}

          {% if block.settings.title != blank %}
            {% assign has_accordion = true %}
          {% endif %}

        {% endif %}

      {% endfor %}



      {% if has_accordion %}

        <div class="iamw-acc__list">

          {% for block in section.blocks %}

            {% if block.type == 'accordion' %}

              {% if block.settings.title != blank %}

                <details
                  class="iamw-acc__item"
                  {% if block.settings.open_by_default %}open{% endif %}
                  {{ block.shopify_attributes }}
                >

                  <summary class="iamw-acc__summary">

                    <div class="iamw-acc__summary-left">


                      {% if block.settings.icon_image != blank %}

                        <span
                          class="iamw-acc__icon"
                          style="
                            width: {{ block.settings.icon_size }}px;
                            height: {{ block.settings.icon_size }}px;
                          "
                        >

                          {{
                            block.settings.icon_image
                            | image_url: width: 180
                            | image_tag:
                              loading: 'lazy',
                              class: 'iamw-acc__icon-image'
                          }}

                        </span>


                      {% elsif block.settings.icon_svg != blank %}

                        <span
                          class="iamw-acc__icon iamw-acc__svg"
                          style="
                            width: {{ block.settings.icon_size }}px;
                            height: {{ block.settings.icon_size }}px;
                          "
                        >
                          {{ block.settings.icon_svg }}
                        </span>

                      {% endif %}


                      <span class="iamw-acc__title">
                        {{ block.settings.title }}
                      </span>

                    </div>


                    <span class="iamw-acc__toggle">

                      <span class="iamw-acc__toggle-icon">
                        ⌄
                      </span>

                    </span>

                  </summary>



                  {% if block.settings.text != blank %}

                    <div class="iamw-acc__content">

                      <div class="iamw-acc__rte">
                        {{ block.settings.text }}
                      </div>

                    </div>

                  {% endif %}

                </details>

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}

    </div>



    {% comment %}
      CTA DESTINATION
    {% endcomment %}

    {% if section.settings.cta_text != blank %}

      {% assign iamw_cta_url = blank %}

      {% if section.settings.cta_destination == 'anchor' %}

        {% if section.settings.cta_anchor != blank %}
          {% assign iamw_cta_url = '#' | append: section.settings.cta_anchor %}
        {% endif %}

      {% elsif section.settings.cta_destination == 'link' %}

        {% if section.settings.cta_link != blank %}
          {% assign iamw_cta_url = section.settings.cta_link %}
        {% endif %}

      {% endif %}


      <div class="iamw-acc__bottom">

        {% if iamw_cta_url != blank %}

          <a
            href="{{ iamw_cta_url }}"
            class="iamw-acc__cta"
            {% if section.settings.cta_destination == 'anchor' %}
              data-iamw-anchor-link
            {% endif %}
          >
            {{ section.settings.cta_text }}
          </a>

        {% else %}

          <div class="iamw-acc__cta iamw-acc__cta--disabled">
            {{ section.settings.cta_text }}
          </div>

        {% endif %}



        {% if section.settings.trust_text != blank %}

          <div class="iamw-acc__trust">


            {% if section.settings.trust_icon != blank %}

              <span
                class="iamw-acc__trust-icon"
                style="
                  width: {{ section.settings.trust_icon_size }}px;
                  height: {{ section.settings.trust_icon_size }}px;
                "
              >

                {{
                  section.settings.trust_icon
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    class: 'iamw-acc__trust-image'
                }}

              </span>


            {% elsif section.settings.trust_svg != blank %}

              <span
                class="iamw-acc__trust-icon iamw-acc__svg"
                style="
                  width: {{ section.settings.trust_icon_size }}px;
                  height: {{ section.settings.trust_icon_size }}px;
                "
              >
                {{ section.settings.trust_svg }}
              </span>

            {% endif %}


            <span>
              {{ section.settings.trust_text }}
            </span>

          </div>

        {% endif %}

      </div>

    {% endif %}

  </div>

</section>



<style>

#IAMW-ACC-{{ section.id }} {
