    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    {{ section.settings.image_fit }};
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__placeholder {
  width:
    100%;

  min-height:
    {{ section.settings.image_height }}px;

  display:
