  letter-spacing:
    .06em;
}



#IAMW-ACC-{{ section.id }}
.iamw-acc__list {
  display:
    flex;

  flex-direction:
    column;

  gap:
    var(--accordion-gap);
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__item {
  overflow:
    hidden;

  border:
    1px solid var(--border);

  border-radius:
    var(--radius);

  background:
    #fff;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__summary {
  list-style:
    none;

  cursor:
    pointer;

  min-height:
    78px;

  padding:
    16px 18px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    18px;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__summary::-webkit-details-marker {
  display:
    none;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__summary-left {
  min-width:
    0;

  display:
    flex;

  align-items:
    center;

  gap:
    14px;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__icon {
  flex:
    0 0 auto;

  display:
    block;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__icon-image,

#IAMW-ACC-{{ section.id }}
.iamw-acc__trust-image {
  width:
    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    contain;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__svg svg {
  width:
    100%;

  height:
    100%;

  display:
    block;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__title {
  color:
    var(--text);

  font-size:
    var(--accordion-title-size);

  font-weight:
    800;

  line-height:
    1.25;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__toggle {
  flex:
    0 0 auto;

  width:
    30px;

  height:
    30px;

  display:
    grid;

  place-items:
    center;

  border-radius:
    50%;

  background:
    var(--purple);

  color:
    #fff;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__toggle-icon {
  display:
    block;

  transform:
    translateY(-1px);

  transition:
    transform .2s ease;

  font-size:
    18px;

  font-weight:
    800;

  line-height:
    1;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__item[open]
.iamw-acc__toggle-icon {
  transform:
    rotate(180deg)
    translateY(1px);
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__content {
  padding:
    0 18px 18px 18px;
}



#IAMW-ACC-{{ section.id }}
.iamw-acc__bottom {
  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  gap:
    16px;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__cta {
  min-height:
    52px;

  padding:
    14px 26px;

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  background:
    var(--orange);

  color:
    #111;

  border-radius:
    10px;

  text-decoration:
    none;

  text-align:
    center;

  font-size:
    var(--body-size);

  font-weight:
    900;

  cursor:
    pointer;

  transition:
    transform .2s ease,
    opacity .2s ease;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__cta:hover {
  transform:
    translateY(-1px);

  opacity:
    .92;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__cta--disabled {
  cursor:
    default;

  opacity:
    .6;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__trust {
  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    10px;

  color:
    var(--text);

  font-size:
    calc(var(--body-size) * .88);

  line-height:
    1.4;

  text-align:
    center;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__trust-icon {
  flex:
    0 0 auto;

  display:
    block;
}



@media screen and (max-width: 989px) {

  #IAMW-ACC-{{ section.id }} {
    padding-left:
      var(--pad-x-mobile);

    padding-right:
      var(--pad-x-mobile);
  }


  #IAMW-ACC-{{ section.id }}
  .iamw-acc__heading {
    font-size:
      var(--heading-mobile);
  }


  #IAMW-ACC-{{ section.id }}
  .iamw-acc__rte {
    font-size:
      var(--body-mobile);
  }


  #IAMW-ACC-{{ section.id }}
  .iamw-acc__title {
    font-size:
      var(--accordion-title-mobile);
  }


  #IAMW-ACC-{{ section.id }}
  .iamw-acc__grid {
    grid-template-columns:
      1fr;
  }


  #IAMW-ACC-{{ section.id }}
  .iamw-acc__media,

  #IAMW-ACC-{{ section.id }}
  .iamw-acc__placeholder {
    min-height:
      {{ section.settings.mobile_image_height }}px;
  }

}

</style>



<script>

(function() {

  function initIAMWAccordionCTA() {

    const section =
      document.getElementById(
        'IAMW-ACC-{{ section.id }}'
      );

    if (!section) return;


    const anchorLinks =
      section.querySelectorAll(
        '[data-iamw-anchor-link]'
      );


    anchorLinks.forEach(
      function(link) {

        if (
          link.dataset.iamwAnchorReady ===
          'true'
        ) {
          return;
        }


        link.dataset.iamwAnchorReady =
          'true';


        link.addEventListener(
          'click',
          function(event) {

            const href =
              link.getAttribute(
                'href'
              );


            if (
              !href ||
              href.charAt(0) !== '#'
            ) {
              return;
            }


            const target =
              document.querySelector(
                href
              );


            if (!target) {
              return;
            }


            event.preventDefault();


            target.scrollIntoView({
              behavior:
                'smooth',

              block:
                'start'
            });


            if (
              window.history &&
              window.history.replaceState
            ) {

              window.history.replaceState(
                null,
                '',
                href
              );

            }

          }
        );

      }
    );

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initIAMWAccordionCTA
    );

  } else {

    initIAMWAccordionCTA();

  }


  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.target &&
        event.target.id ===
        'IAMW-ACC-{{ section.id }}'
      ) {

        initIAMWAccordionCTA();

      }

    }
  );

})();

</script>



{% schema %}

{
  "name": "IAMW Accordion",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY SMART GUMMIES?"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Smart support where your child needs it most."
    },

    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Especially for picky eaters, growing kids and moms who want one easier daily nutrition routine.</p>"
    },


    {
      "type": "header",
      "content": "Image"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Educational / lifestyle image"
    },

    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },

    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image height",
      "min": 420,
      "max": 900,
      "step": 20,
      "default": 620,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 280,
      "max": 650,
      "step": 10,
      "default": 420,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "CTA"
    },

    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "HELP MY CHILD EAT BETTER"
    },

    {
      "type": "select",
      "id": "cta_destination",
      "label": "CTA destination",
      "default": "anchor",
      "options": [
        {
          "value": "anchor",
          "label": "Scroll to section"
        },
        {
          "value": "link",
          "label": "Regular link"
        }
      ]
    },

    {
      "type": "text",
      "id": "cta_anchor",
      "label": "Anchor ID",
      "default": "iamw-product",
      "info": "Enter the anchor without the # symbol."
    },

    {
      "type": "url",
      "id": "cta_link",
      "label": "Regular link"
    },

    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust text",
      "default": "Kid-friendly mixed berry gummy • Food supplement"
    },

    {
      "type": "image_picker",
      "id": "trust_icon",
      "label": "Optional trust icon"
    },

    {
      "type": "html",
      "id": "trust_svg",
      "label": "Or paste trust SVG"
    },

    {
      "type": "range",
      "id": "trust_icon_size",
      "label": "Trust icon size",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 24,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "page_width",
      "label": "Max page width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1260,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_x",
      "label": "Desktop side padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_padding_x",
      "label": "Mobile side padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 52,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 52,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "section_gap",
      "label": "Section gap",
      "min": 16,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 16,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "accordion_gap",
      "label": "Accordion gap",
      "min": 6,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 14,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 30,
      "max": 64,
      "step": 2,
      "default": 42,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 17,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "accordion_title_size",
      "label": "Accordion title size",
      "min": 14,
