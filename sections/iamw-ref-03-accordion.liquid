    var(--text);
}


#IAMW-ACC-{{ section.id }} * {
  box-sizing:
    border-box;
}


#IAMW-ACC-{{ section.id }}
.iamw-acc__shell {
  width:
    100%;

  max-width:
    var(--page-width);

  margin:
    0 auto;

  display:
    flex;

  flex-direction:
