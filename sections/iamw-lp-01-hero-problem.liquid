{% comment %}
  I AM WELL SMART GUMMIES
  LANDING PAGE SECTION 01
  Hero + Parent Problem + Benefit Cards
{% endcomment %}

<section
  id="IAMW-LP01-{{ section.id }}"
  class="iamw-lp01"
  style="
    --page-width: {{ section.settings.page_width }}px;
    --pad-x: {{ section.settings.padding_x }}px;
    --pad-x-mobile: {{ section.settings.mobile_padding_x }}px;
    --pad-top: {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;
    --section-gap: {{ section.settings.section_gap }}px;
    --card-gap: {{ section.settings.card_gap }}px;
    --radius: {{ section.settings.radius }}px;

    --purple: {{ section.settings.purple }};
    --orange: {{ section.settings.orange }};
    --cream: {{ section.settings.cream }};
    --ink: {{ section.settings.ink }};
    --muted: {{ section.settings.muted }};

    --hero-size: {{ section.settings.hero_title_size }}px;
    --heading-size: {{ section.settings.section_title_size }}px;
    --body-size: {{ section.settings.body_size }}px;

    --hero-mobile: {{ section.settings.mobile_hero_title_size }}px;
    --heading-mobile: {{ section.settings.mobile_section_title_size }}px;
    --body-mobile: {{ section.settings.mobile_body_size }}px;
  "
>

  <div class="iamw-lp01__shell">

    {% comment %} HERO {% endcomment %}

    <div class="iamw-lp01__hero">

      <div class="iamw-lp01__hero-copy">

        {% if section.settings.hero_eyebrow != blank %}
          <div class="iamw-lp01__eyebrow">
            {{ section.settings.hero_eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.hero_title != blank %}
          <h1>
            {{ section.settings.hero_title }}
          </h1>
        {% endif %}

        {% if section.settings.hero_text != blank %}
          <div class="iamw-lp01__rte">
            {{ section.settings.hero_text }}
          </div>
        {% endif %}

        {% if section.settings.hero_cta_text != blank %}

          {% if section.settings.hero_cta_link != blank %}
            <a
              href="{{ section.settings.hero_cta_link }}"
              class="iamw-lp01__btn"
            >
              {{ section.settings.hero_cta_text }}
            </a>
          {% else %}
            <div class="iamw-lp01__btn iamw-lp01__btn--disabled">
              {{ section.settings.hero_cta_text }}
            </div>
          {% endif %}

        {% endif %}

        {% if section.settings.hero_microcopy != blank %}
          <div class="iamw-lp01__microcopy">
            {{ section.settings.hero_microcopy }}
          </div>
        {% endif %}

      </div>


      <div class="iamw-lp01__hero-media">

        {% if section.settings.hero_image != blank %}

          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              loading: 'eager',
              widths: '480,720,960,1200,1600,1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'iamw-lp01__image'
          }}

        {% else %}

          <div class="iamw-lp01__placeholder iamw-lp01__placeholder--hero">
            <span>ADD HERO IMAGE</span>
          </div>

        {% endif %}


        {% assign has_hero_benefits = false %}

        {% for block in section.blocks %}

          {% if block.type == 'hero_benefit' %}

            {% if block.settings.text != blank %}
              {% assign has_hero_benefits = true %}
            {% endif %}

          {% endif %}

        {% endfor %}


        {% if has_hero_benefits %}

          <div class="iamw-lp01__benefit-float">

            {% for block in section.blocks %}

              {% if block.type == 'hero_benefit' %}

                {% if block.settings.text != blank %}

                  <div
                    class="iamw-lp01__benefit-item"
                    {{ block.shopify_attributes }}
                  >

                    {% if block.settings.icon_image != blank %}

                      <span
                        class="iamw-lp01__icon-holder"
                        style="
                          width: {{ block.settings.icon_size }}px;
                          height: {{ block.settings.icon_size }}px;
                        "
                      >

                        {{
                          block.settings.icon_image
                          | image_url: width: 160
                          | image_tag:
                            loading: 'lazy',
                            class: 'iamw-lp01__icon-image'
                        }}

                      </span>

                    {% elsif block.settings.icon_svg != blank %}

                      <span
                        class="iamw-lp01__icon-holder iamw-lp01__svg"
                        style="
                          width: {{ block.settings.icon_size }}px;
                          height: {{ block.settings.icon_size }}px;
                        "
                      >
                        {{ block.settings.icon_svg }}
                      </span>

                    {% endif %}


                    <span class="iamw-lp01__benefit-text">
                      {{ block.settings.text }}
                    </span>

                  </div>

                {% endif %}

              {% endif %}

            {% endfor %}

          </div>

        {% endif %}

      </div>

    </div>


    {% comment %} TRUST STRIP {% endcomment %}

    {% if section.settings.trust_strip_text != blank %}

      <div class="iamw-lp01__trust-strip">
        {{ section.settings.trust_strip_text }}
      </div>

    {% endif %}


    {% comment %} PARENT PROBLEM {% endcomment %}

    <div class="iamw-lp01__problem">

      <div class="iamw-lp01__problem-media">

        {% if section.settings.problem_image != blank %}

          {{
            section.settings.problem_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '480,720,960,1200,1400',
              sizes: '(min-width: 990px) 46vw, 100vw',
              class: 'iamw-lp01__image'
          }}

        {% else %}

          <div class="iamw-lp01__placeholder iamw-lp01__placeholder--problem">
            <span>ADD PARENT / CHILD LIFESTYLE IMAGE</span>
          </div>

        {% endif %}

      </div>


      <div class="iamw-lp01__problem-copy">

        {% if section.settings.problem_eyebrow != blank %}

          <div class="iamw-lp01__eyebrow">
            {{ section.settings.problem_eyebrow }}
          </div>

        {% endif %}


        {% if section.settings.problem_title != blank %}

          <h2>
            {{ section.settings.problem_title }}
          </h2>

        {% endif %}


        {% if section.settings.problem_text != blank %}

          <div class="iamw-lp01__rte">
            {{ section.settings.problem_text }}
          </div>

        {% endif %}


        {% if section.settings.problem_cta_text != blank %}

          {% if section.settings.problem_cta_link != blank %}

            <a
              href="{{ section.settings.problem_cta_link }}"
              class="iamw-lp01__btn iamw-lp01__btn--purple"
            >
              {{ section.settings.problem_cta_text }}
            </a>

          {% else %}

            <div class="iamw-lp01__btn iamw-lp01__btn--purple iamw-lp01__btn--disabled">
              {{ section.settings.problem_cta_text }}
            </div>

          {% endif %}

        {% endif %}

      </div>

    </div>


    {% comment %}
      DETECT WHETHER ANY BENEFIT CARD HAS CONTENT
    {% endcomment %}

    {% assign has_cards = false %}

    {% for block in section.blocks %}

      {% if block.type == 'benefit_card' %}

        {% if block.settings.kicker != blank
          or block.settings.title != blank
          or block.settings.text != blank
          or block.settings.support_text != blank
        %}

          {% assign has_cards = true %}

        {% endif %}

      {% endif %}

    {% endfor %}


    {% if has_cards %}

      <div class="iamw-lp01__cards-section">

        {% if section.settings.cards_eyebrow != blank
          or section.settings.cards_title != blank
          or section.settings.cards_intro != blank
        %}

          <div class="iamw-lp01__center-head">

            {% if section.settings.cards_eyebrow != blank %}

              <div class="iamw-lp01__eyebrow">
                {{ section.settings.cards_eyebrow }}
              </div>

            {% endif %}


            {% if section.settings.cards_title != blank %}

              <h2>
                {{ section.settings.cards_title }}
              </h2>

            {% endif %}


            {% if section.settings.cards_intro != blank %}

              <div class="iamw-lp01__rte">
                {{ section.settings.cards_intro }}
              </div>

            {% endif %}

          </div>

        {% endif %}


        <div class="iamw-lp01__card-grid">

          {% for block in section.blocks %}

            {% if block.type == 'benefit_card' %}

              {% if block.settings.kicker != blank
                or block.settings.title != blank
                or block.settings.text != blank
                or block.settings.support_text != blank
              %}

                <article
                  class="iamw-lp01__card"
                  {{ block.shopify_attributes }}
                >

                  {% if block.settings.show_image_area %}

                    <div class="iamw-lp01__card-media">

                      {% if block.settings.image != blank %}

                        {{
                          block.settings.image
                          | image_url: width: 1000
                          | image_tag:
                            loading: 'lazy',
                            widths: '360,540,720,900,1000',
                            sizes: '(min-width: 990px) 33vw, 100vw',
                            class: 'iamw-lp01__image'
                        }}

                      {% else %}

                        <div class="iamw-lp01__placeholder iamw-lp01__placeholder--card">
                          <span>ADD CARD IMAGE</span>
                        </div>

                      {% endif %}

                    </div>

                  {% endif %}


                  <div class="iamw-lp01__card-content">

                    {% if block.settings.icon_image != blank %}

                      <span
                        class="iamw-lp01__card-icon-holder"
                        style="
                          width: {{ block.settings.icon_size }}px;
                          height: {{ block.settings.icon_size }}px;
                        "
                      >

                        {{
                          block.settings.icon_image
                          | image_url: width: 200
                          | image_tag:
                            loading: 'lazy',
                            class: 'iamw-lp01__icon-image'
                        }}

                      </span>

                    {% elsif block.settings.icon_svg != blank %}

                      <span
                        class="iamw-lp01__card-icon-holder iamw-lp01__svg"
                        style="
                          width: {{ block.settings.icon_size }}px;
                          height: {{ block.settings.icon_size }}px;
                        "
                      >
                        {{ block.settings.icon_svg }}
                      </span>

                    {% endif %}


                    {% if block.settings.kicker != blank %}

                      <div class="iamw-lp01__card-kicker">
                        {{ block.settings.kicker }}
                      </div>

                    {% endif %}


                    {% if block.settings.title != blank %}

                      <h3>
                        {{ block.settings.title }}
                      </h3>

                    {% endif %}


                    {% if block.settings.text != blank %}

                      <div class="iamw-lp01__rte">
                        {{ block.settings.text }}
                      </div>

                    {% endif %}


                    {% if block.settings.support_text != blank %}

                      <div class="iamw-lp01__support">
                        {{ block.settings.support_text }}
                      </div>

                    {% endif %}

                  </div>

                </article>

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>


        {% if section.settings.bottom_cta_text != blank %}

          <div class="iamw-lp01__bottom-cta">

            {% if section.settings.bottom_cta_link != blank %}

              <a
                href="{{ section.settings.bottom_cta_link }}"
                class="iamw-lp01__btn"
              >
                {{ section.settings.bottom_cta_text }}
              </a>

            {% else %}

              <div class="iamw-lp01__btn iamw-lp01__btn--disabled">
                {{ section.settings.bottom_cta_text }}
              </div>

            {% endif %}

          </div>

        {% endif %}

      </div>

    {% endif %}

  </div>

</section>


<style>

#IAMW-LP01-{{ section.id }} {
  padding:
    var(--pad-top)
    var(--pad-x)
    var(--pad-bottom);

  background:
    {{ section.settings.background }};

  color:
    var(--ink);
}


#IAMW-LP01-{{ section.id }} * {
  box-sizing: border-box;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__shell {

  width: 100%;
  max-width: var(--page-width);

  margin: 0 auto;

  display: flex;
  flex-direction: column;

  gap: var(--section-gap);
}


#IAMW-LP01-{{ section.id }} h1,
#IAMW-LP01-{{ section.id }} h2,
#IAMW-LP01-{{ section.id }} h3 {

  margin: 0;

  color:
    var(--ink);

  letter-spacing:
    -0.025em;
}


#IAMW-LP01-{{ section.id }} h1 {

  font-size:
    var(--hero-size);

  line-height:
    1.02;
}


#IAMW-LP01-{{ section.id }} h2 {

  font-size:
    var(--heading-size);

  line-height:
    1.05;
}


#IAMW-LP01-{{ section.id }} h3 {

  font-size:
    calc(var(--body-size) * 1.35);

  line-height:
    1.15;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__rte {

  font-size:
    var(--body-size);

  line-height:
    1.65;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__rte p:first-child {

  margin-top: 0;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__rte p:last-child {

  margin-bottom: 0;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__eyebrow,

#IAMW-LP01-{{ section.id }}
.iamw-lp01__card-kicker {

  color:
    var(--purple);

  font-size:
    calc(var(--body-size) * .78);

  font-weight:
    800;

  letter-spacing:
    .12em;

  line-height:
    1.35;

  text-transform:
    uppercase;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__hero,

#IAMW-LP01-{{ section.id }}
.iamw-lp01__problem {

  display:
    grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap:
    var(--section-gap);

  align-items:
    center;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__hero-copy,

#IAMW-LP01-{{ section.id }}
.iamw-lp01__problem-copy {

  display:
    flex;

  flex-direction:
    column;

  gap:
    var(--card-gap);
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__hero-media,

#IAMW-LP01-{{ section.id }}
.iamw-lp01__problem-media {

  position:
    relative;

  overflow:
    hidden;

  border-radius:
    var(--radius);

  background:
    var(--cream);
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__hero-media {

  min-height:
    540px;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__problem-media {

  min-height:
    460px;

  border:
    4px solid var(--purple);
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__image {

  width:
    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    cover;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__placeholder {

  width:
    100%;

  display:
    grid;

  place-items:
    center;

  padding:
    32px;

  text-align:
    center;

  color:
    var(--muted);

  background:
    linear-gradient(
      135deg,
      rgba(66,16,107,.04),
      rgba(255,157,22,.08)
    );

  border:
    2px dashed rgba(66,16,107,.28);

  font-size:
    calc(var(--body-size) * .88);

  font-weight:
    800;

  letter-spacing:
    .06em;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__placeholder--hero {

  min-height:
    540px;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__placeholder--problem {

  min-height:
    460px;

  border:
    0;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__placeholder--card {

  min-height:
    220px;

  border:
    0;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__benefit-float {

  position:
    absolute;

  top:
    22px;

  right:
    22px;

  width:
    min(300px, calc(100% - 44px));

  padding:
    18px;

  display:
    flex;

  flex-direction:
    column;

  gap:
    12px;

  background:
    rgba(255,255,255,.96);

  border:
    2px solid var(--orange);

  border-radius:
    calc(var(--radius) * .75);

  box-shadow:
    0 16px 44px rgba(0,0,0,.12);

  backdrop-filter:
    blur(5px);
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__benefit-item {

  display:
    flex;

  align-items:
    center;

  gap:
    10px;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__benefit-text {

  font-size:
    calc(var(--body-size) * .86);

  line-height:
    1.25;

  font-weight:
    800;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__icon-holder,

#IAMW-LP01-{{ section.id }}
.iamw-lp01__card-icon-holder {

  flex:
    0 0 auto;

  display:
    block;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__icon-image {

  width:
    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    contain;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__svg svg {

  width:
    100%;

  height:
    100%;

  display:
    block;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__btn {

  width:
    fit-content;

  min-height:
    52px;

  padding:
    14px 24px;

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  background:
    var(--orange);

  color:
    #111111;

  border-radius:
    999px;

  text-decoration:
    none;

  text-align:
    center;

  font-weight:
    800;

  line-height:
    1.2;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__btn--purple {

  background:
    var(--purple);

  color:
    #ffffff;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__btn--disabled {

  cursor:
    default;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__microcopy {

  color:
    var(--muted);

  font-size:
    calc(var(--body-size) * .88);

  line-height:
    1.5;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__trust-strip {

  width:
    100%;

  padding:
    14px 20px;

  background:
    var(--purple);

  color:
    #ffffff;

  border-radius:
    999px;

  text-align:
    center;

  font-size:
    var(--body-size);

  font-weight:
    800;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__cards-section {

  display:
    flex;

  flex-direction:
    column;

  gap:
    var(--section-gap);
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__center-head {

  max-width:
    820px;

  margin:
    0 auto;

  display:
    flex;

  flex-direction:
    column;

  gap:
    calc(var(--card-gap) * .7);

  text-align:
    center;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__card-grid {

  display:
    grid;

  grid-template-columns:
    repeat(
      {{ section.settings.desktop_columns }},
      minmax(0, 1fr)
    );

  gap:
    var(--card-gap);
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__card {

  overflow:
    hidden;

  background:
    #ffffff;

  border:
    1px solid rgba(0,0,0,.08);

  border-radius:
    var(--radius);

  box-shadow:
    0 8px 28px rgba(0,0,0,.055);
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__card-media {

  aspect-ratio:
    4 / 3;

  overflow:
    hidden;

  background:
    var(--cream);
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__card-content {

  padding:
    22px;

  display:
    flex;

  flex-direction:
    column;

  gap:
    12px;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__support {

  padding-top:
    12px;

  border-top:
    1px solid rgba(0,0,0,.08);

  color:
    var(--purple);

  font-size:
    calc(var(--body-size) * .9);

  line-height:
    1.5;

  font-weight:
    800;
}


#IAMW-LP01-{{ section.id }}
.iamw-lp01__bottom-cta {

  display:
    flex;

  justify-content:
    center;
}


@media screen and (max-width: 989px) {

  #IAMW-LP01-{{ section.id }} {

    padding-left:
      var(--pad-x-mobile);

    padding-right:
      var(--pad-x-mobile);
  }


  #IAMW-LP01-{{ section.id }} h1 {

    font-size:
      var(--hero-mobile);
  }


  #IAMW-LP01-{{ section.id }} h2 {

    font-size:
      var(--heading-mobile);
  }


  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__rte,

  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__trust-strip {

    font-size:
      var(--body-mobile);
  }


  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__hero,

  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__problem {

    grid-template-columns:
      1fr;
  }


  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__hero-media,

  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__placeholder--hero {

    min-height:
      390px;
  }


  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__problem-media,

  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__placeholder--problem {

    min-height:
      340px;
  }


  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__benefit-float {

    position:
      static;

    width:
      auto;

    margin:
      14px;
  }


  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__hero-media {

    display:
      flex;

    flex-direction:
      column;
  }


  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__trust-strip {

    border-radius:
      var(--radius);
  }


  #IAMW-LP01-{{ section.id }}
  .iamw-lp01__card-grid {

    grid-template-columns:
      1fr;
  }

}

</style>


{% schema %}

{
  "name": "IAMW LP 01 Hero + Problem",

  "settings": [

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "page_width",
      "label": "Max page width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1240,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_x",
      "label": "Desktop left/right padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_padding_x",
      "label": "Mobile left/right padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },

