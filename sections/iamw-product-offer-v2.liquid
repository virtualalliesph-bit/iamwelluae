
{{ 'iamw-brain-landing.css' | asset_url | stylesheet_tag }}
<section id="brain-product-offer" class="iamw-brain-section iamw-product-offer" style="--iamw-bg:{{ section.settings.background }};--iamw-text:{{ section.settings.text_color }};--iamw-accent:{{ section.settings.accent_color }};--iamw-radius:{{ section.settings.border_radius }}px;--iamw-content:{{ section.settings.content_width }}px;--iamw-pad-desktop:{{ section.settings.padding_desktop }}px;--iamw-pad-mobile:{{ section.settings.padding_mobile }}px;--iamw-heading-desktop:{{ section.settings.heading_size_desktop }}px;--iamw-heading-mobile:{{ section.settings.heading_size_mobile }}px;{% if section.settings.button_color != blank %}--iamw-button:{{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}--iamw-button-text:{{ section.settings.button_text_color }};{% endif %}" >
  {% assign p = section.settings.product %}
  {% if p != blank %}
    {% assign selected_variant = p.selected_or_first_available_variant %}
  {% endif %}
  <div class="iamw-brain-wrap">
    <div class="iamw-product-offer__panel iamw-brain-card">
      <div class="iamw-product-offer__content">
        {% if section.settings.eyebrow != blank %}<div class="iamw-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
        <h2 class="iamw-heading">
          {% if section.settings.custom_heading != blank %}
            {{ section.settings.custom_heading }}
          {% elsif p != blank %}
            {{ p.title }}
          {% else %}
            90 Days of Brain Support
          {% endif %}
        </h2>
        {% if p != blank %}
          <div class="iamw-product-offer__price">
            <span class="iamw-price" data-iamw-price>{{ selected_variant.price | money }}</span>
            {% if selected_variant.compare_at_price > selected_variant.price %}
              <span class="iamw-compare" data-iamw-compare>{{ selected_variant.compare_at_price | money }}</span>
            {% endif %}
          </div>
        {% endif %}
        {% if section.settings.description != blank %}<div class="iamw-copy iamw-muted">{{ section.settings.description }}</div>{% endif %}
        {% if p != blank %}
          {% if p.variants.size > 1 %}
            <label class="iamw-product-offer__label" for="iamw-offer-variant-{{ section.id }}">Choose option</label>
            <select class="iamw-select" id="iamw-offer-variant-{{ section.id }}" data-iamw-variant>
              {% for variant in p.variants %}
                <option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-compare="{{ variant.compare_at_price | money | escape }}" {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}
                </option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" data-iamw-variant value="{{ selected_variant.id }}">
          {% endif %}
          <button type="button" class="iamw-btn{% if section.settings.button_style == 'outline' %} iamw-btn--outline{% endif %} iamw-product-offer__buy" data-iamw-buy data-action="{{ section.settings.purchase_action }}" {% unless selected_variant.available %}disabled{% endunless %}>
            {{ section.settings.button_text }}
          </button>
        {% else %}
          <div class="iamw-placeholder">Select a Shopify product in this section.</div>
        {% endif %}
        <div class="iamw-proofline">
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="iamw-product-offer__media">
        {% if section.settings.custom_image != blank %}
          {{ section.settings.custom_image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600,900,1200,1500', sizes: '(min-width:768px) 50vw, 100vw', alt: section.settings.image_alt }}
        {% elsif p != blank and p.featured_image %}
          {{ p.featured_image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600,900,1200,1500', sizes: '(min-width:768px) 50vw, 100vw', alt: p.title }}
        {% else %}
          <div class="iamw-placeholder">Choose a product or custom image</div>
        {% endif %}
        {% if section.settings.badge != blank %}<div class="iamw-product-offer__badge">{{ section.settings.badge }}</div>{% endif %}
      </div>
    </div>
  </div>
</section>
<style>
#shopify-section-{{ section.id }} .iamw-product-offer__panel{display:grid;grid-template-columns:1fr}
#shopify-section-{{ section.id }} .iamw-product-offer__content{padding:28px;text-align:{{ section.settings.text_alignment }}}
#shopify-section-{{ section.id }} .iamw-product-offer__price{margin:14px 0}
#shopify-section-{{ section.id }} .iamw-product-offer__label{display:block;margin:18px 0 7px;font-size:13px;font-weight:800;text-align:left}
#shopify-section-{{ section.id }} .iamw-product-offer__buy{width:100%;margin-top:14px}
#shopify-section-{{ section.id }} .iamw-product-offer__media{position:relative;min-height:320px;background:#efe7f6;overflow:hidden}
#shopify-section-{{ section.id }} .iamw-product-offer__media img{display:block;width:100%;height:100%;min-height:320px;object-fit:cover}
#shopify-section-{{ section.id }} .iamw-product-offer__badge{position:absolute;top:18px;right:18px;width:104px;height:104px;border-radius:50%;background:#5a1aa8;color:#fff;display:grid;place-items:center;text-align:center;padding:12px;font-size:13px;font-weight:900}
#shopify-section-{{ section.id }} .iamw-product-offer__buy[disabled]{opacity:.45;cursor:not-allowed}
@media(min-width:800px){
  #shopify-section-{{ section.id }} .iamw-product-offer__panel{grid-template-columns:minmax(0,1fr) minmax(0,.9fr)}
  #shopify-section-{{ section.id }} .iamw-product-offer__content{padding:44px}
  #shopify-section-{{ section.id }} .iamw-product-offer__media img{min-height:460px}
}
</style>
<script>
(() => {
  const root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root || root.dataset.iamwOfferReady === 'true') return;
  root.dataset.iamwOfferReady = 'true';
  const select = root.querySelector('select[data-iamw-variant]');
  if (select) {
    select.addEventListener('change', () => {
      const opt = select.options[select.selectedIndex];
      const price = root.querySelector('[data-iamw-price]');
      const compare = root.querySelector('[data-iamw-compare]');
      if (price && opt.dataset.price) price.textContent = opt.dataset.price;
      if (compare) {
        compare.textContent = opt.dataset.compare || '';
        compare.style.display = opt.dataset.compare && opt.dataset.compare !== opt.dataset.price ? '' : 'none';
      }
    });
  }
  const button = root.querySelector('[data-iamw-buy]');
  if (button) {
    button.addEventListener('click', async () => {
      const field = root.querySelector('[data-iamw-variant]');
      if (!field || !field.value) return;
      const original = button.textContent;
      button.disabled = true;
      button.textContent = '{{ section.settings.loading_text | escape }}';
      try {
        const base = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
        const res = await fetch(base + 'cart/add.js', {
          method:'POST',
          headers:{'Content-Type':'application/json','Accept':'application/json'},
          body:JSON.stringify({items:[{id:Number(field.value),quantity:1}]})
        });
        if (!res.ok) throw new Error('Unable to add item');
        window.location.assign(button.dataset.action === 'checkout' ? '/checkout' : '/cart');
      } catch (e) {
        button.disabled = false;
        button.textContent = original;
        alert('Please try again.');
      }
    });
  }
})();
</script>

{% schema %}
{
