<script>

document.addEventListener('DOMContentLoaded', function() {

  const section =
    document.getElementById('IAMW-LP03-{{ section.id }}');

  if (!section) return;


  const tabs =
    section.querySelector('[data-iamw-tabs]');

  if (tabs) {

    const buttons =
      tabs.querySelectorAll('[data-iamw-tab-button]');

    const panels =
      tabs.querySelectorAll('[data-iamw-tab-panel]');


    buttons.forEach(function(button) {

      button.addEventListener('click', function() {

        const target =
          button.getAttribute('data-iamw-tab-button');


        buttons.forEach(function(btn) {

          btn.classList.remove('is-active');

          btn.setAttribute(
            'aria-selected',
            'false'
          );

        });


        panels.forEach(function(panel) {

          panel.classList.remove('is-active');

        });


        button.classList.add('is-active');

        button.setAttribute(
          'aria-selected',
          'true'
        );


        const activePanel =
          tabs.querySelector(
            '[data-iamw-tab-panel="' +
            target +
            '"]'
          );


        if (activePanel) {

          activePanel.classList.add(
            'is-active'
          );

        }

      });

    });

  }


  const variantSelect =
    section.querySelector(
      '[data-iamw-variant-select]'
    );


  if (variantSelect) {

    const form =
      section.querySelector(
        '.iamw-lp03__form'
      );

    const hiddenInput =
      form
        ? form.querySelector(
            'input[name="id"]'
          )
        : null;


    variantSelect.addEventListener(
      'change',
      function() {

        if (hiddenInput) {

          hiddenInput.value =
            variantSelect.value;

        }

      }
    );

  }

});

</script>


