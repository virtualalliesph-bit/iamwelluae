{% comment %}
  I AM WELL SMART GUMMIES
  LANDING PAGE SECTION 03
  Product Purchase Module + Tabs
{% endcomment %}

{% assign selected_product = section.settings.product %}

{% if selected_product != blank %}
  {% assign current_variant = selected_product.selected_or_first_available_variant %}
{% endif %}

<section
  id="IAMW-LP03-{{ section.id }}"
  class="iamw-lp03"
  data-iamw-product-section
  style="
    --page-width: {{ section.settings.page_width }}px;
    --pad-x: {{ section.settings.padding_x }}px;
    --pad-x-mobile: {{ section.settings.mobile_padding_x }}px;
    --pad-top: {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;
    --section-gap: {{ section.settings.section_gap }}px;
    --inner-gap: {{ section.settings.inner_gap }}px;
    --radius: {{ section.settings.radius }}px;

    --purple: {{ section.settings.purple }};
    --orange: {{ section.settings.orange }};
    --cream: {{ section.settings.cream }};
    --soft-bg: {{ section.settings.soft_background }};
    --ink: {{ section.settings.ink }};
    --muted: {{ section.settings.muted }};

    --heading-size: {{ section.settings.heading_size }}px;
    --product-title-size: {{ section.settings.product_title_size }}px;
    --body-size: {{ section.settings.body_size }}px;

    --heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --product-title-mobile: {{ section.settings.mobile_product_title_size }}px;
    --body-mobile: {{ section.settings.mobile_body_size }}px;
  "
>

  <div class="iamw-lp03__shell">

    {% comment %}
      OPTIONAL SECTION HEADER
    {% endcomment %}

    {% if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.intro != blank
    %}

      <div class="iamw-lp03__section-head">

        {% if section.settings.eyebrow != blank %}
          <div class="iamw-lp03__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="iamw-lp03__section-title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="iamw-lp03__rte iamw-lp03__section-intro">
            {{ section.settings.intro }}
          </div>
        {% endif %}

      </div>

    {% endif %}


    {% comment %}
      MAIN PRODUCT PURCHASE MODULE
    {% endcomment %}

    <div class="iamw-lp03__product">

      <div class="iamw-lp03__product-media">

        {% if selected_product != blank and selected_product.featured_image != blank %}

          {{
            selected_product.featured_image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              widths: '480,720,960,1200,1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'iamw-lp03__product-image'
          }}

        {% elsif section.settings.fallback_product_image != blank %}

          {{
            section.settings.fallback_product_image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              widths: '480,720,960,1200,1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'iamw-lp03__product-image'
          }}

        {% else %}

          <div class="iamw-lp03__placeholder iamw-lp03__placeholder--product">
            <span>ADD / SELECT PRODUCT IMAGE</span>
          </div>

        {% endif %}

      </div>


      <div class="iamw-lp03__product-copy">

        {% if section.settings.product_badge != blank %}
          <div class="iamw-lp03__badge">
            {{ section.settings.product_badge }}
          </div>
        {% endif %}


        {% if section.settings.custom_product_title != blank %}

          <h2 class="iamw-lp03__product-title">
            {{ section.settings.custom_product_title }}
          </h2>

        {% elsif selected_product != blank %}

          <h2 class="iamw-lp03__product-title">
            {{ selected_product.title }}
          </h2>

        {% else %}

          <h2 class="iamw-lp03__product-title">
            I Am Well Smart Gummies
          </h2>

        {% endif %}


        {% if section.settings.product_subtitle != blank %}
          <div class="iamw-lp03__product-subtitle">
            {{ section.settings.product_subtitle }}
          </div>
        {% endif %}


        {% if section.settings.product_description != blank %}
          <div class="iamw-lp03__rte">
            {{ section.settings.product_description }}
          </div>
        {% endif %}


        {% if selected_product != blank %}

          <div class="iamw-lp03__price-wrap">

            {% if current_variant.compare_at_price > current_variant.price %}

              <span class="iamw-lp03__compare-price">
                {{ current_variant.compare_at_price | money }}
              </span>

            {% endif %}

            <span class="iamw-lp03__price">
              {{ current_variant.price | money }}
            </span>

          </div>

        {% elsif section.settings.manual_price != blank %}

          <div class="iamw-lp03__price-wrap">
            <span class="iamw-lp03__price">
              {{ section.settings.manual_price }}
            </span>
          </div>

        {% endif %}


        {% if section.settings.offer_text != blank %}

          <div class="iamw-lp03__offer-box">
            {{ section.settings.offer_text }}
          </div>

        {% endif %}


        {% comment %}
          TRUST / BENEFIT ICONS
        {% endcomment %}

        {% assign has_trust_items = false %}

        {% for block in section.blocks %}

          {% if block.type == 'trust_item' %}

            {% if block.settings.title != blank or block.settings.text != blank %}
              {% assign has_trust_items = true %}
            {% endif %}

          {% endif %}

        {% endfor %}


        {% if has_trust_items %}

          <div class="iamw-lp03__trust-grid">

            {% for block in section.blocks %}

              {% if block.type == 'trust_item' %}

                {% if block.settings.title != blank or block.settings.text != blank %}

                  <div
                    class="iamw-lp03__trust-item"
                    {{ block.shopify_attributes }}
                  >

                    {% if block.settings.icon_image != blank %}

                      <span
                        class="iamw-lp03__trust-icon"
                        style="
                          width: {{ block.settings.icon_size }}px;
                          height: {{ block.settings.icon_size }}px;
                        "
                      >

                        {{
                          block.settings.icon_image
                          | image_url: width: 180
                          | image_tag:
                            loading: 'lazy',
                            class: 'iamw-lp03__icon-image'
                        }}

                      </span>

                    {% elsif block.settings.icon_svg != blank %}

                      <span
                        class="iamw-lp03__trust-icon iamw-lp03__svg"
                        style="
                          width: {{ block.settings.icon_size }}px;
                          height: {{ block.settings.icon_size }}px;
                        "
                      >
                        {{ block.settings.icon_svg }}
                      </span>

                    {% endif %}


                    <div class="iamw-lp03__trust-copy">

                      {% if block.settings.title != blank %}
                        <strong>
                          {{ block.settings.title }}
                        </strong>
                      {% endif %}

                      {% if block.settings.text != blank %}
                        <span>
                          {{ block.settings.text }}
                        </span>
                      {% endif %}

                    </div>

                  </div>

                {% endif %}

              {% endif %}

            {% endfor %}

          </div>

        {% endif %}


        {% comment %}
          PRODUCT FORM
        {% endcomment %}

        {% if selected_product != blank %}

         {% assign iamw_product_form_id = 'IAMWProductForm-' | append: section.id %}

{% form 'product',
  selected_product,
  id: iamw_product_form_id,
  class: 'iamw-lp03__form'
%}

            <input
              type="hidden"
              name="id"
              value="{{ current_variant.id }}"
            >


            {% if selected_product.variants.size > 1 %}

              <div class="iamw-lp03__variant-field">

                <label for="IAMWVariant-{{ section.id }}">
                  Choose option
                </label>

                <select
                  id="IAMWVariant-{{ section.id }}"
                  class="iamw-lp03__variant-select"
                  data-iamw-variant-select
                >

                  {% for variant in selected_product.variants %}

                    <option
                      value="{{ variant.id }}"
                      data-price="{{ variant.price | money }}"
                      data-compare-price="{{ variant.compare_at_price | money }}"
                      {% if variant.id == current_variant.id %}
                        selected
                      {% endif %}
                      {% unless variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {{ variant.title }}

                      {% unless variant.available %}
                        — Sold out
                      {% endunless %}

                    </option>

                  {% endfor %}

                </select>

              </div>

            {% endif %}


            <button
              type="submit"
              name="add"
              class="iamw-lp03__add-button"
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >

              {% if current_variant.available %}

                {% if section.settings.add_to_cart_text != blank %}
                  {{ section.settings.add_to_cart_text }}
                {% else %}
                  ADD TO CART
                {% endif %}

              {% else %}

                SOLD OUT

              {% endif %}

            </button>

          {% endform %}

        {% elsif section.settings.manual_cta_text != blank %}

          {% if section.settings.manual_cta_link != blank %}

            <a
              href="{{ section.settings.manual_cta_link }}"
              class="iamw-lp03__add-button"
            >
              {{ section.settings.manual_cta_text }}
            </a>

          {% else %}

            <div class="iamw-lp03__add-button iamw-lp03__disabled">
              {{ section.settings.manual_cta_text }}
            </div>

          {% endif %}

        {% endif %}


        {% if section.settings.checkout_microcopy != blank %}
          <div class="iamw-lp03__checkout-microcopy">
            {{ section.settings.checkout_microcopy }}
          </div>
        {% endif %}

      </div>

    </div>


    {% comment %}
      CLICKABLE TABS
    {% endcomment %}

    {% assign has_tabs = false %}

    {% for block in section.blocks %}

      {% if block.type == 'product_tab' %}

        {% if block.settings.title != blank %}
          {% assign has_tabs = true %}
        {% endif %}

      {% endif %}

    {% endfor %}


    {% if has_tabs %}

      <div
        class="iamw-lp03__tabs"
        data-iamw-tabs
      >

        <div
          class="iamw-lp03__tab-buttons"
          role="tablist"
        >

          {% assign tab_index = 0 %}

          {% for block in section.blocks %}

            {% if block.type == 'product_tab' %}

              {% if block.settings.title != blank %}

                <button
                  type="button"
                  class="iamw-lp03__tab-button {% if tab_index == 0 %}is-active{% endif %}"
                  data-iamw-tab-button="{{ block.id }}"
                  role="tab"
                  aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                >
                  {{ block.settings.title }}
                </button>

                {% assign tab_index = tab_index | plus: 1 %}

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>


        <div class="iamw-lp03__tab-panels">

          {% assign panel_index = 0 %}

          {% for block in section.blocks %}

            {% if block.type == 'product_tab' %}

              {% if block.settings.title != blank %}

                <div
                  class="iamw-lp03__tab-panel {% if panel_index == 0 %}is-active{% endif %}"
                  data-iamw-tab-panel="{{ block.id }}"
                  role="tabpanel"
                  {{ block.shopify_attributes }}
                >

                  <div
                    class="
                      iamw-lp03__tab-panel-inner
                      {% unless block.settings.show_image_area %}
                        iamw-lp03__tab-panel-inner--text-only
                      {% endunless %}
                    "
                  >

                    {% if block.settings.show_image_area %}

                      <div class="iamw-lp03__tab-media">

                        {% if block.settings.image != blank %}

                          {{
                            block.settings.image
                            | image_url: width: 1100
                            | image_tag:
                              loading: 'lazy',
                              widths: '400,600,800,1100',
                              sizes: '(min-width: 990px) 38vw, 100vw',
                              class: 'iamw-lp03__tab-image'
                          }}

                        {% else %}

                          <div class="iamw-lp03__placeholder iamw-lp03__placeholder--tab">
                            <span>ADD TAB IMAGE</span>
                          </div>

                        {% endif %}

                      </div>

                    {% endif %}


                    <div class="iamw-lp03__tab-copy">

                      {% if block.settings.eyebrow != blank %}
                        <div class="iamw-lp03__eyebrow">
                          {{ block.settings.eyebrow }}
                        </div>
                      {% endif %}

                      {% if block.settings.heading != blank %}
                        <h3>
                          {{ block.settings.heading }}
                        </h3>
                      {% endif %}

                      {% if block.settings.content != blank %}
                        <div class="iamw-lp03__rte">
                          {{ block.settings.content }}
                        </div>
                      {% endif %}

                    </div>

                  </div>

                </div>

                {% assign panel_index = panel_index | plus: 1 %}

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>

      </div>

    {% endif %}


    {% if section.settings.bottom_note != blank %}

      <div class="iamw-lp03__bottom-note">
        {{ section.settings.bottom_note }}
      </div>

    {% endif %}

  </div>

</section>


<style>

#IAMW-LP03-{{ section.id }} {
  padding:
    var(--pad-top)
    var(--pad-x)
    var(--pad-bottom);

  background:
    {{ section.settings.background }};

  color:
    var(--ink);
}


#IAMW-LP03-{{ section.id }} * {
  box-sizing:
    border-box;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__shell {

  width:
    100%;

  max-width:
    var(--page-width);

  margin:
    0 auto;

  display:
    flex;

  flex-direction:
    column;

  gap:
    var(--section-gap);
}


#IAMW-LP03-{{ section.id }} h2,
#IAMW-LP03-{{ section.id }} h3 {

  margin:
    0;

  color:
    var(--ink);

  letter-spacing:
    -0.025em;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__section-title {

  font-size:
    var(--heading-size);

  line-height:
    1.05;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__product-title {

  font-size:
    var(--product-title-size);

  line-height:
    1.03;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__tab-copy h3 {

  font-size:
    calc(var(--body-size) * 1.6);

  line-height:
    1.1;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__rte {

  font-size:
    var(--body-size);

  line-height:
    1.65;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__rte p:first-child {

  margin-top:
    0;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__rte p:last-child {

  margin-bottom:
    0;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__section-head {

  max-width:
    820px;

  margin:
    0 auto;

  display:
    flex;

  flex-direction:
    column;

  gap:
    calc(var(--inner-gap) * .7);

  text-align:
    center;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__eyebrow {

  color:
    var(--purple);

  font-size:
    calc(var(--body-size) * .78);

  font-weight:
    800;

  letter-spacing:
    .12em;

  line-height:
    1.35;

  text-transform:
    uppercase;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__product {

  display:
    grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(0,1fr);

  gap:
    var(--section-gap);

  align-items:
    stretch;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__product-media {

  min-height:
    580px;

  overflow:
    hidden;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  background:
    var(--cream);

  border-radius:
    var(--radius);
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__product-image {

  width:
    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    contain;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__product-copy {

  padding:
    clamp(24px, 4vw, 50px);

  display:
    flex;

  flex-direction:
    column;

  justify-content:
    center;

  gap:
    var(--inner-gap);

  background:
    #ffffff;

  border:
    1px solid rgba(0,0,0,.08);

  border-radius:
    var(--radius);

  box-shadow:
    0 12px 40px rgba(0,0,0,.055);
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__badge {

  width:
    fit-content;

  padding:
    7px 12px;

  background:
    var(--orange);

  color:
    #111111;

  border-radius:
    999px;

  font-size:
    calc(var(--body-size) * .76);

  font-weight:
    900;

  letter-spacing:
    .08em;

  text-transform:
    uppercase;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__product-subtitle {

  color:
    var(--muted);

  font-size:
    calc(var(--body-size) * 1.02);

  line-height:
    1.5;

  font-weight:
    700;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__price-wrap {

  display:
    flex;

  align-items:
    center;

  flex-wrap:
    wrap;

  gap:
    10px;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__price {

  color:
    var(--purple);

  font-size:
    calc(var(--product-title-size) * .72);

  font-weight:
    900;

  line-height:
    1;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__compare-price {

  color:
    var(--muted);

  font-size:
    calc(var(--body-size) * 1.15);

  text-decoration:
    line-through;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__offer-box {

  padding:
    14px 16px;

  background:
    var(--cream);

  border-left:
    4px solid var(--orange);

  border-radius:
    calc(var(--radius) * .55);

  font-size:
    var(--body-size);

  line-height:
    1.5;

  font-weight:
    800;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__trust-grid {

  display:
    grid;

  grid-template-columns:
    repeat(2, minmax(0,1fr));

  gap:
    12px;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__trust-item {

  padding:
    12px;

  display:
    flex;

  align-items:
    center;

  gap:
    10px;

  background:
    var(--soft-bg);

  border-radius:
    calc(var(--radius) * .6);
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__trust-icon {

  flex:
    0 0 auto;

  display:
    block;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__icon-image {

  width:
    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    contain;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__svg svg {

  width:
    100%;

  height:
    100%;

  display:
    block;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__trust-copy {

  display:
    flex;

  flex-direction:
    column;

  gap:
    2px;

  font-size:
    calc(var(--body-size) * .84);

  line-height:
    1.35;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__trust-copy strong {

  font-weight:
    900;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__form {

  display:
    flex;

  flex-direction:
    column;

  gap:
    14px;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__variant-field {

  display:
    flex;

  flex-direction:
    column;

  gap:
    7px;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__variant-field label {

  font-size:
    calc(var(--body-size) * .88);

  font-weight:
    800;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__variant-select {

  width:
    100%;

  min-height:
    50px;

  padding:
    10px 14px;

  border:
    1px solid rgba(0,0,0,.18);

  border-radius:
    10px;

  background:
    #ffffff;

  color:
    var(--ink);

  font-size:
    var(--body-size);
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__add-button {

  width:
    100%;

  min-height:
    56px;

  padding:
    15px 22px;

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  background:
    var(--orange);

  color:
    #111111;

  border:
    0;

  border-radius:
    999px;

  text-decoration:
    none;

  text-align:
    center;

  font-size:
    calc(var(--body-size) * 1.02);

  font-weight:
    900;

  cursor:
    pointer;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__add-button:disabled {

  opacity:
    .5;

  cursor:
    not-allowed;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__checkout-microcopy {

  color:
    var(--muted);

  font-size:
    calc(var(--body-size) * .82);

  line-height:
    1.5;

  text-align:
    center;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__placeholder {

  width:
    100%;

  display:
    grid;

  place-items:
    center;

  padding:
    32px;

  color:
    var(--muted);

  background:
    linear-gradient(
      135deg,
      rgba(66,16,107,.04),
      rgba(255,157,22,.08)
    );

  border:
    2px dashed rgba(66,16,107,.28);

  text-align:
    center;

  font-size:
    calc(var(--body-size) * .88);

  font-weight:
    800;

  letter-spacing:
    .06em;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__placeholder--product {

  min-height:
    580px;

  border:
    0;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__tabs {

  overflow:
    hidden;

  background:
    #ffffff;

  border:
    1px solid rgba(0,0,0,.08);

  border-radius:
    var(--radius);
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__tab-buttons {

  display:
    flex;

  overflow-x:
    auto;

  border-bottom:
    1px solid rgba(0,0,0,.08);

  scrollbar-width:
    none;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__tab-buttons::-webkit-scrollbar {

  display:
    none;
}


#IAMW-LP03-{{ section.id }}
.iamw-lp03__tab-button {

  flex:
    1 0 auto;

  min-width:
    150px;

  padding:
    18px 22px;

  border:
    0;

  border-bottom:
    3px solid transparent;

  background:
    transparent;

  color:
    var(--muted);

  font-size:
    var(--body-size);

  font-weight:
    800;

  cursor:
