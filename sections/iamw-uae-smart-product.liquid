{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign hero_media = current_variant.featured_media | default: product.featured_media
  assign main_image_id = 'iamw-main-image-' | append: section.id
  assign box_product = all_products[section.settings.box_product_handle]
  assign box_variant = nil
  if box_product != blank
    assign box_variant = box_product.selected_or_first_available_variant
  endif
  assign box_image = section.settings.box_image
  if box_image == blank and box_product != blank
    assign box_image = box_product.featured_image
  endif
%}

<section id="iamw-uae-product-{{ section.id }}" class="iamw-uae-product">
  <div class="iamw-shell iamw-hero">
    <div class="iamw-gallery">
      <div class="iamw-main-media">
        {% if hero_media != blank and hero_media.preview_image != blank %}
          {{ hero_media.preview_image | image_url: width: 1400 | image_tag: id: main_image_id, loading: 'eager', widths: '480, 720, 960, 1200, 1400', alt: product.title }}
        {% elsif product.featured_image != blank %}
          {{ product.featured_image | image_url: width: 1400 | image_tag: id: main_image_id, loading: 'eager', widths: '480, 720, 960, 1200, 1400', alt: product.title }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'iamw-placeholder' }}
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="iamw-thumbs" role="list" aria-label="Product media">
          {% for media in product.media limit: 7 %}
            {% if media.preview_image != blank %}
              <button class="iamw-thumb{% if hero_media and media.id == hero_media.id %} is-active{% endif %}" type="button" data-image="{{ media.preview_image | image_url: width: 1400 }}" aria-label="View image {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.title }}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="iamw-details">
      {% if section.settings.eyebrow != blank %}<div class="iamw-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      <h1>{{ product.title }}</h1>
      {% if section.settings.subtitle != blank %}<div class="iamw-subtitle">{{ section.settings.subtitle }}</div>{% endif %}
      <div class="iamw-rating"><span aria-hidden="true">★★★★★</span><strong>{{ section.settings.rating_value }}</strong> <small>({{ section.settings.review_count }} reviews)</small></div>

      <div class="iamw-price-row">
        <span id="iamw-price-{{ section.id }}" class="iamw-price">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="iamw-compare">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>

      {% if product.variants.size > 1 %}
        <label class="iamw-variant-label" for="iamw-variant-{{ section.id }}">Choose option</label>
        <select id="iamw-variant-{{ section.id }}" class="iamw-variant-select">
          {% for variant in product.variants %}
            <option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
              {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input id="iamw-variant-{{ section.id }}" type="hidden" value="{{ current_variant.id }}">
      {% endif %}

      <ul class="iamw-benefit-list">
        <li>Supports focus, memory and everyday learning</li>
        <li>Helps support a healthy appetite and growth</li>
        <li>With essential vitamins and minerals</li>
        <li>Great-tasting gummies kids can enjoy</li>
        <li>90-day routine support</li>
      </ul>

      <button id="iamw-buy-now-{{ section.id }}" class="iamw-buy-now" type="button" {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}BUY NOW <span>→</span>{% else %}SOLD OUT{% endif %}
      </button>

      <div class="iamw-trust-row">
        <div><span>▣</span><small>Free UAE delivery<br>over AED 150</small></div>
        <div><span>◇</span><small>Secure<br>payment</small></div>
        <div><span>↻</span><small>Easy returns<br>within 14 days</small></div>
      </div>
    </div>
  </div>

  <section class="iamw-band iamw-brain">
    <div class="iamw-shell">
      <p class="iamw-kicker">SMART NUTRITION FOR BRIGHTER TOMORROWS</p>
      <h2>How Smart Gummies Support Brain Development</h2>
      <p class="iamw-section-intro">A complete blend of key nutrients to help support your child’s daily routine, learning, growth and wellbeing.</p>
      <div class="iamw-benefit-grid">
        <article><div class="iamw-icon">🧠</div><h3>Improves Focus & Attention</h3><p>Key nutrients such as DHA and Zinc help support focus, attention and learning.</p></article>
        <article><div class="iamw-icon">💡</div><h3>Supports Memory & Learning</h3><p>Nutrition designed to support normal brain and nervous system function.</p></article>
        <article><div class="iamw-icon">📈</div><h3>Supports Healthy Growth</h3><p>Essential vitamins and minerals help support normal growth and development.</p></article>
        <article><div class="iamw-icon">♡</div><h3>Supports Appetite Naturally</h3><p>With L-Lysine and selected nutrients to complement a balanced diet.</p></article>
        <article><div class="iamw-icon">◇</div><h3>Daily Nutritional Support</h3><p>A convenient daily blend of vitamins and minerals for growing kids.</p></article>
      </div>
    </div>
  </section>

  <section class="iamw-shell iamw-stories">
    <p class="iamw-kicker">REAL FAMILIES • REAL ROUTINES</p>
    <h2>Little smiles, shared by real moms 💜</h2>
    <p class="iamw-section-intro">Text-based parent feedback for the UAE store — no Messenger screenshots.</p>
    <div class="iamw-story-grid">
      {% assign story_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'story' %}
          {% assign story_count = story_count | plus: 1 %}
          <article class="iamw-story-card" {{ block.shopify_attributes }}>
            <div class="iamw-story-photo">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {% else %}
                <div class="iamw-photo-placeholder"><span>♥</span><small>Add lifestyle photo</small></div>
              {% endif %}
            </div>
            <div class="iamw-story-copy"><p>“{{ block.settings.quote }}”</p><div class="iamw-stars">★★★★★</div><strong>{{ block.settings.name }}</strong><small>{{ block.settings.location }}</small></div>
          </article>
        {% endif %}
      {% endfor %}
      {% if story_count == 0 %}
        <article class="iamw-story-card"><div class="iamw-story-photo"><div class="iamw-photo-placeholder"><span>♥</span><small>Add lifestyle photo</small></div></div><div class="iamw-story-copy"><p>“My child actually looks forward to taking these every morning.”</p><div class="iamw-stars">★★★★★</div><strong>Aisha</strong><small>Dubai</small></div></article>
        <article class="iamw-story-card"><div class="iamw-story-photo"><div class="iamw-photo-placeholder"><span>♥</span><small>Add lifestyle photo</small></div></div><div class="iamw-story-copy"><p>“A simple daily routine that really works for our family.”</p><div class="iamw-stars">★★★★★</div><strong>Fatima</strong><small>Abu Dhabi</small></div></article>
        <article class="iamw-story-card"><div class="iamw-story-photo"><div class="iamw-photo-placeholder"><span>♥</span><small>Add lifestyle photo</small></div></div><div class="iamw-story-copy"><p>“Great taste and so easy to include in our routine.”</p><div class="iamw-stars">★★★★★</div><strong>Sara</strong><small>Sharjah</small></div></article>
      {% endif %}
    </div>
  </section>

  <section class="iamw-band iamw-appetite">
    <div class="iamw-shell">
      <h2>Supports Appetite Naturally</h2>
      <p class="iamw-section-intro">Help your little one enjoy food, grow stronger and get the nutrients they need.</p>
      <div class="iamw-appetite-grid">
        <article><div class="iamw-icon">🍴</div><h3>Encourages Healthy Appetite</h3><p>L-Lysine and essential nutrients help support normal appetite.</p></article>
        <article><div class="iamw-icon">🛡</div><h3>Supports Healthy Growth</h3><p>Helps complement a balanced diet for steady growth and development.</p></article>
        <article><div class="iamw-icon">🌿</div><h3>Everyday Nutrition</h3><p>Selected vitamins and minerals help fill everyday nutritional gaps.</p></article>
        <article><div class="iamw-icon">⚡</div><h3>Energy for Play</h3><p>Supports normal energy metabolism for active growing children.</p></article>
      </div>
    </div>
  </section>

  <section class="iamw-shell iamw-parent-reviews">
    <p class="iamw-kicker">PARENT APPROVED</p>
    <h2>Real routines. Real feedback. Real Smart Gummies families.</h2>
    <div class="iamw-review-grid">
      {% assign review_block_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          {% assign review_block_count = review_block_count | plus: 1 %}
          <article class="iamw-review-card" {{ block.shopify_attributes }}><div class="iamw-stars">★★★★★</div><p>“{{ block.settings.quote }}”</p><strong>{{ block.settings.name }}</strong><small>{{ block.settings.location }}</small></article>
        {% endif %}
      {% endfor %}
      {% if review_block_count == 0 %}
        <article class="iamw-review-card"><div class="iamw-stars">★★★★★</div><p>“My son is more consistent with his routine, and he enjoys the taste.”</p><strong>Reem K.</strong><small>Dubai</small></article>
        <article class="iamw-review-card"><div class="iamw-stars">★★★★★</div><p>“No fuss every morning. This has become an easy part of our daily routine.”</p><strong>Layla M.</strong><small>Abu Dhabi</small></article>
        <article class="iamw-review-card"><div class="iamw-stars">★★★★★</div><p>“Finally a supplement my kids actually enjoy taking.”</p><strong>Fatima A.</strong><small>Sharjah</small></article>
        <article class="iamw-review-card"><div class="iamw-stars">★★★★★</div><p>“Great taste, simple routine, and the kids are happy with it.”</p><strong>Omar S.</strong><small>Ajman</small></article>
      {% endif %}
    </div>
  </section>

  <section class="iamw-ingredients-band">
    <div class="iamw-shell iamw-ingredient-grid">
      <article class="iamw-ingredient-panel iamw-ingredient-left">
        {% if section.settings.formula_image != blank %}
          {{ section.settings.formula_image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: 'New look, better formula' }}
        {% else %}
          <p class="iamw-kicker">SAME TRUSTED GOODNESS</p><h2>New look.<br>Better formula.</h2><div class="iamw-bottle-placeholder">SMART<br>GUMMIES</div><span class="iamw-badge">NEW & IMPROVED</span>
        {% endif %}
      </article>
      <article class="iamw-ingredient-panel iamw-ingredient-right">
        {% if section.settings.ingredients_image != blank %}
          {{ section.settings.ingredients_image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: 'What is inside Smart Gummies' }}
        {% else %}
          <h2>What’s inside<br><span>SMART GUMMIES?</span></h2>
          <div class="iamw-nutrients"><div><b>DHA</b><small>Brain development support</small></div><div><b>L-Lysine</b><small>Appetite support</small></div><div><b>Zinc</b><small>Immune support</small></div><div><b>Lutein</b><small>Eye health support</small></div><div><b>Vitamins & Minerals</b><small>Daily nutrition support</small></div></div>
        {% endif %}
      </article>
    </div>
  </section>

  <section class="iamw-shell iamw-reviews-summary">
    <h2>Customer Reviews</h2>
    <div class="iamw-summary-row">
      <div class="iamw-summary-score"><strong>{{ section.settings.rating_value }}</strong><div class="iamw-stars">★★★★★</div><small>Based on {{ section.settings.review_count }} reviews</small></div>
      <div class="iamw-bars">
        <div><span>5 ★</span><i style="--w:100%"></i><small>{{ section.settings.review_count }}</small></div>
        <div><span>4 ★</span><i style="--w:0%"></i><small>0</small></div>
        <div><span>3 ★</span><i style="--w:0%"></i><small>0</small></div>
        <div><span>2 ★</span><i style="--w:0%"></i><small>0</small></div>
        <div><span>1 ★</span><i style="--w:0%"></i><small>0</small></div>
      </div>
    </div>
  </section>

  <section class="iamw-band iamw-faq-band">
    <div class="iamw-shell iamw-faq-grid">
      <div class="iamw-faq-visual">
        {% if section.settings.faq_image != blank %}
          {{ section.settings.faq_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: 'Healthy kids, happier tomorrows' }}
        {% else %}
          <div class="iamw-faq-placeholder"><span>♡ ☀</span><strong>Healthy Kids<br>Happier Tomorrows</strong></div>
        {% endif %}
      </div>
      <div class="iamw-faq-list">
        <h2>Frequently Asked Questions</h2>
        {% assign faq_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            {% assign faq_count = faq_count | plus: 1 %}
            <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<span>+</span></summary><div>{{ block.settings.answer }}</div></details>
          {% endif %}
        {% endfor %}
        {% if faq_count == 0 %}
          <details><summary>What age is Smart Gummies suitable for?<span>+</span></summary><div>Please follow the product label directions and consult your child’s healthcare professional if you have specific concerns.</div></details>
          <details><summary>When should my child take Smart Gummies?<span>+</span></summary><div>Follow the directions on the product label. Many families include the gummies as part of a consistent daily routine.</div></details>
          <details><summary>Are there any allergens in Smart Gummies?<span>+</span></summary><div>Please check the complete ingredient and allergen information on the product label before use.</div></details>
          <details><summary>Can Smart Gummies help with picky eaters?<span>+</span></summary><div>Smart Gummies is designed to complement a balanced diet and help provide selected nutrients that may be harder to obtain with a limited diet.</div></details>
          <details><summary>How can I place an order in the UAE?<span>+</span></summary><div>Select your preferred product option, choose Buy Now, confirm whether you would like to add a box, then complete checkout.</div></details>
        {% endif %}
      </div>
    </div>
  </section>

  <div id="iamw-box-overlay-{{ section.id }}" class="iamw-box-overlay" aria-hidden="true">
    <div class="iamw-box-modal" role="dialog" aria-modal="true" aria-labelledby="iamw-box-title-{{ section.id }}">
      <button id="iamw-box-close-{{ section.id }}" type="button" class="iamw-box-close" aria-label="Close">×</button>
      <h2 id="iamw-box-title-{{ section.id }}">{{ section.settings.popup_heading }}</h2>
      <div class="iamw-box-art">
        {% if box_image != blank %}
          {{ box_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: section.settings.popup_heading }}
        {% else %}
          <div class="iamw-box-placeholder">iamwell<br><small>Gift Box</small></div>
        {% endif %}
      </div>
      <p>{{ section.settings.popup_text }}</p>
      {% if box_variant != blank %}<div class="iamw-box-price">{{ box_variant.price | money }}</div>{% endif %}
      <div id="iamw-box-error-{{ section.id }}" class="iamw-box-error" hidden></div>
      <button id="iamw-box-yes-{{ section.id }}" type="button" class="iamw-box-primary" {% if box_variant == blank or box_variant.available == false %}disabled{% endif %}>
        {% if box_variant != blank and box_variant.available %}{{ section.settings.popup_yes }}{% else %}Box currently unavailable{% endif %}
      </button>
      <button id="iamw-box-no-{{ section.id }}" type="button" class="iamw-box-secondary">{{ section.settings.popup_no }}</button>
    </div>
  </div>
</section>

<style>
  #iamw-uae-product-{{ section.id }}{--purple:#42106b;--purple2:#5e1aa4;--lilac:#f6effd;--orange:#ff9418;--ink:#181126;--muted:#70677d;--line:#e9dff2;font-family:inherit;color:var(--ink);overflow:hidden}
  #iamw-uae-product-{{ section.id }} *{box-sizing:border-box}
  #iamw-uae-product-{{ section.id }} .iamw-shell{max-width:1240px;margin:0 auto;padding-left:24px;padding-right:24px}
  #iamw-uae-product-{{ section.id }} h1,#iamw-uae-product-{{ section.id }} h2,#iamw-uae-product-{{ section.id }} h3{color:#1d1150;margin-top:0}
  #iamw-uae-product-{{ section.id }} .iamw-hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr);gap:54px;padding-top:42px;padding-bottom:64px;align-items:start}
  #iamw-uae-product-{{ section.id }} .iamw-main-media{border-radius:18px;overflow:hidden;background:#f5ecff;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center}
  #iamw-uae-product-{{ section.id }} .iamw-main-media img{width:100%;height:100%;object-fit:cover;display:block}
  #iamw-uae-product-{{ section.id }} .iamw-placeholder{width:70%;height:70%}
  #iamw-uae-product-{{ section.id }} .iamw-thumbs{display:flex;gap:10px;margin-top:14px;overflow:auto;padding:2px}
  #iamw-uae-product-{{ section.id }} .iamw-thumb{flex:0 0 72px;width:72px;height:72px;padding:0;border:2px solid transparent;border-radius:10px;overflow:hidden;background:#fff;cursor:pointer}
  #iamw-uae-product-{{ section.id }} .iamw-thumb.is-active{border-color:var(--purple)}
  #iamw-uae-product-{{ section.id }} .iamw-thumb img{width:100%;height:100%;object-fit:cover}
  #iamw-uae-product-{{ section.id }} .iamw-details{padding-top:8px}
  #iamw-uae-product-{{ section.id }} .iamw-eyebrow,#iamw-uae-product-{{ section.id }} .iamw-kicker{font-size:12px;letter-spacing:.15em;font-weight:800;color:#7b43a8;text-transform:uppercase}
  #iamw-uae-product-{{ section.id }} .iamw-details h1{font-size:clamp(30px,3.2vw,48px);line-height:1.04;margin:8px 0 8px}
  #iamw-uae-product-{{ section.id }} .iamw-subtitle{font-size:21px;color:#786f82;margin-bottom:10px}
  #iamw-uae-product-{{ section.id }} .iamw-rating{display:flex;gap:8px;align-items:center;font-size:14px;margin:12px 0;color:#41364c}
  #iamw-uae-product-{{ section.id }} .iamw-rating span,#iamw-uae-product-{{ section.id }} .iamw-stars{color:#7a24d5;letter-spacing:2px}
  #iamw-uae-product-{{ section.id }} .iamw-price-row{display:flex;gap:12px;align-items:baseline;margin:14px 0 18px}
  #iamw-uae-product-{{ section.id }} .iamw-price{font-size:32px;font-weight:800;color:var(--purple)}
  #iamw-uae-product-{{ section.id }} .iamw-compare{text-decoration:line-through;color:#999}
  #iamw-uae-product-{{ section.id }} .iamw-variant-label{display:block;font-weight:700;font-size:13px;margin-bottom:7px}
  #iamw-uae-product-{{ section.id }} .iamw-variant-select{width:100%;padding:13px 14px;border:1px solid #d9c8e8;border-radius:12px;background:#fff;font:inherit;margin-bottom:14px}
  #iamw-uae-product-{{ section.id }} .iamw-benefit-list{list-style:none;padding:0;margin:18px 0 22px;display:grid;gap:10px}
  #iamw-uae-product-{{ section.id }} .iamw-benefit-list li{position:relative;padding-left:26px;line-height:1.4}
  #iamw-uae-product-{{ section.id }} .iamw-benefit-list li:before{content:'✓';position:absolute;left:0;top:1px;width:18px;height:18px;border-radius:50%;background:#efe1ff;color:var(--purple);font-weight:900;text-align:center;line-height:18px;font-size:12px}
  #iamw-uae-product-{{ section.id }} .iamw-buy-now{width:100%;border:0;border-radius:999px;padding:17px 20px;background:var(--orange);color:#fff;font-weight:800;font-size:17px;cursor:pointer;box-shadow:0 7px 22px rgba(255,148,24,.22)}
  #iamw-uae-product-{{ section.id }} .iamw-buy-now:disabled{opacity:.55;cursor:not-allowed}
  #iamw-uae-product-{{ section.id }} .iamw-trust-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px;color:#46394f}
  #iamw-uae-product-{{ section.id }} .iamw-trust-row>div{display:flex;gap:8px;align-items:center;font-size:12px}
  #iamw-uae-product-{{ section.id }} .iamw-trust-row span{color:var(--purple);font-size:20px}
  #iamw-uae-product-{{ section.id }} .iamw-band{background:linear-gradient(180deg,#fbf7ff,#f4ebff)}
  #iamw-uae-product-{{ section.id }} .iamw-brain{padding:66px 0 72px;text-align:center}
  #iamw-uae-product-{{ section.id }} .iamw-brain h2,#iamw-uae-product-{{ section.id }} .iamw-stories h2,#iamw-uae-product-{{ section.id }} .iamw-appetite h2,#iamw-uae-product-{{ section.id }} .iamw-parent-reviews h2{font-size:clamp(28px,3vw,42px);margin:8px auto 8px}
  #iamw-uae-product-{{ section.id }} .iamw-section-intro{color:var(--muted);max-width:720px;margin:0 auto 30px;line-height:1.6}
  #iamw-uae-product-{{ section.id }} .iamw-benefit-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:30px}
  #iamw-uae-product-{{ section.id }} .iamw-benefit-grid article,#iamw-uae-product-{{ section.id }} .iamw-appetite-grid article{background:#fff;border:1px solid #eee2f8;border-radius:16px;padding:26px 18px;box-shadow:0 10px 30px rgba(66,16,107,.06)}
  #iamw-uae-product-{{ section.id }} .iamw-icon{font-size:30px;margin-bottom:12px}
  #iamw-uae-product-{{ section.id }} .iamw-benefit-grid h3,#iamw-uae-product-{{ section.id }} .iamw-appetite-grid h3{font-size:17px;line-height:1.25;margin-bottom:9px}
  #iamw-uae-product-{{ section.id }} .iamw-benefit-grid p,#iamw-uae-product-{{ section.id }} .iamw-appetite-grid p{font-size:14px;line-height:1.5;color:#5f5668;margin:0}
  #iamw-uae-product-{{ section.id }} .iamw-stories,#iamw-uae-product-{{ section.id }} .iamw-parent-reviews{padding-top:68px;padding-bottom:70px;text-align:center}
  #iamw-uae-product-{{ section.id }} .iamw-story-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:28px;overflow:auto;padding-bottom:8px}
  #iamw-uae-product-{{ section.id }} .iamw-story-card{min-width:210px;border:1px solid #eee3f4;border-radius:16px;overflow:hidden;background:#fff;text-align:left;box-shadow:0 8px 24px rgba(66,16,107,.06)}
  #iamw-uae-product-{{ section.id }} .iamw-story-photo{aspect-ratio:4/3;background:#f6effd}
  #iamw-uae-product-{{ section.id }} .iamw-story-photo img{width:100%;height:100%;object-fit:cover}
