<script>
(function(){
  var root = document.getElementById('iamw-uae-product-{{ section.id }}');
  if(!root) return;
  var mainImage = document.getElementById('iamw-main-image-{{ section.id }}');
  root.querySelectorAll('.iamw-thumb').forEach(function(btn){
    btn.addEventListener('click',function(){
      root.querySelectorAll('.iamw-thumb').forEach(function(x){x.classList.remove('is-active')});
      btn.classList.add('is-active');
      if(mainImage && btn.dataset.image) mainImage.src = btn.dataset.image;
    });
  });

  var variantControl = document.getElementById('iamw-variant-{{ section.id }}');
  var priceEl = document.getElementById('iamw-price-{{ section.id }}');
  var buyBtn = document.getElementById('iamw-buy-now-{{ section.id }}');
  var overlay = document.getElementById('iamw-box-overlay-{{ section.id }}');
  var closeBtn = document.getElementById('iamw-box-close-{{ section.id }}');
  var yesBtn = document.getElementById('iamw-box-yes-{{ section.id }}');
  var noBtn = document.getElementById('iamw-box-no-{{ section.id }}');
  var errorEl = document.getElementById('iamw-box-error-{{ section.id }}');
  var boxVariantId = {{ box_variant.id | default: 0 | json }};
  var boxAvailable = {{ box_variant.available | default: false | json }};

  function selectedVariantId(){ return variantControl ? Number(variantControl.value) : 0; }
  function setBusy(isBusy){ if(yesBtn) yesBtn.disabled = isBusy || !boxAvailable; if(noBtn) noBtn.disabled = isBusy; if(buyBtn) buyBtn.disabled = isBusy; }
  function openPopup(){ if(!overlay) return; overlay.classList.add('is-open'); overlay.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; }
  function closePopup(){ if(!overlay) return; overlay.classList.remove('is-open'); overlay.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }
  function showError(message){ if(!errorEl) return; errorEl.textContent=message; errorEl.hidden=false; }
  function addAndCheckout(addBox){
    var variantId=selectedVariantId();
    if(!variantId){ showError('Please select an available product option.'); return; }
    var items=[{id:variantId,quantity:1}];
    if(addBox && boxVariantId && boxAvailable) items.push({id:Number(boxVariantId),quantity:1});
    setBusy(true); if(errorEl) errorEl.hidden=true;
    fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/')+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})})
      .then(function(res){if(!res.ok) return res.json().then(function(data){throw new Error(data.description||'Unable to add the item to cart.')});return res.json();})
      .then(function(){ window.location.href='/checkout'; })
      .catch(function(err){showError(err.message||'Something went wrong. Please try again.');setBusy(false);});
  }

  if(variantControl && variantControl.tagName==='SELECT') variantControl.addEventListener('change',function(){
    var opt=variantControl.options[variantControl.selectedIndex];
    if(priceEl && opt.dataset.price) priceEl.textContent=opt.dataset.price;
    var available=opt.dataset.available==='true';
    if(buyBtn){buyBtn.disabled=!available;buyBtn.innerHTML=available?'BUY NOW <span>→</span>':'SOLD OUT';}
  });
  if(buyBtn) buyBtn.addEventListener('click',openPopup);
  if(closeBtn) closeBtn.addEventListener('click',closePopup);
  if(overlay) overlay.addEventListener('click',function(e){if(e.target===overlay) closePopup();});
  if(yesBtn) yesBtn.addEventListener('click',function(){addAndCheckout(true)});
  if(noBtn) noBtn.addEventListener('click',function(){addAndCheckout(false)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape') closePopup();});
})();
</script>

