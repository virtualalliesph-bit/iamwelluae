{% comment %}
  I AM WELL
  Reference Section 06
  Stock / Urgency Promo Banner

  Rules:
  Required media shows placeholder
  Blank optional content leaves no empty space
  Desktop and mobile sizing controls
  Adjustable padding, gaps, colors and card width

  CTA options:
  1. Scroll to section
  2. Regular link
{% endcomment %}

<section
  id="IAMW-ALERT-{{ section.id }}"
  class="iamw-alert"
  style="
    --page-width: {{ section.settings.page_width }}px;

    --pad-x: {{ section.settings.padding_x }}px;
    --pad-x-mobile: {{ section.settings.mobile_padding_x }}px;

    --pad-top: {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;

    --card-width: {{ section.settings.card_width }}px;
    --card-height: {{ section.settings.card_height }}px;

    --content-pad: {{ section.settings.content_padding }}px;
    --content-gap: {{ section.settings.content_gap }}px;

    --radius: {{ section.settings.radius }}px;

    --section-bg: {{ section.settings.section_background }};
    --panel-bg: {{ section.settings.panel_background }};
    --placeholder-bg: {{ section.settings.placeholder_background }};
    --text: {{ section.settings.text_color }};
    --button-bg: {{ section.settings.button_background }};
    --button-text: {{ section.settings.button_text_color }};

    --heading-size: {{ section.settings.heading_size }}px;
    --body-size: {{ section.settings.body_size }}px;
    --button-size: {{ section.settings.button_size }}px;

    --heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --body-mobile: {{ section.settings.mobile_body_size }}px;
    --button-mobile: {{ section.settings.mobile_button_size }}px;
  "
>

  <div class="iamw-alert__shell">

    <div class="iamw-alert__card">


      {% comment %}
        IMAGE
      {% endcomment %}

      <div class="iamw-alert__media">

        {% if section.settings.image != blank %}

          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400,600,800,1000,1200',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'iamw-alert__image'
          }}

        {% else %}

          <div class="iamw-alert__placeholder">
            <span>
              ADD PROMO / PRODUCT IMAGE
            </span>
          </div>

        {% endif %}

      </div>



      {% comment %}
        CONTENT
      {% endcomment %}

      <div class="iamw-alert__content">

        {% if section.settings.icon_text != blank %}

          <div class="iamw-alert__icon">
            {{ section.settings.icon_text }}
          </div>

        {% endif %}


        {% if section.settings.heading != blank %}

          <div class="iamw-alert__heading">
            {{ section.settings.heading }}
          </div>

        {% endif %}


        {% if section.settings.body != blank %}

          <div class="iamw-alert__body">
            {{ section.settings.body }}
          </div>

        {% endif %}



        {% comment %}
          CTA
        {% endcomment %}

        {% if section.settings.cta_text != blank %}

          {% assign iamw_cta_url = blank %}

          {% if section.settings.cta_destination == 'anchor' %}

            {% if section.settings.cta_anchor != blank %}
              {% assign iamw_cta_url = '#' | append: section.settings.cta_anchor %}
            {% endif %}

          {% elsif section.settings.cta_destination == 'link' %}

            {% if section.settings.cta_link != blank %}
              {% assign iamw_cta_url = section.settings.cta_link %}
            {% endif %}

          {% endif %}


          {% if iamw_cta_url != blank %}

            <a
              href="{{ iamw_cta_url }}"
              class="iamw-alert__button"
              {% if section.settings.cta_destination == 'anchor' %}
                data-iamw-anchor-link
              {% endif %}
            >
              {{ section.settings.cta_text }}
            </a>

          {% else %}

            <div class="iamw-alert__button iamw-alert__button--disabled">
              {{ section.settings.cta_text }}
            </div>

          {% endif %}

        {% endif %}

      </div>

    </div>

  </div>

</section>



<style>

#IAMW-ALERT-{{ section.id }} {
  width:
    100%;

  padding:
    var(--pad-top)
    var(--pad-x)
    var(--pad-bottom);

  background:
    var(--section-bg);
}


#IAMW-ALERT-{{ section.id }} * {
  box-sizing:
    border-box;
}


#IAMW-ALERT-{{ section.id }}
.iamw-alert__shell {
  width:
    100%;

  max-width:
    var(--page-width);

  margin:
    0 auto;

  display:
    flex;

  justify-content:
    center;
}


#IAMW-ALERT-{{ section.id }}
.iamw-alert__card {
  width:
    100%;

  max-width:
    var(--card-width);

  min-height:
    var(--card-height);

  display:
    grid;

  grid-template-columns:
    1fr 1fr;

  overflow:
    hidden;

  border-radius:
    var(--radius);

  box-shadow:
    0 10px 28px rgba(0,0,0,.07);
}



#IAMW-ALERT-{{ section.id }}
.iamw-alert__media {
  min-height:
    var(--card-height);

  overflow:
    hidden;

  background:
    var(--placeholder-bg);
}


#IAMW-ALERT-{{ section.id }}
.iamw-alert__image {
  width:
    100%;

  height:
    100%;

  display:
    block;

  object-fit:
    {{ section.settings.image_fit }};
}


#IAMW-ALERT-{{ section.id }}
.iamw-alert__placeholder {
  width:
    100%;

  min-height:
    var(--card-height);

  display:
    grid;

  place-items:
    center;

  padding:
    24px;

  background:
    linear-gradient(
      135deg,
      rgba(66,16,107,.08),
      rgba(255,157,22,.10)
    );

  color:
    rgba(28,25,48,.6);

  text-align:
    center;

  font-size:
    13px;

  font-weight:
    800;

  letter-spacing:
    .06em;
}



#IAMW-ALERT-{{ section.id }}
.iamw-alert__content {
  min-height:
    var(--card-height);

  padding:
    var(--content-pad);

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  justify-content:
    center;

  gap:
    var(--content-gap);

  background:
    var(--panel-bg);

  color:
    var(--text);

  text-align:
    center;
}


#IAMW-ALERT-{{ section.id }}
.iamw-alert__icon {
  font-size:
    calc(var(--heading-size) * .8);

  line-height:
    1;
}


#IAMW-ALERT-{{ section.id }}
.iamw-alert__heading {
  color:
    var(--text);

  font-size:
    var(--heading-size);

  font-weight:
    900;

  line-height:
    1.2;
}


#IAMW-ALERT-{{ section.id }}
.iamw-alert__body {
  max-width:
    420px;

  color:
    var(--text);

  font-size:
    var(--body-size);

  font-weight:
    600;

  line-height:
    1.5;
}



#IAMW-ALERT-{{ section.id }}
.iamw-alert__button {
  width:
    100%;

  max-width:
    320px;

  min-height:
    54px;

  padding:
    14px 22px;

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  background:
    var(--button-bg);

  color:
    var(--button-text);

  border-radius:
    999px;

  text-decoration:
    none;

  text-align:
    center;

  font-size:
    var(--button-size);

  font-weight:
    900;

  line-height:
    1.2;

  cursor:
    pointer;

  transition:
    transform .2s ease,
    opacity .2s ease;
}


#IAMW-ALERT-{{ section.id }}
.iamw-alert__button:hover {
  transform:
    translateY(-1px);

  opacity:
    .92;
}


#IAMW-ALERT-{{ section.id }}
.iamw-alert__button--disabled {
  cursor:
    default;

  opacity:
    .65;
}



@media screen and (max-width: 749px) {

  #IAMW-ALERT-{{ section.id }} {
    padding-left:
      var(--pad-x-mobile);

    padding-right:
      var(--pad-x-mobile);
  }


  #IAMW-ALERT-{{ section.id }}
  .iamw-alert__card {
    grid-template-columns:
      1fr;
  }


  #IAMW-ALERT-{{ section.id }}
  .iamw-alert__media,

  #IAMW-ALERT-{{ section.id }}
  .iamw-alert__placeholder {
    min-height:
      {{ section.settings.mobile_image_height }}px;
  }


  #IAMW-ALERT-{{ section.id }}
  .iamw-alert__content {
    min-height:
      auto;
  }


  #IAMW-ALERT-{{ section.id }}
  .iamw-alert__heading {
    font-size:
      var(--heading-mobile);
  }


  #IAMW-ALERT-{{ section.id }}
  .iamw-alert__body {
    font-size:
      var(--body-mobile);
  }


  #IAMW-ALERT-{{ section.id }}
  .iamw-alert__button {
    font-size:
      var(--button-mobile);
  }

}

</style>



<script>

(function() {

  function initIAMWAlertCTA() {

    const section =
      document.getElementById(
        'IAMW-ALERT-{{ section.id }}'
      );

    if (!section) return;


    const anchorLinks =
      section.querySelectorAll(
        '[data-iamw-anchor-link]'
      );


    anchorLinks.forEach(
      function(link) {

        if (
          link.dataset.iamwAnchorReady ===
          'true'
        ) {
          return;
        }


        link.dataset.iamwAnchorReady =
          'true';


        link.addEventListener(
          'click',
          function(event) {

            const href =
              link.getAttribute(
                'href'
              );


            if (
              !href ||
              href.charAt(0) !== '#'
            ) {
              return;
            }


            const target =
              document.querySelector(
                href
              );


            if (!target) {
              return;
            }


            event.preventDefault();


            target.scrollIntoView({
              behavior:
                'smooth',

              block:
                'start'
            });


            if (
              window.history &&
              window.history.replaceState
            ) {

              window.history.replaceState(
                null,
                '',
                href
              );

            }

          }
        );

      }
    );

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initIAMWAlertCTA
    );

  } else {

    initIAMWAlertCTA();

  }


  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.target &&
        event.target.id ===
        'IAMW-ALERT-{{ section.id }}'
      ) {

        initIAMWAlertCTA();

      }

    }
  );

})();

</script>



{% schema %}

{
  "name": "IAMW Stock Alert",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "icon_text",
      "label": "Optional icon / emoji",
      "default": "💜"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited Smart Routine Offer"
    },

    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Ready to make vitamins time easier? Secure your 90 day Smart Gummies routine today."
    },


    {
      "type": "header",
      "content": "CTA"
    },

    {
      "type": "text",
