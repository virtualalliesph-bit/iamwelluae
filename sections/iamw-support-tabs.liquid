<section class="iamw-tabs iamw-tabs--{{ section.id }}" data-iamw-tabs>
  <div class="iamw-tabs__inner">
    <header class="iamw-tabs__header">
      {% if section.settings.eyebrow != blank %}<div class="iamw-tabs__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.intro != blank %}<div class="iamw-tabs__intro rte">{{ section.settings.intro }}</div>{% endif %}
    </header>

    <div class="iamw-tabs__nav" role="tablist">
      {% for block in section.blocks %}
        <button type="button" role="tab" class="iamw-tabs__tab{% if forloop.first %} is-active{% endif %}" data-tab-button="{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ block.settings.title }}</button>
      {% endfor %}
    </div>

    <div class="iamw-tabs__panels">
      {% for block in section.blocks %}
        <article class="iamw-tabs__panel{% unless forloop.first %} is-hidden{% endunless %}" data-tab-panel="{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="iamw-tabs__content">
            {% if block.settings.panel_heading != blank %}<h3>{{ block.settings.panel_heading }}</h3>{% endif %}
            {% if block.settings.text != blank %}<div class="iamw-tabs__text rte">{{ block.settings.text }}</div>{% endif %}
          </div>
          <div class="iamw-tabs__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(min-width:900px) 42vw, 100vw', class: 'iamw-tabs__image', alt: block.settings.title }}
            {% else %}
              <div class="iamw-tabs__placeholder">Add tab image</div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
.iamw-tabs--{{ section.id }}{--purple:{{ section.settings.purple }};--orange:{{ section.settings.orange }};--text:{{ section.settings.text_color }};--muted:{{ section.settings.muted }};--border:{{ section.settings.border_color }};background:{{ section.settings.background }};color:var(--text);padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px}.iamw-tabs--{{ section.id }} *{box-sizing:border-box}.iamw-tabs--{{ section.id }} .iamw-tabs__inner{max-width:1240px;margin:0 auto}.iamw-tabs--{{ section.id }} .iamw-tabs__header{text-align:center;max-width:820px;margin:0 auto 28px}.iamw-tabs--{{ section.id }} .iamw-tabs__eyebrow{color:var(--purple);font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px}.iamw-tabs--{{ section.id }} h2{font-size:clamp(32px,4vw,48px);line-height:1.05;letter-spacing:-.035em;margin:0}.iamw-tabs--{{ section.id }} .iamw-tabs__intro{color:var(--muted);margin-top:10px}.iamw-tabs--{{ section.id }} .iamw-tabs__nav{display:grid;grid-template-columns:repeat({{ section.blocks.size | at_most: 4 }},1fr);border:1px solid var(--border);border-radius:999px;padding:4px;margin-bottom:24px;gap:4px}.iamw-tabs--{{ section.id }} .iamw-tabs__tab{border:0;background:transparent;color:var(--text);padding:11px 14px;border-radius:999px;font:inherit;font-weight:800;cursor:pointer}.iamw-tabs--{{ section.id }} .iamw-tabs__tab.is-active{background:var(--purple);color:#fff}.iamw-tabs--{{ section.id }} .iamw-tabs__panel{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);border:1px solid var(--border);border-radius:16px;overflow:hidden;background:#fff;min-height:420px}.iamw-tabs--{{ section.id }} .iamw-tabs__panel.is-hidden{display:none}.iamw-tabs--{{ section.id }} .iamw-tabs__content{padding:42px;display:flex;flex-direction:column;justify-content:center}.iamw-tabs--{{ section.id }} h3{font-size:clamp(28px,3vw,38px);margin:0 0 16px;letter-spacing:-.03em}.iamw-tabs--{{ section.id }} .iamw-tabs__text{color:var(--muted);font-size:16px;line-height:1.7}.iamw-tabs--{{ section.id }} .iamw-tabs__media{background:#f4edf8;min-height:420px}.iamw-tabs--{{ section.id }} .iamw-tabs__image{display:block;width:100%;height:100%;min-height:420px;object-fit:cover}.iamw-tabs--{{ section.id }} .iamw-tabs__placeholder{min-height:420px;display:grid;place-items:center;color:var(--muted)}
@media(max-width:899px){.iamw-tabs--{{ section.id }}{padding-left:16px;padding-right:16px}.iamw-tabs--{{ section.id }} .iamw-tabs__nav{display:flex;overflow:auto;border-radius:14px}.iamw-tabs--{{ section.id }} .iamw-tabs__tab{white-space:nowrap;flex:0 0 auto}.iamw-tabs--{{ section.id }} .iamw-tabs__panel{grid-template-columns:1fr}.iamw-tabs--{{ section.id }} .iamw-tabs__content{padding:26px}.iamw-tabs--{{ section.id }} .iamw-tabs__media,.iamw-tabs--{{ section.id }} .iamw-tabs__image,.iamw-tabs--{{ section.id }} .iamw-tabs__placeholder{min-height:300px}}
{% endstyle %}

<script>
(() => {
  const root = document.querySelector('.iamw-tabs--{{ section.id }}');
  if (!root || root.dataset.bound === 'true') return;
  root.dataset.bound = 'true';
  const buttons = root.querySelectorAll('[data-tab-button]');
  const panels = root.querySelectorAll('[data-tab-panel]');
  buttons.forEach(button => button.addEventListener('click', () => {
    const id = button.dataset.tabButton;
    buttons.forEach(item => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-selected', item === button ? 'true' : 'false'); });
    panels.forEach(panel => panel.classList.toggle('is-hidden', panel.dataset.tabPanel !== id));
  }));
})();
</script>

{% schema %}
{
  "name":"IAMW Support Tabs",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"I AM WELL BENEFIT SUPPORT"},
    {"type":"text","id":"heading","label":"Heading","default":"Everyday nutrients for growing children"},
    {"type":"richtext","id":"intro","label":"Intro"},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"},
    {"type":"color","id":"purple","label":"Purple","default":"#42106b"},
    {"type":"color","id":"orange","label":"Orange","default":"#ff9d16"},
    {"type":"color","id":"text_color","label":"Text","default":"#17131f"},
    {"type":"color","id":"muted","label":"Muted text","default":"#655f69"},
    {"type":"color","id":"border_color","label":"Border","default":"#e6ddeb"},
    {"type":"range","id":"padding_top","label":"Top spacing","min":20,"max":120,"step":4,"unit":"px","default":52},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":20,"max":120,"step":4,"unit":"px","default":52}
  ],
  "blocks":[
    {"type":"tab","name":"Support tab","limit":4,"settings":[
      {"type":"text","id":"title","label":"Tab title","default":"Picky Eating"},
      {"type":"text","id":"panel_heading","label":"Panel heading","default":"How This Helps"},
      {"type":"richtext","id":"text","label":"Text","default":"<p>Add the supporting explanation and nutrients here.</p>"},
      {"type":"image_picker","id":"image","label":"Image"}
    ]}
  ],
  "presets":[{"name":"IAMW Support Tabs","blocks":[{"type":"tab"},{"type":"tab"},{"type":"tab"},{"type":"tab"}]}]
}
{% endschema %}
