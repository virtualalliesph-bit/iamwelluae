{% liquid
  assign cta_href = section.settings.cta_link
  if section.settings.cta_anchor != blank
    assign cta_href = '#' | append: section.settings.cta_anchor
  endif
%}

<section class="iamw-story iamw-story--{{ section.id }}">
  <div class="iamw-story__inner">
    <div class="iamw-story__copy">
      {% if section.settings.rating_text != blank %}
        <div class="iamw-story__rating"><span>{{ section.settings.stars }}</span>{{ section.settings.rating_text }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}<h1>{{ section.settings.heading }}</h1>{% endif %}
      {% if section.settings.body != blank %}<div class="iamw-story__body rte">{{ section.settings.body }}</div>{% endif %}

      {% if section.settings.cta_label != blank %}
        <a class="iamw-story__cta" href="{{ cta_href | default: '#' }}">{{ section.settings.cta_label }}</a>
      {% endif %}

      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <article class="iamw-story__review" {{ block.shopify_attributes }}>
            <div class="iamw-story__review-stars">{{ block.settings.stars }}</div>
            <div class="iamw-story__quote">{{ block.settings.quote }}</div>
            <div class="iamw-story__reviewer"><strong>{{ block.settings.name }}</strong>{% if block.settings.meta != blank %}<span>{{ block.settings.meta }}</span>{% endif %}</div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <div class="iamw-story__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '600,900,1200,1600,1800', sizes: '(min-width: 900px) 50vw, 100vw', class: 'iamw-story__image', alt: section.settings.heading }}
      {% else %}
        <div class="iamw-story__placeholder">Add your hero image</div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
.iamw-story--{{ section.id }}{--purple:{{ section.settings.purple }};--orange:{{ section.settings.orange }};--text:{{ section.settings.text_color }};--muted:{{ section.settings.muted }};background:{{ section.settings.background }};color:var(--text);padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px}.iamw-story--{{ section.id }} *{box-sizing:border-box}.iamw-story--{{ section.id }} .iamw-story__inner{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:48px;align-items:center}.iamw-story--{{ section.id }} .iamw-story__copy{display:flex;flex-direction:column;align-items:flex-start;gap:18px}.iamw-story--{{ section.id }} .iamw-story__rating{display:flex;gap:10px;align-items:center;font-size:14px;font-weight:700}.iamw-story--{{ section.id }} .iamw-story__rating span,.iamw-story--{{ section.id }} .iamw-story__review-stars{color:var(--orange);letter-spacing:2px}.iamw-story--{{ section.id }} h1{font-size:clamp(38px,5vw,64px);line-height:.98;letter-spacing:-.045em;margin:0;max-width:720px}.iamw-story--{{ section.id }} .iamw-story__body{font-size:17px;line-height:1.65;color:var(--muted);max-width:650px}.iamw-story--{{ section.id }} .iamw-story__body p{margin:.3em 0}.iamw-story--{{ section.id }} .iamw-story__cta{display:inline-flex;justify-content:center;align-items:center;min-height:52px;padding:14px 26px;border-radius:999px;background:var(--purple);color:#fff;text-decoration:none;font-weight:800;letter-spacing:.02em}.iamw-story--{{ section.id }} .iamw-story__review{width:100%;margin-top:4px;padding:22px;border:1px solid #e9e1ee;border-radius:14px;background:#fff}.iamw-story--{{ section.id }} .iamw-story__quote{font-size:14px;line-height:1.6;margin:10px 0 14px}.iamw-story--{{ section.id }} .iamw-story__reviewer{display:flex;flex-direction:column;gap:2px;font-size:12px}.iamw-story--{{ section.id }} .iamw-story__reviewer span{color:var(--muted)}.iamw-story--{{ section.id }} .iamw-story__media{min-height:560px;border-radius:18px;overflow:hidden;background:#f4edf8}.iamw-story--{{ section.id }} .iamw-story__image{width:100%;height:100%;min-height:560px;object-fit:cover;display:block}.iamw-story--{{ section.id }} .iamw-story__placeholder{min-height:560px;display:grid;place-items:center;color:var(--muted)}
@media(max-width:899px){.iamw-story--{{ section.id }}{padding-left:16px;padding-right:16px}.iamw-story--{{ section.id }} .iamw-story__inner{grid-template-columns:1fr;gap:26px}.iamw-story--{{ section.id }} h1{font-size:clamp(36px,11vw,54px)}.iamw-story--{{ section.id }} .iamw-story__media,.iamw-story--{{ section.id }} .iamw-story__image,.iamw-story--{{ section.id }} .iamw-story__placeholder{min-height:420px}}
{% endstyle %}

{% schema %}
{
  "name": "IAMW Story Hero",
  "settings": [
    {"type":"text","id":"stars","label":"Stars","default":"★★★★★"},
    {"type":"text","id":"rating_text","label":"Rating text","default":"Feedback from I Am Well parents"},
    {"type":"text","id":"heading","label":"Heading","default":"Does your child lose interest after just a few bites?"},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Getting a child to eat a varied diet can be a challenge. I Am Well Smart Gummies is designed to complement balanced meals as part of a simple daily routine.</p>"},
    {"type":"text","id":"cta_label","label":"Button label","default":"EXPLORE SMART GUMMIES"},
    {"type":"text","id":"cta_anchor","label":"Anchor ID","default":"iamw-products"},
    {"type":"url","id":"cta_link","label":"Button link"},
    {"type":"image_picker","id":"image","label":"Hero image"},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"},
    {"type":"color","id":"purple","label":"Purple","default":"#42106b"},
    {"type":"color","id":"orange","label":"Orange","default":"#ff9d16"},
    {"type":"color","id":"text_color","label":"Text","default":"#17131f"},
    {"type":"color","id":"muted","label":"Muted text","default":"#655f69"},
    {"type":"range","id":"padding_top","label":"Top spacing","min":20,"max":120,"step":4,"unit":"px","default":48},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":20,"max":120,"step":4,"unit":"px","default":48}
  ],
  "blocks": [
    {"type":"review","name":"Parent review","limit":2,"settings":[
      {"type":"text","id":"stars","label":"Stars","default":"★★★★★"},
      {"type":"textarea","id":"quote","label":"Review","default":"I noticed positive changes in our daily routine after adding Smart Gummies consistently."},
      {"type":"text","id":"name","label":"Name","default":"I Am Well parent"},
      {"type":"text","id":"meta","label":"Meta","default":"Customer review"}
    ]}
  ],
  "presets": [{"name":"IAMW Story Hero","blocks":[{"type":"review"}]}]
}
{% endschema %}
