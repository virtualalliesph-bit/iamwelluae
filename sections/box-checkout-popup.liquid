{% liquid
  assign box_product = section.settings.box_product
  if box_product == blank and section.settings.box_product_handle != blank
    assign box_product = all_products[section.settings.box_product_handle]
  endif

  assign box_variant = nil
  if box_product != blank
    if section.settings.box_variant_id != blank
      assign target_box_id = section.settings.box_variant_id | plus: 0
      assign box_variant = box_product.variants | where: 'id', target_box_id | first
    endif
    if box_variant == blank
      assign box_variant = box_product.selected_or_first_available_variant
    endif
  endif

  assign popup_image = section.settings.popup_image
  if popup_image == blank and box_product != blank
    assign popup_image = box_product.featured_image
  endif

  assign popup_description = section.settings.description
  if popup_description contains '₱'
    assign popup_description = 'Would you like to add a box to your order?'
  endif
%}

{% if section.settings.enable_popup %}
  <div id="iamw-box-{{ section.id }}" class="iamw-box-modal" hidden aria-hidden="true">
    <button type="button" class="iamw-box-modal__backdrop" data-iamw-close aria-label="Close"></button>
    <div class="iamw-box-modal__card" role="dialog" aria-modal="true" aria-labelledby="iamw-box-title-{{ section.id }}">
      <button type="button" class="iamw-box-modal__x" data-iamw-close aria-label="Close">×</button>

      {% if popup_image != blank %}
        <div class="iamw-box-modal__media">
          {{ popup_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'iamw-box-modal__image', alt: section.settings.heading }}
        </div>
      {% endif %}

      <div class="iamw-box-modal__body">
        <h3 id="iamw-box-title-{{ section.id }}">{{ section.settings.heading }}</h3>
        {% if popup_description != blank %}<p>{{ popup_description }}</p>{% endif %}

        <div class="iamw-box-modal__status{% unless box_variant != blank and box_variant.available %} is-unavailable{% endunless %}">
          {% if box_variant != blank and box_variant.available %}
            {{ section.settings.available_note }}{% if section.settings.show_box_price %} · {{ box_variant.price | money }}{% endif %}
          {% else %}
            {{ section.settings.unavailable_note }}
          {% endif %}
        </div>

        <div class="iamw-box-modal__qty{% unless box_variant != blank and box_variant.available %} is-disabled{% endunless %}">
          <span>Box quantity</span>
          <div>
            <button type="button" data-iamw-minus aria-label="Decrease quantity">−</button>
            <input type="number" min="1" value="1" data-iamw-qty {% unless box_variant != blank and box_variant.available %}disabled{% endunless %}>
            <button type="button" data-iamw-plus aria-label="Increase quantity">+</button>
          </div>
        </div>

        <div class="iamw-box-modal__error" data-iamw-error hidden></div>

        <button type="button" class="iamw-box-modal__yes" data-iamw-yes {% unless box_variant != blank and box_variant.available %}disabled{% endunless %}>
          {% if box_variant != blank and box_variant.available %}{{ section.settings.add_button_label }}{% else %}{{ section.settings.disabled_button_label }}{% endif %}
        </button>
        <button type="button" class="iamw-box-modal__no" data-iamw-no>{{ section.settings.checkout_button_label }}</button>
      </div>
    </div>
  </div>

  <style>
    #iamw-box-{{ section.id }}[hidden]{display:none!important}
    #iamw-box-{{ section.id }}{position:fixed;inset:0;z-index:2147483000;display:grid;place-items:center;padding:16px}
    #iamw-box-{{ section.id }} .iamw-box-modal__backdrop{position:absolute;inset:0;border:0;background:rgba(25,10,35,.58)}
    #iamw-box-{{ section.id }} .iamw-box-modal__card{position:relative;z-index:1;width:min(100%,{{ section.settings.popup_width }}px);max-height:calc(100vh - 32px);overflow:auto;background:{{ section.settings.popup_bg_color }};border-radius:18px;box-shadow:0 24px 70px rgba(42,10,65,.28)}
    #iamw-box-{{ section.id }} .iamw-box-modal__x{position:absolute;right:12px;top:12px;z-index:2;width:34px;height:34px;border:1px solid #e4d9ea;border-radius:50%;background:#fff;color:{{ section.settings.close_icon_color }};font-size:24px;cursor:pointer}
    #iamw-box-{{ section.id }} .iamw-box-modal__media{padding:16px 16px 0;background:{{ section.settings.image_bg_color }}}
    #iamw-box-{{ section.id }} .iamw-box-modal__image{display:block;width:100%;max-height:270px;object-fit:contain;border-radius:12px}
    #iamw-box-{{ section.id }} .iamw-box-modal__body{padding:22px}
    #iamw-box-{{ section.id }} h3{margin:0 38px 8px 0;color:{{ section.settings.heading_color }};font-size:24px;line-height:1.15}
    #iamw-box-{{ section.id }} p{margin:0 0 10px;color:{{ section.settings.text_color }};font-size:14px;line-height:1.55}
    #iamw-box-{{ section.id }} .iamw-box-modal__status{margin-bottom:16px;color:{{ section.settings.available_note_color }};font-size:13px;font-weight:600}
    #iamw-box-{{ section.id }} .iamw-box-modal__status.is-unavailable{color:{{ section.settings.unavailable_note_color }}}
    #iamw-box-{{ section.id }} .iamw-box-modal__qty{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;color:{{ section.settings.text_color }};font-size:14px;font-weight:600}
    #iamw-box-{{ section.id }} .iamw-box-modal__qty.is-disabled{opacity:.45;pointer-events:none}
    #iamw-box-{{ section.id }} .iamw-box-modal__qty>div{display:grid;grid-template-columns:38px 54px 38px}
    #iamw-box-{{ section.id }} .iamw-box-modal__qty button,#iamw-box-{{ section.id }} .iamw-box-modal__qty input{height:38px;border:1px solid #ded7e3;background:#fff;text-align:center;color:#2d1247;font:inherit}
    #iamw-box-{{ section.id }} .iamw-box-modal__qty input{width:54px;border-left:0;border-right:0}
    #iamw-box-{{ section.id }} .iamw-box-modal__qty button:first-child{border-radius:8px 0 0 8px}#iamw-box-{{ section.id }} .iamw-box-modal__qty button:last-child{border-radius:0 8px 8px 0}
    #iamw-box-{{ section.id }} .iamw-box-modal__error{margin:0 0 12px;padding:10px 12px;border-radius:8px;background:#fff0f0;color:#a00000;font-size:13px}
    #iamw-box-{{ section.id }} .iamw-box-modal__yes,#iamw-box-{{ section.id }} .iamw-box-modal__no{width:100%;min-height:48px;padding:12px 16px;border-radius:10px;font:inherit;font-size:15px;font-weight:700;cursor:pointer}
    #iamw-box-{{ section.id }} .iamw-box-modal__yes{margin-bottom:10px;border:1px solid {{ section.settings.add_button_bg }};background:{{ section.settings.add_button_bg }};color:{{ section.settings.add_button_text }}}
    #iamw-box-{{ section.id }} .iamw-box-modal__yes:disabled{background:{{ section.settings.disabled_button_bg }};color:{{ section.settings.disabled_button_text }};border-color:{{ section.settings.disabled_button_bg }};cursor:not-allowed}
    #iamw-box-{{ section.id }} .iamw-box-modal__no{border:1px solid {{ section.settings.checkout_button_bg }};background:{{ section.settings.checkout_button_bg }};color:{{ section.settings.checkout_button_text }}}
    .iamw-box-buy-now[data-iamw-section="{{ section.id }}"]{width:100%;min-height:48px;padding:12px 18px;border:0;border-radius:{{ section.settings.buy_now_radius }}px;background:{{ section.settings.buy_now_bg }};color:{{ section.settings.buy_now_text }};font:inherit;font-size:15px;font-weight:700;cursor:pointer}
  </style>

  <script>
    (function(){
      var sid={{ section.id | json }};
      var modal=document.getElementById('iamw-box-'+sid);
      if(!modal)return;
      var yes=modal.querySelector('[data-iamw-yes]');
      var no=modal.querySelector('[data-iamw-no]');
      var qty=modal.querySelector('[data-iamw-qty]');
      var err=modal.querySelector('[data-iamw-error]');
      var boxId={{ box_variant.id | default: 0 | json }};
      var boxAvailable={{ box_variant.available | default: false | json }};
      var pending=null;
      var trigger=null;

      function root(){return (window.Shopify&&window.Shopify.routes&&window.Shopify.routes.root)||'/'}
      function error(message){if(!err)return;err.textContent=message||'Unable to continue.';err.hidden=false}
      function clearError(){if(err){err.textContent='';err.hidden=true}}
      function open(item,button){pending=item;trigger=button;clearError();modal.hidden=false;modal.setAttribute('aria-hidden','false');document.body.style.overflow='hidden'}
      function close(){modal.hidden=true;modal.setAttribute('aria-hidden','true');document.body.style.overflow='';pending=null;if(trigger)trigger.focus();trigger=null;clearError()}

      function itemFromForm(form){
        if(!form)return null;
        var fd=new FormData(form),id=fd.get('id');
        if(!id)return null;
        var item={id:Number(id),quantity:Number(fd.get('quantity')||1)};
        var selling=fd.get('selling_plan');if(selling)item.selling_plan=Number(selling);
        var props={};fd.forEach(function(v,k){var m=k.match(/^properties\[(.+)\]$/);if(m&&v!=='')props[m[1]]=v});
        if(Object.keys(props).length)item.properties=props;
        return item;
      }

      function formFor(el){
        var form=el.closest('form[action*="/cart/add"]');if(form)return form;
        var host=el.closest('product-form,product-info,.product-information,[data-section-id]');
        if(host){form=host.querySelector('form[action*="/cart/add"]');if(form)return form}
        var forms=document.querySelectorAll('form[action*="/cart/add"]');
        return forms.length===1?forms[0]:null;
      }

      function makeButton(payment){
        if(payment.getAttribute('data-iamw-box-bound')===sid){payment.style.display='none';return}
        var form=formFor(payment);if(!form)return;
        var button=document.createElement('button');button.type='button';button.className='iamw-box-buy-now';button.dataset.iamwSection=sid;button.textContent={{ section.settings.buy_now_label | json }};
        button.addEventListener('click',function(e){e.preventDefault();var item=itemFromForm(form);if(!item){error('Please select an available option first.');return}open(item,button)});
        payment.insertAdjacentElement('beforebegin',button);payment.style.display='none';payment.setAttribute('aria-hidden','true');payment.setAttribute('data-iamw-box-bound',sid);
      }

      function bind(){
        var payments=document.querySelectorAll('.shopify-payment-button');
        if(!payments.length)payments=document.querySelectorAll('shopify-accelerated-checkout,[data-shopify="payment-button"]');
        payments.forEach(makeButton);
      }

      function add(items){return fetch(root()+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})}).then(function(r){if(!r.ok)return r.json().catch(function(){return{}}).then(function(p){throw new Error(p.description||p.message||'Unable to add item to cart.')});return r.json()})}
      function processing(on){[yes,no].forEach(function(b){if(b)b.disabled=on||(b===yes&&!boxAvailable)});if(trigger)trigger.disabled=on}
      function checkout(withBox){
        if(!pending){error('Please select the product again.');return}
        var items=[pending];
        if(withBox){if(!boxId||!boxAvailable){error({{ section.settings.unavailable_note | json }});return}var q=parseInt(qty&&qty.value,10)||1;items.push({id:Number(boxId),quantity:Math.max(1,q)})}
        clearError();processing(true);add(items).then(function(){window.location.href='/checkout'}).catch(function(e){processing(false);error(e.message)})
      }

      modal.querySelectorAll('[data-iamw-close]').forEach(function(b){b.addEventListener('click',close)});
      if(yes)yes.addEventListener('click',function(){checkout(true)});if(no)no.addEventListener('click',function(){checkout(false)});
      var minus=modal.querySelector('[data-iamw-minus]'),plus=modal.querySelector('[data-iamw-plus]');
      if(minus&&qty)minus.addEventListener('click',function(){qty.value=Math.max(1,(parseInt(qty.value,10)||1)-1)});
      if(plus&&qty)plus.addEventListener('click',function(){qty.value=(parseInt(qty.value,10)||1)+1});
      document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!modal.hidden)close()});
      bind();new MutationObserver(bind).observe(document.documentElement,{childList:true,subtree:true});document.addEventListener('shopify:section:load',bind);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Box checkout popup",
  "settings": [
    {"type":"checkbox","id":"enable_popup","label":"Enable popup","default":true},
    {"type":"product","id":"box_product","label":"Box product (recommended)"},
    {"type":"text","id":"box_product_handle","label":"Box product handle (fallback)","default":"i-am-well-box"},
    {"type":"text","id":"box_variant_id","label":"Box variant ID (optional)"},
    {"type":"text","id":"buy_now_label","label":"Buy Now label","default":"BUY NOW"},
    {"type":"color","id":"buy_now_bg","label":"Buy Now background","default":"#ff8f23"},
    {"type":"color","id":"buy_now_text","label":"Buy Now text","default":"#ffffff"},
    {"type":"range","id":"buy_now_radius","label":"Buy Now corner radius","min":0,"max":40,"step":1,"default":12,"unit":"px"},
    {"type":"range","id":"popup_width","label":"Popup width","min":320,"max":600,"step":10,"default":420,"unit":"px"},
    {"type":"image_picker","id":"popup_image","label":"Popup image"},
    {"type":"text","id":"heading","label":"Heading","default":"Add a Box?"},
    {"type":"textarea","id":"description","label":"Description","default":"Would you like to add a box to your order?"},
    {"type":"checkbox","id":"show_box_price","label":"Show box price","default":true},
    {"type":"text","id":"available_note","label":"Available message","default":"Available"},
    {"type":"text","id":"unavailable_note","label":"Unavailable message","default":"Box is currently unavailable"},
    {"type":"text","id":"add_button_label","label":"Add box button","default":"Yes, add a box"},
    {"type":"text","id":"disabled_button_label","label":"Unavailable button","default":"Box unavailable"},
    {"type":"text","id":"checkout_button_label","label":"Continue without box button","default":"No thanks, continue to checkout"},
    {"type":"color","id":"popup_bg_color","label":"Popup background","default":"#ffffff"},
    {"type":"color","id":"image_bg_color","label":"Image background","default":"#f7f4fb"},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#2d1247"},
    {"type":"color","id":"text_color","label":"Text color","default":"#666666"},
    {"type":"color","id":"available_note_color","label":"Available color","default":"#3c7a3c"},
    {"type":"color","id":"unavailable_note_color","label":"Unavailable color","default":"#b00000"},
    {"type":"color","id":"close_icon_color","label":"Close icon color","default":"#5b2a86"},
    {"type":"color","id":"add_button_bg","label":"Add box button background","default":"#5b2a86"},
    {"type":"color","id":"add_button_text","label":"Add box button text","default":"#ffffff"},
    {"type":"color","id":"disabled_button_bg","label":"Disabled button background","default":"#d9d9d9"},
    {"type":"color","id":"disabled_button_text","label":"Disabled button text","default":"#777777"},
    {"type":"color","id":"checkout_button_bg","label":"Continue button background","default":"#5b2a86"},
    {"type":"color","id":"checkout_button_hover_bg","label":"Continue button hover background","default":"#4a216d"},
    {"type":"color","id":"checkout_button_text","label":"Continue button text","default":"#ffffff"}
  ],
  "presets": [{"name":"Box checkout popup"}]
}
{% endschema %}
