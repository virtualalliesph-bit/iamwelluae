<section class="iamw-promo iamw-promo--{{ section.id }}">
  <div class="iamw-promo__inner">
    <div class="iamw-promo__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(min-width:900px) 48vw, 100vw', class: 'iamw-promo__image', alt: section.settings.heading }}
      {% else %}
        <div class="iamw-promo__placeholder">Add promo image</div>
      {% endif %}
    </div>
    <div class="iamw-promo__content">
      {% if section.settings.eyebrow != blank %}<div class="iamw-promo__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.body != blank %}<div class="iamw-promo__body rte">{{ section.settings.body }}</div>{% endif %}
      {% if section.settings.cta_label != blank %}<a href="{{ section.settings.cta_link | default: '#iamw-products' }}" class="iamw-promo__cta">{{ section.settings.cta_label }}</a>{% endif %}
    </div>
  </div>
</section>

{% style %}
.iamw-promo--{{ section.id }}{background:{{ section.settings.background }};padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px}.iamw-promo--{{ section.id }} *{box-sizing:border-box}.iamw-promo--{{ section.id }} .iamw-promo__inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;border-radius:18px;overflow:hidden;background:#fff}.iamw-promo--{{ section.id }} .iamw-promo__media{min-height:360px;background:#f4edf8}.iamw-promo--{{ section.id }} .iamw-promo__image{width:100%;height:100%;min-height:360px;object-fit:cover;display:block}.iamw-promo--{{ section.id }} .iamw-promo__placeholder{display:grid;place-items:center;min-height:360px;color:#6c6670}.iamw-promo--{{ section.id }} .iamw-promo__content{padding:42px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start}.iamw-promo--{{ section.id }} .iamw-promo__eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:900;color:{{ section.settings.purple }};margin-bottom:8px}.iamw-promo--{{ section.id }} h2{margin:0 0 14px;font-size:clamp(30px,4vw,46px);line-height:1.04;letter-spacing:-.035em;color:{{ section.settings.text_color }}}.iamw-promo--{{ section.id }} .iamw-promo__body{color:{{ section.settings.muted }};font-size:16px;line-height:1.65}.iamw-promo--{{ section.id }} .iamw-promo__cta{margin-top:18px;display:inline-flex;min-height:48px;padding:12px 24px;border-radius:999px;background:{{ section.settings.purple }};color:#fff;text-decoration:none;font-weight:900}
@media(max-width:899px){.iamw-promo--{{ section.id }}{padding-left:16px;padding-right:16px}.iamw-promo--{{ section.id }} .iamw-promo__inner{grid-template-columns:1fr}.iamw-promo--{{ section.id }} .iamw-promo__content{padding:28px}}
{% endstyle %}

{% schema %}
{
  "name":"IAMW Promo Split",
  "settings":[
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"NEW LOOK. SAME DAILY ROUTINE."},
    {"type":"text","id":"heading","label":"Heading","default":"Built for a simple everyday routine"},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Use this section for a campaign, packaging update, bundle callout or secondary offer.</p>"},
    {"type":"text","id":"cta_label","label":"Button label","default":"VIEW THE STARTER PACK"},
    {"type":"url","id":"cta_link","label":"Button link"},
    {"type":"color","id":"background","label":"Background","default":"#f6ecfb"},
    {"type":"color","id":"purple","label":"Purple","default":"#42106b"},
    {"type":"color","id":"text_color","label":"Text","default":"#17131f"},
    {"type":"color","id":"muted","label":"Muted text","default":"#655f69"},
    {"type":"range","id":"padding_top","label":"Top spacing","min":20,"max":120,"step":4,"unit":"px","default":42},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":20,"max":120,"step":4,"unit":"px","default":42}
  ],
  "presets":[{"name":"IAMW Promo Split"}]
}
{% endschema %}
