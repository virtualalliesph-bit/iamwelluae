{% comment %}
  I AM WELL
  Reference Section 02
  Social Proof + Product Story

  CTA options:
  1. Scroll to section
  2. Regular link
{% endcomment %}

<section
  id="IAMW-PROOF-{{ section.id }}"
  class="iamw-proof"
  style="
    --page-width: {{ section.settings.page_width }}px;

    --pad-x: {{ section.settings.padding_x }}px;
    --pad-x-mobile: {{ section.settings.mobile_padding_x }}px;

    --pad-top: {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;

    --column-gap: {{ section.settings.column_gap }}px;
    --content-gap: {{ section.settings.content_gap }}px;
    --block-gap: {{ section.settings.block_gap }}px;

    --radius: {{ section.settings.radius }}px;

    --purple: {{ section.settings.purple }};
    --orange: {{ section.settings.orange }};
    --cream: {{ section.settings.cream }};
    --background: {{ section.settings.background }};
    --text: {{ section.settings.text_color }};
    --muted: {{ section.settings.muted }};
    --border: {{ section.settings.border_color }};

    --heading-size: {{ section.settings.heading_size }}px;
    --body-size: {{ section.settings.body_size }}px;
    --rating-size: {{ section.settings.rating_size }}px;

    --heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --body-mobile: {{ section.settings.mobile_body_size }}px;
  "
>

  <div class="iamw-proof__inner">

    <div class="iamw-proof__content">

      {% comment %}
        RATING / REVIEW INTRO
      {% endcomment %}

      {% if section.settings.rating_text != blank
        or section.settings.rating_stars != blank
      %}

        <div class="iamw-proof__rating">

          {% if section.settings.rating_stars != blank %}
            <span class="iamw-proof__rating-stars">
              {{ section.settings.rating_stars }}
            </span>
          {% endif %}

          {% if section.settings.rating_text != blank %}
            <span class="iamw-proof__rating-text">
              {{ section.settings.rating_text }}
            </span>
          {% endif %}

        </div>

      {% endif %}



      {% comment %}
        MAIN COPY
      {% endcomment %}

      {% if section.settings.heading != blank %}

        <h2 class="iamw-proof__heading">
          {{ section.settings.heading }}
        </h2>

      {% endif %}


      {% if section.settings.body != blank %}

        <div class="iamw-proof__rte">
          {{ section.settings.body }}
        </div>

      {% endif %}



      {% comment %}
        CTA
      {% endcomment %}

      {% if section.settings.cta_text != blank %}

        {% assign iamw_cta_url = blank %}

        {% if section.settings.cta_destination == 'anchor' %}

          {% if section.settings.cta_anchor != blank %}
            {% assign iamw_cta_url = '#' | append: section.settings.cta_anchor %}
          {% endif %}

        {% elsif section.settings.cta_destination == 'link' %}

          {% if section.settings.cta_link != blank %}
            {% assign iamw_cta_url = section.settings.cta_link %}
          {% endif %}

        {% endif %}


        {% if iamw_cta_url != blank %}

          <a
            href="{{ iamw_cta_url }}"
            class="iamw-proof__cta"
            {% if section.settings.cta_destination == 'anchor' %}
              data-iamw-anchor-link
            {% endif %}
          >
            {{ section.settings.cta_text }}
          </a>

        {% else %}

          <div class="iamw-proof__cta iamw-proof__cta--disabled">
            {{ section.settings.cta_text }}
          </div>

        {% endif %}

      {% endif %}



      {% comment %}
        TRUST ROWS
      {% endcomment %}

      {% assign has_trust_items = false %}

      {% for block in section.blocks %}

        {% if block.type == 'trust_item' %}

          {% if block.settings.text != blank %}
            {% assign has_trust_items = true %}
          {% endif %}

        {% endif %}

      {% endfor %}


      {% if has_trust_items %}

        <div class="iamw-proof__trust-list">

          {% for block in section.blocks %}

            {% if block.type == 'trust_item' %}

              {% if block.settings.text != blank %}

                <div
                  class="iamw-proof__trust-item"
                  {{ block.shopify_attributes }}
                >

                  {% if block.settings.icon_image != blank %}

                    <span
                      class="iamw-proof__trust-icon"
                      style="
                        width: {{ block.settings.icon_size }}px;
                        height: {{ block.settings.icon_size }}px;
                      "
                    >

                      {{
                        block.settings.icon_image
                        | image_url: width: 160
                        | image_tag:
                          loading: 'lazy',
                          class: 'iamw-proof__icon-image'
                      }}

                    </span>

                  {% elsif block.settings.icon_svg != blank %}

                    <span
                      class="iamw-proof__trust-icon iamw-proof__svg"
                      style="
                        width: {{ block.settings.icon_size }}px;
                        height: {{ block.settings.icon_size }}px;
                      "
                    >
                      {{ block.settings.icon_svg }}
                    </span>

                  {% endif %}


                  <div class="iamw-proof__trust-text">

                    {% if block.settings.bold_text != blank %}

                      <strong>
                        {{ block.settings.bold_text }}
                      </strong>

                    {% endif %}

                    {{ block.settings.text }}

                  </div>

                </div>

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}



      {% comment %}
        REVIEW CARDS
      {% endcomment %}

      {% assign has_reviews = false %}

      {% for block in section.blocks %}

        {% if block.type == 'review' %}

          {% if block.settings.quote != blank %}
            {% assign has_reviews = true %}
          {% endif %}

        {% endif %}

      {% endfor %}


      {% if has_reviews %}

        <div class="iamw-proof__reviews">

          {% for block in section.blocks %}

            {% if block.type == 'review' %}

              {% if block.settings.quote != blank %}

                <article
                  class="iamw-proof__review"
                  {{ block.shopify_attributes }}
                >

                  <div class="iamw-proof__review-quote">
                    {{ block.settings.quote }}
                  </div>


                  <div class="iamw-proof__review-footer">

                    <div class="iamw-proof__reviewer">

                      {% if block.settings.name != blank %}

                        <strong>
                          {{ block.settings.name }}
                        </strong>

                      {% endif %}


                      {% if block.settings.verified_text != blank %}

                        <span class="iamw-proof__verified">
                          {{ block.settings.verified_text }}
                        </span>

                      {% endif %}

                    </div>


                    {% if block.settings.stars != blank %}

                      <div class="iamw-proof__review-stars">
                        {{ block.settings.stars }}
                      </div>

                    {% endif %}

                  </div>

                </article>

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}

    </div>



    {% comment %}
      REQUIRED VISUAL
    {% endcomment %}

    <div class="iamw-proof__media">

      {% if section.settings.image != blank %}

        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            loading: 'lazy',
            widths: '480,720,960,1200,1600,1800',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'iamw-proof__image'
        }}

      {% else %}

        <div class="iamw-proof__placeholder">
          <span>
            ADD PRODUCT + HEALTHY FOOD LIFESTYLE IMAGE
          </span>
        </div>

      {% endif %}

    </div>

  </div>

</section>


