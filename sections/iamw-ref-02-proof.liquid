</style>


<script>

(function() {

  function initIAMWProofAnchorLinks() {

    const section =
      document.getElementById(
        'IAMW-PROOF-{{ section.id }}'
      );

    if (!section) return;


    const anchorLinks =
      section.querySelectorAll(
        '[data-iamw-anchor-link]'
      );


    anchorLinks.forEach(
      function(link) {

        if (
          link.dataset.iamwAnchorReady ===
          'true'
        ) {
          return;
        }


        link.dataset.iamwAnchorReady =
          'true';


        link.addEventListener(
          'click',
          function(event) {

            const href =
              link.getAttribute(
                'href'
              );


            if (
              !href ||
              href.charAt(0) !== '#'
            ) {
              return;
            }


            const target =
              document.querySelector(
                href
              );


            if (!target) {

              /*
                If the anchor is not found,
                allow normal browser behavior.
              */

              return;

            }


            event.preventDefault();


            target.scrollIntoView({
              behavior:
                'smooth',

              block:
                'start'
            });


            if (
              window.history &&
              window.history.replaceState
            ) {

              window.history.replaceState(
                null,
                '',
                href
              );

            }

          }
        );

      }
    );

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initIAMWProofAnchorLinks
    );

  } else {

    initIAMWProofAnchorLinks();

  }


  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.target &&
        event.target.id ===
        'IAMW-PROOF-{{ section.id }}'
      ) {

        initIAMWProofAnchorLinks();

      }

    }
  );

})();

</script>


{% schema %}

{
  "name": "IAMW Proof Story",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "rating_stars",
      "label": "Stars",
      "default": "★★★★★"
    },

    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Real feedback from I Am Well moms"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "From pihikan kumain to a smarter daily nutrition routine."
    },

    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Kung bawat meal ay may pilitan, habulan, at negotiation, you’re not alone. Smart Gummies gives picky eaters convenient daily support for appetite, healthy growth, focus, immunity and digestion in one kid-friendly mixed berry gummy.</p>"
    },


    {
      "type": "header",
      "content": "CTA"
    },

    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "HELP MY CHILD EAT BETTER"
    },

    {
      "type": "select",
      "id": "cta_destination",
      "label": "CTA destination",
      "default": "anchor",
      "options": [
        {
          "value": "anchor",
          "label": "Scroll to section"
        },
        {
          "value": "link",
          "label": "Regular link"
        }
      ]
    },

    {
      "type": "text",
      "id": "cta_anchor",
      "label": "Anchor ID",
      "default": "iamw-product",
      "info": "Enter the section anchor without the # symbol."
    },

    {
      "type": "url",
      "id": "cta_link",
      "label": "Regular link"
    },


    {
      "type": "header",
      "content": "Main image"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Product + healthy food image"
    },

    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },

    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image height",
      "min": 400,
      "max": 900,
      "step": 20,
      "default": 620,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 280,
      "max": 650,
      "step": 10,
      "default": 420,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "page_width",
      "label": "Max page width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1260,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_x",
