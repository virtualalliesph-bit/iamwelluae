{% comment %}
  I AM WELL
  Reference Section 08
  Why Choose Smart Gummies

  Structure:
  - Center heading
  - Required image / visual on left
  - Accordion stack on right
  - Optional icon image or SVG per accordion
  - CTA underneath
  - Optional trust note
{% endcomment %}

<section
  id="IAMW-WHY-{{ section.id }}"
  class="iamw-why"
  style="
    --page-width: {{ section.settings.page_width }}px;

    --pad-x: {{ section.settings.padding_x }}px;
    --pad-x-mobile: {{ section.settings.mobile_padding_x }}px;

    --pad-top: {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;

    --section-gap: {{ section.settings.section_gap }}px;
    --column-gap: {{ section.settings.column_gap }}px;
    --accordion-gap: {{ section.settings.accordion_gap }}px;

    --radius: {{ section.settings.radius }}px;

    --background: {{ section.settings.background }};
    --purple: {{ section.settings.purple }};
    --orange: {{ section.settings.orange }};
    --soft-bg: {{ section.settings.soft_background }};
    --image-bg: {{ section.settings.image_background }};
    --text: {{ section.settings.text_color }};
    --muted: {{ section.settings.muted }};
    --border: {{ section.settings.border_color }};

    --heading-size: {{ section.settings.heading_size }}px;
    --body-size: {{ section.settings.body_size }}px;
    --accordion-title-size: {{ section.settings.accordion_title_size }}px;

    --heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --body-mobile: {{ section.settings.mobile_body_size }}px;
    --accordion-title-mobile: {{ section.settings.mobile_accordion_title_size }}px;
  "
>

  <div class="iamw-why__shell">

    {% if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.intro != blank
    %}
      <div class="iamw-why__head">

        {% if section.settings.eyebrow != blank %}
          <div class="iamw-why__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="iamw-why__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="iamw-why__rte iamw-why__intro">
            {{ section.settings.intro }}
          </div>
        {% endif %}

      </div>
    {% endif %}


    <div class="iamw-why__grid">

      {% comment %}
        REQUIRED LEFT VISUAL
      {% endcomment %}

      <div class="iamw-why__media">

        {% if section.settings.image != blank %}

          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '480,720,960,1200,1600',
              sizes: '(min-width: 990px) 48vw, 100vw',
              class: 'iamw-why__image'
          }}

        {% else %}

          <div class="iamw-why__placeholder">
            <span>ADD PRODUCT / WHY SMART GUMMIES VISUAL</span>
          </div>

        {% endif %}

      </div>


      {% assign has_accordion = false %}

      {% for block in section.blocks %}
        {% if block.type == 'accordion' %}
          {% if block.settings.title != blank %}
            {% assign has_accordion = true %}
          {% endif %}
        {% endif %}
      {% endfor %}


      {% if has_accordion %}

        <div class="iamw-why__accordions">

          {% for block in section.blocks %}

            {% if block.type == 'accordion' %}

              {% if block.settings.title != blank %}

                <details
                  class="iamw-why__accordion"
                  {% if block.settings.open_by_default %}open{% endif %}
                  {{ block.shopify_attributes }}
                >

                  <summary class="iamw-why__summary">

                    <div class="iamw-why__summary-left">

                      {% if block.settings.icon_image != blank %}

                        <span
                          class="iamw-why__icon-wrap"
                          style="
                            width: {{ block.settings.icon_size }}px;
                            height: {{ block.settings.icon_size }}px;
                          "
                        >
                          {{
                            block.settings.icon_image
                            | image_url: width: 180
                            | image_tag:
                              loading: 'lazy',
                              class: 'iamw-why__icon-image'
                          }}
                        </span>

                      {% elsif block.settings.icon_svg != blank %}

                        <span
                          class="iamw-why__icon-wrap iamw-why__svg"
                          style="
                            width: {{ block.settings.icon_size }}px;
                            height: {{ block.settings.icon_size }}px;
                          "
                        >
                          {{ block.settings.icon_svg }}
                        </span>

                      {% endif %}

                      <span class="iamw-why__accordion-title">
                        {{ block.settings.title }}
                      </span>

                    </div>


                    <span class="iamw-why__toggle">
                      <span class="iamw-why__toggle-mark">
                        ↓
                      </span>
                    </span>

                  </summary>


                  {% if block.settings.text != blank %}

                    <div class="iamw-why__accordion-body">
                      <div class="iamw-why__rte">
                        {{ block.settings.text }}
                      </div>
                    </div>

                  {% endif %}

                </details>

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}

    </div>


    {% if section.settings.cta_text != blank
      or section.settings.trust_text != blank
    %}

      <div class="iamw-why__bottom">

        {% if section.settings.cta_text != blank %}

          {% if section.settings.cta_link != blank %}

            <a
              href="{{ section.settings.cta_link }}"
              class="iamw-why__cta"
            >
              {{ section.settings.cta_text }}
            </a>

          {% else %}

            <div class="iamw-why__cta iamw-why__cta--disabled">
              {{ section.settings.cta_text }}
            </div>

          {% endif %}

        {% endif %}


        {% if section.settings.trust_text != blank %}

          <div class="iamw-why__trust">

            {% if section.settings.trust_icon != blank %}

              <span
                class="iamw-why__trust-icon"
                style="
                  width: {{ section.settings.trust_icon_size }}px;
                  height: {{ section.settings.trust_icon_size }}px;
                "
              >
                {{
                  section.settings.trust_icon
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    class: 'iamw-why__trust-image'
                }}
              </span>

            {% elsif section.settings.trust_svg != blank %}

              <span
                class="iamw-why__trust-icon iamw-why__svg"
                style="
                  width: {{ section.settings.trust_icon_size }}px;
                  height: {{ section.settings.trust_icon_size }}px;
                "
              >
                {{ section.settings.trust_svg }}
              </span>

            {% endif %}

            <span>
              {{ section.settings.trust_text }}
            </span>

          </div>

        {% endif %}

      </div>

    {% endif %}

  </div>

</section>


<style>

#IAMW-WHY-{{ section.id }} {
  width: 100%;
  padding:
    var(--pad-top)
    var(--pad-x)
    var(--pad-bottom);
  background: var(--background);
  color: var(--text);
}


#IAMW-WHY-{{ section.id }} * {
  box-sizing: border-box;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__shell {
  width: 100%;
  max-width: var(--page-width);
  margin: 0 auto;

  display: flex;
  flex-direction: column;
  gap: var(--section-gap);
}


#IAMW-WHY-{{ section.id }}
.iamw-why__head {
  max-width: 980px;
  margin: 0 auto;

  display: flex;
  flex-direction: column;
  gap: 12px;

  text-align: center;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__eyebrow {
  color: var(--purple);

  font-size:
    calc(var(--body-size) * .78);

  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__heading {
  margin: 0;

  color: var(--text);

  font-size: var(--heading-size);

  line-height: 1.08;

  letter-spacing: -.025em;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__rte {
  color: var(--text);

  font-size: var(--body-size);

  line-height: 1.65;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__rte p:first-child {
  margin-top: 0;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__rte p:last-child {
  margin-bottom: 0;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__grid {
  display: grid;

  grid-template-columns:
    minmax(0, .95fr)
    minmax(0, 1.05fr);

  gap: var(--column-gap);

  align-items: stretch;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__media {
  min-height:
    {{ section.settings.image_height }}px;

  overflow: hidden;

  background:
    var(--image-bg);

  border-radius:
    var(--radius);
}


#IAMW-WHY-{{ section.id }}
.iamw-why__image {
  width: 100%;
  height: 100%;

  display: block;

  object-fit:
    {{ section.settings.image_fit }};
}


#IAMW-WHY-{{ section.id }}
.iamw-why__placeholder {
  width: 100%;

  min-height:
    {{ section.settings.image_height }}px;

  display: grid;
  place-items: center;

  padding: 32px;

  background:
    linear-gradient(
      135deg,
      rgba(66,16,107,.05),
      rgba(255,157,22,.11)
    );

  border:
    2px dashed rgba(66,16,107,.22);

  color:
    var(--muted);

  text-align: center;

  font-size:
    calc(var(--body-size) * .85);

  font-weight: 800;

  letter-spacing: .06em;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__accordions {
  display: flex;
  flex-direction: column;

  gap:
    var(--accordion-gap);
}


#IAMW-WHY-{{ section.id }}
.iamw-why__accordion {
  overflow: hidden;

  background: #fff;

  border:
    1px solid var(--border);

  border-radius:
    calc(var(--radius) * .65);
}


#IAMW-WHY-{{ section.id }}
.iamw-why__summary {
  min-height: 70px;

  padding:
    14px 16px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 16px;

  list-style: none;

  cursor: pointer;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__summary::-webkit-details-marker {
  display: none;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__summary-left {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 14px;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__icon-wrap {
  flex: 0 0 auto;

  display: grid;
  place-items: center;

  padding: 6px;

  border-radius: 50%;

  background:
    var(--soft-bg);
}


#IAMW-WHY-{{ section.id }}
.iamw-why__icon-image {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: contain;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__svg svg {
  width: 100%;
  height: 100%;

  display: block;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__accordion-title {
  color: var(--text);

  font-size:
    var(--accordion-title-size);

  font-weight: 800;

  line-height: 1.3;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__toggle {
  flex: 0 0 auto;

  width: 30px;
  height: 30px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    var(--purple);

  color: #fff;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__toggle-mark {
  display: block;

  font-size: 17px;
  line-height: 1;

  transition:
    transform .2s ease;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__accordion[open]
.iamw-why__toggle-mark {
  transform: rotate(180deg);
}


#IAMW-WHY-{{ section.id }}
.iamw-why__accordion-body {
  padding:
    0 16px 18px 16px;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__bottom {
  display: flex;
  flex-direction: column;

  align-items: center;

  gap: 16px;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__cta {
  min-height: 52px;

  padding:
    14px 28px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  background:
    var(--orange);

  color: #111;

  border-radius:
    10px;

  text-decoration: none;

  text-align: center;

  font-size:
    var(--body-size);

  font-weight: 900;

  line-height: 1.2;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__cta--disabled {
  cursor: default;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__trust {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 10px;

  color:
    var(--text);

  font-size:
    calc(var(--body-size) * .85);

  line-height: 1.4;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__trust-icon {
  flex: 0 0 auto;

  display: block;
}


#IAMW-WHY-{{ section.id }}
.iamw-why__trust-image {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: contain;
}


@media screen and (max-width: 989px) {

  #IAMW-WHY-{{ section.id }} {
    padding-left:
      var(--pad-x-mobile);

    padding-right:
      var(--pad-x-mobile);
  }


  #IAMW-WHY-{{ section.id }}
  .iamw-why__heading {
    font-size:
      var(--heading-mobile);
  }


  #IAMW-WHY-{{ section.id }}
  .iamw-why__rte {
    font-size:
      var(--body-mobile);
  }


  #IAMW-WHY-{{ section.id }}
  .iamw-why__accordion-title {
    font-size:
      var(--accordion-title-mobile);
  }


  #IAMW-WHY-{{ section.id }}
  .iamw-why__grid {
    grid-template-columns:
      1fr;
  }


  #IAMW-WHY-{{ section.id }}
  .iamw-why__media,

  #IAMW-WHY-{{ section.id }}
  .iamw-why__placeholder {
    min-height:
      {{ section.settings.mobile_image_height }}px;
  }

}

</style>


{% schema %}

{
  "name": "IAMW Why Choose",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY MOMS CHOOSE SMART GUMMIES"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "One daily gummy routine. Multiple ways to support your growing child."
    },

    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Made for real family routines, especially when picky eating makes everyday nutrition feel harder.</p>"
    },


    {
      "type": "header",
      "content": "Main visual"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Product / why choose image"
    },

    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },

    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image height",
      "min": 420,
      "max": 900,
      "step": 20,
      "default": 600,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 260,
      "max": 640,
      "step": 20,
      "default": 400,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "CTA"
    },

    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "START THEIR SMART ROUTINE"
    },

    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },

    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust line",
      "default": "Kid-friendly mixed berry gummy • Food supplement"
    },

    {
      "type": "image_picker",
      "id": "trust_icon",
      "label": "Optional trust icon"
    },

    {
      "type": "html",
      "id": "trust_svg",
      "label": "Or paste trust SVG"
    },

    {
      "type": "range",
      "id": "trust_icon_size",
      "label": "Trust icon size",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 24,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "page_width",
      "label": "Max page width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1260,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_x",
      "label": "Desktop side padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_padding_x",
      "label": "Mobile side padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 52,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 52,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "section_gap",
      "label": "Section gap",
      "min": 16,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 16,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "accordion_gap",
      "label": "Accordion gap",
      "min": 6,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 30,
      "max": 64,
      "step": 2,
      "default": 42,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "accordion_title_size",
      "label": "Accordion title size",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 17,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 26,
      "max": 48,
      "step": 2,
      "default": 34,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "Mobile body size",
      "min": 14,
      "max": 22,
      "step": 1,
      "default": 16,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_accordion_title_size",
      "label": "Mobile accordion title",
      "min": 14,
      "max": 22,
      "step": 1,
      "default": 16,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F7EFFB"
    },

    {
      "type": "color",
      "id": "purple",
      "label": "IAMW purple",
      "default": "#42106B"
    },

    {
      "type": "color",
      "id": "orange",
      "label": "Accent orange",
      "default": "#FF9D16"
    },

    {
      "type": "color",
      "id": "soft_background",
      "label": "Icon background",
      "default": "#FFF4D6"
    },

    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#FFF4D6"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1C1930"
    },

    {
      "type": "color",
      "id": "muted",
      "label": "Muted text",
      "default": "#6C6670"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Accordion border",
      "default": "#DCCFE5"
    }

  ],


  "blocks": [

    {
      "type": "accordion",
      "name": "Why choose item",

      "settings": [

        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        },

        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },

        {
          "type": "html",
          "id": "icon_svg",
          "label": "Or paste SVG"
        },

        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon size",
          "min": 24,
          "max": 70,
          "step": 2,
          "default": 40,
          "unit": "px"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Helps Support Appetite"
        },

        {
          "type": "richtext",
          "id": "text",
          "label": "Body",
          "default": "<p>Add supporting information here.</p>"
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "IAMW Why Choose",

      "blocks": [

        {
          "type": "accordion",
          "settings": {
            "title": "Helps Support Appetite for Picky Eaters",
            "text": "<p>Smart Gummies includes L-Lysine plus vitamins and minerals to help support appetite and everyday nutrition, especially when picky eating makes food variety difficult.</p>",
            "icon_size": 40,
            "open_by_default": true
