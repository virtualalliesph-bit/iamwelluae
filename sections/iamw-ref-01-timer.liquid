{% comment %}
  I AM WELL
  Reference Section 01
  Countdown Timer Strip

  Features:
  - Editable offer heading/subheading
  - Countdown to custom date/time
  - Hours can exceed 24 for multi-day countdowns
  - Adjustable desktop/mobile sizes
  - Adjustable padding, width and gaps
  - Editable IAMW colors
  - Empty heading/subheading leaves no blank space
{% endcomment %}

<section
  id="IAMW-TIMER-{{ section.id }}"
  class="iamw-timer"
  data-iamw-countdown
  data-end-time="{{ section.settings.end_time | escape }}"
  style="
    --page-width: {{ section.settings.page_width }}px;

    --pad-x: {{ section.settings.padding_x }}px;
    --pad-x-mobile: {{ section.settings.mobile_padding_x }}px;

    --pad-top: {{ section.settings.padding_top }}px;
    --pad-bottom: {{ section.settings.padding_bottom }}px;

    --content-gap: {{ section.settings.content_gap }}px;
    --timer-gap: {{ section.settings.timer_gap }}px;

    --background: {{ section.settings.background }};
    --box-background: {{ section.settings.box_background }};
    --text: {{ section.settings.text_color }};
    --accent: {{ section.settings.accent_color }};

    --heading-size: {{ section.settings.heading_size }}px;
    --subheading-size: {{ section.settings.subheading_size }}px;

    --number-size: {{ section.settings.number_size }}px;
    --label-size: {{ section.settings.label_size }}px;

    --heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --subheading-mobile: {{ section.settings.mobile_subheading_size }}px;
    --number-mobile: {{ section.settings.mobile_number_size }}px;
    --label-mobile: {{ section.settings.mobile_label_size }}px;

    --box-width: {{ section.settings.box_width }}px;
    --box-height: {{ section.settings.box_height }}px;
    --box-radius: {{ section.settings.box_radius }}px;
  "
>

  <div class="iamw-timer__inner">

    {% if section.settings.heading != blank or section.settings.subheading != blank %}

      <div class="iamw-timer__message">

        {% if section.settings.heading != blank %}
          <div class="iamw-timer__heading">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="iamw-timer__subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}

      </div>

    {% endif %}


    <div
      class="iamw-timer__countdown"
      aria-label="Offer countdown"
    >

      <div class="iamw-timer__box">

        <div
          class="iamw-timer__number"
          data-iamw-hours
        >
          00
        </div>

        <div class="iamw-timer__label">
          HRS
        </div>

      </div>


      <div class="iamw-timer__box">

        <div
          class="iamw-timer__number"
          data-iamw-minutes
        >
          00
        </div>

        <div class="iamw-timer__label">
          MIN
        </div>

      </div>


      <div class="iamw-timer__box">

        <div
          class="iamw-timer__number"
          data-iamw-seconds
        >
          00
        </div>

        <div class="iamw-timer__label">
          SEC
        </div>

      </div>

    </div>

  </div>

</section>


<style>

#IAMW-TIMER-{{ section.id }} {

  width:
    100%;

  padding:
    var(--pad-top)
    var(--pad-x)
    var(--pad-bottom);

  background:
    var(--background);

  color:
    var(--text);
}


#IAMW-TIMER-{{ section.id }} * {

  box-sizing:
    border-box;
}


#IAMW-TIMER-{{ section.id }}
.iamw-timer__inner {

  width:
    100%;

  max-width:
    var(--page-width);

  margin:
    0 auto;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    var(--content-gap);
}


#IAMW-TIMER-{{ section.id }}
.iamw-timer__message {

  display:
    flex;

  flex-direction:
    column;

  gap:
    4px;

  color:
    var(--text);
}


#IAMW-TIMER-{{ section.id }}
.iamw-timer__heading {

  margin:
    0;

  color:
    var(--text);

  font-size:
    var(--heading-size);

  font-weight:
    800;

  line-height:
    1.15;

  letter-spacing:
    .01em;
}


#IAMW-TIMER-{{ section.id }}
.iamw-timer__subheading {

  color:
    var(--text);

  font-size:
    var(--subheading-size);

  font-weight:
    500;

  line-height:
    1.25;

  letter-spacing:
    .02em;
}


#IAMW-TIMER-{{ section.id }}
.iamw-timer__countdown {

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    var(--timer-gap);
}


#IAMW-TIMER-{{ section.id }}
.iamw-timer__box {

  width:
    var(--box-width);

  min-width:
    var(--box-width);

  height:
    var(--box-height);

  padding:
    8px 6px;

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  justify-content:
    center;

  gap:
    2px;

  background:
    var(--box-background);

  color:
    var(--text);

  border-radius:
    var(--box-radius);

  box-shadow:
    0 4px 0 rgba(0, 0, 0, .08);
}


#IAMW-TIMER-{{ section.id }}
.iamw-timer__number {

  color:
    var(--text);

  font-size:
    var(--number-size);

  font-weight:
    900;

  line-height:
    1;

  letter-spacing:
    .04em;

  font-variant-numeric:
    tabular-nums;
}


#IAMW-TIMER-{{ section.id }}
.iamw-timer__label {

  color:
    var(--text);

  font-size:
    var(--label-size);

  font-weight:
    800;

  line-height:
    1.05;

  letter-spacing:
    .08em;
}


#IAMW-TIMER-{{ section.id }}
.iamw-timer__box:first-child {

  border-top:
    3px solid var(--accent);
}


@media screen and (max-width: 749px) {

  #IAMW-TIMER-{{ section.id }} {

    padding-left:
      var(--pad-x-mobile);

    padding-right:
      var(--pad-x-mobile);
  }


  #IAMW-TIMER-{{ section.id }}
  .iamw-timer__inner {

    flex-direction:
      column;

    gap:
      12px;
  }


  #IAMW-TIMER-{{ section.id }}
  .iamw-timer__message {

    align-items:
      center;

    text-align:
      center;
  }


  #IAMW-TIMER-{{ section.id }}
  .iamw-timer__heading {

    font-size:
      var(--heading-mobile);
  }


  #IAMW-TIMER-{{ section.id }}
  .iamw-timer__subheading {

    font-size:
      var(--subheading-mobile);
  }


  #IAMW-TIMER-{{ section.id }}
  .iamw-timer__number {

    font-size:
      var(--number-mobile);
  }


  #IAMW-TIMER-{{ section.id }}
  .iamw-timer__label {

    font-size:
      var(--label-mobile);
  }


  #IAMW-TIMER-{{ section.id }}
  .iamw-timer__box {

    width:
      calc(var(--box-width) * .82);

    min-width:
      calc(var(--box-width) * .82);

    height:
      calc(var(--box-height) * .82);
  }

}

</style>


<script>

(function() {

  function initIAMWCountdown() {

    const section =
      document.getElementById(
        'IAMW-TIMER-{{ section.id }}'
      );

    if (!section) return;


    const endTimeRaw =
      section.getAttribute(
        'data-end-time'
      );


    const hoursEl =
      section.querySelector(
        '[data-iamw-hours]'
      );

    const minutesEl =
      section.querySelector(
        '[data-iamw-minutes]'
      );

    const secondsEl =
      section.querySelector(
        '[data-iamw-seconds]'
      );


    if (
      !hoursEl ||
      !minutesEl ||
      !secondsEl
    ) {
      return;
    }


    function setZero() {

      hoursEl.textContent =
        '00';

      minutesEl.textContent =
        '00';

      secondsEl.textContent =
        '00';
    }


    if (!endTimeRaw) {

      setZero();

      return;
    }


    const endTime =
      new Date(endTimeRaw).getTime();


    if (isNaN(endTime)) {

      setZero();

      return;
    }


    function pad(value) {

      return String(value)
        .padStart(2, '0');

    }


    function updateTimer() {

      const now =
        new Date().getTime();


      let distance =
        endTime - now;


      if (distance <= 0) {

        setZero();

        return false;
      }


      const totalHours =
        Math.floor(
          distance /
          (1000 * 60 * 60)
        );


      const minutes =
        Math.floor(
          (
            distance %
            (1000 * 60 * 60)
          ) /
          (1000 * 60)
        );


      const seconds =
        Math.floor(
          (
            distance %
            (1000 * 60)
          ) /
          1000
        );


      hoursEl.textContent =
        pad(totalHours);


      minutesEl.textContent =
        pad(minutes);


      secondsEl.textContent =
        pad(seconds);


      return true;

    }


    updateTimer();


    const interval =
      setInterval(
        function() {

          const active =
            updateTimer();


          if (!active) {

            clearInterval(
              interval
            );

          }

        },
        1000
      );

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initIAMWCountdown
    );

  } else {

    initIAMWCountdown();

  }


  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.target &&
        event.target.querySelector(
          '[data-iamw-countdown]'
        )
      ) {

        initIAMWCountdown();

      }

    }
  );

})();

</script>


{% schema %}

{
  "name": "IAMW Countdown",

  "settings": [

    {
      "type": "header",
      "content": "Offer"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Special Offer"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited Offer Ends In:"
    },

    {
      "type": "text",
      "id": "end_time",
      "label": "Countdown end date/time",
      "default": "2026-09-30T23:59:59+08:00",
      "info": "Use format: YYYY-MM-DDTHH:MM:SS+08:00 for Philippine time."
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "page_width",
      "label": "Max content width",
      "min": 700,
      "max": 1600,
      "step": 20,
      "default": 1000,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_x",
      "label": "Desktop side padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_padding_x",
      "label": "Mobile side padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 8,
      "max": 80,
      "step": 2,
      "default": 16,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 8,
      "max": 80,
      "step": 2,
      "default": 16,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "content_gap",
      "label": "Text to timer gap",
      "min": 12,
      "max": 100,
      "step": 4,
      "default": 52,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "timer_gap",
      "label": "Gap between timer boxes",
      "min": 4,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Timer boxes"
    },

    {
      "type": "range",
      "id": "box_width",
      "label": "Box width",
      "min": 54,
      "max": 120,
      "step": 2,
      "default": 74,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "box_height",
      "label": "Box height",
      "min": 60,
      "max": 130,
      "step": 2,
      "default": 76,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "box_radius",
      "label": "Box corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Desktop typography"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 36,
      "step": 1,
      "default": 20,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 18,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "number_size",
      "label": "Timer number size",
      "min": 18,
      "max": 42,
      "step": 1,
      "default": 26,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "label_size",
      "label": "HRS / MIN / SEC size",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Mobile typography"
    },

    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 30,
      "step": 1,
      "default": 18,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 26,
      "step": 1,
      "default": 15,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_number_size",
      "label": "Timer number size",
      "min": 16,
      "max": 34,
      "step": 1,
      "default": 22,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_label_size",
      "label": "Timer label size",
      "min": 9,
      "max": 20,
      "step": 1,
      "default": 12,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background",
      "label": "Strip background",
      "default": "#42106B"
    },

    {
      "type": "color",
      "id": "box_background",
      "label": "Timer box",
      "default": "#2A0848"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FF9D16"
    }

  ],

  "presets": [

    {
      "name": "IAMW Countdown"
    }

  ]

}

{% endschema %}