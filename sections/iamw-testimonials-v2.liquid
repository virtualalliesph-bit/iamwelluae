<section class="iamw-brain-section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};">
  <div class="iamw-brain-wrap">
    {% if section.settings.eyebrow != blank %}<div class="iamw-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="iamw-heading">{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.subheading != blank %}<div class="iamw-copy">{{ section.settings.subheading }}</div>{% endif %}

    <div style="display:grid;gap:16px;margin-top:24px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));">
      {% for block in section.blocks %}
        <article class="iamw-brain-card" style="padding:20px;" {{ block.shopify_attributes }}>
          <div style="color:#ff9a1f;margin-bottom:10px;">★★★★★</div>
          {% if block.settings.review != blank %}<p>{{ block.settings.review }}</p>{% endif %}
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: block.settings.parent_name }}
          {% endif %}
          {% if block.settings.parent_name != blank %}<strong>{{ block.settings.parent_name }}</strong>{% endif %}
          {% if block.settings.child_age != blank %}<div>{{ block.settings.child_age }}</div>{% endif %}
        </article>
      {% endfor %}

      {% if section.settings.review_4 != blank %}
        <article class="iamw-brain-card" style="padding:20px;">
          <div style="color:#ff9a1f;margin-bottom:10px;">★★★★★</div>
          <p>{{ section.settings.review_4 }}</p>
          <strong>{{ section.settings.review_4_name }}</strong>
          <div>{{ section.settings.extra_review_meta }}</div>
        </article>
      {% endif %}
      {% if section.settings.review_5 != blank %}
        <article class="iamw-brain-card" style="padding:20px;">
          <div style="color:#ff9a1f;margin-bottom:10px;">★★★★★</div>
          <p>{{ section.settings.review_5 }}</p>
          <strong>{{ section.settings.review_5_name }}</strong>
          <div>{{ section.settings.extra_review_meta }}</div>
        </article>
      {% endif %}
      {% if section.settings.review_6 != blank %}
        <article class="iamw-brain-card" style="padding:20px;">
          <div style="color:#ff9a1f;margin-bottom:10px;">★★★★★</div>
          <p>{{ section.settings.review_6 }}</p>
          <strong>{{ section.settings.review_6_name }}</strong>
          <div>{{ section.settings.extra_review_meta }}</div>
        </article>
      {% endif %}
      {% if section.settings.review_7 != blank %}
        <article class="iamw-brain-card" style="padding:20px;">
          <div style="color:#ff9a1f;margin-bottom:10px;">★★★★★</div>
          <p>{{ section.settings.review_7 }}</p>
          <strong>{{ section.settings.review_7_name }}</strong>
          <div>{{ section.settings.extra_review_meta }}</div>
        </article>
      {% endif %}
      {% if section.settings.review_8 != blank %}
        <article class="iamw-brain-card" style="padding:20px;">
          <div style="color:#ff9a1f;margin-bottom:10px;">★★★★★</div>
          <p>{{ section.settings.review_8 }}</p>
          <strong>{{ section.settings.review_8_name }}</strong>
          <div>{{ section.settings.extra_review_meta }}</div>
        </article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IAMW Testimonials",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"REAL FAMILIES. REAL PROGRESS."},
    {"type":"text","id":"heading","label":"Heading","default":"Parents love the difference they see in their kids."},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Real stories from IAMWELL families about focus, learning and everyday wins.</p>"},
    {"type":"color","id":"background","label":"Background","default":"#f4ebff"},
    {"type":"color","id":"text_color","label":"Text color","default":"#4b168f"},
    {"type":"header","content":"Additional review slots"},
    {"type":"textarea","id":"review_4","label":"Review 4","default":"It is a convenient way to complement balanced meals with a consistent daily nutrition routine for growing minds."},
    {"type":"text","id":"review_4_name","label":"Review 4 name","default":"Yasmin H."},
    {"type":"textarea","id":"review_5","label":"Review 5","default":"We wanted one simple routine instead of several different products, and this format is easy to keep consistent on school days."},
    {"type":"text","id":"review_5_name","label":"Review 5 name","default":"Farah N."},
    {"type":"textarea","id":"review_6","label":"Review 6","default":"The chewable format fits naturally into our morning routine without adding another syrup or tablet before school."},
    {"type":"text","id":"review_6_name","label":"Review 6 name","default":"Rania S."},
    {"type":"textarea","id":"review_7","label":"Review 7","default":"I like having a straightforward daily option that complements the balanced meals and routines we already prioritise at home."},
    {"type":"text","id":"review_7_name","label":"Review 7 name","default":"Huda A."},
    {"type":"textarea","id":"review_8","label":"Review 8","default":"For our family, the biggest advantage is how easy the routine is to remember during busy mornings, homework days and everyday activities."},
    {"type":"text","id":"review_8_name","label":"Review 8 name","default":"Salma T."},
    {"type":"text","id":"extra_review_meta","label":"Additional review note","default":"Placeholder - replace with approved review"}
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 3,
      "settings": [
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"textarea","id":"review","label":"Review","default":"Replace this sample with an approved IAMWELL customer review."},
        {"type":"text","id":"parent_name","label":"Parent name","default":"Customer name"},
        {"type":"text","id":"child_age","label":"Child age","default":"Child age"},
        {"type":"image_picker","id":"image","label":"Customer image"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "IAMW Testimonials",
      "blocks": [
        {"type":"testimonial"},
        {"type":"testimonial"},
        {"type":"testimonial"}
      ]
    }
  ]
}
{% endschema %}
