{% liquid
  assign review_count = section.blocks.size
  assign autoplay_duration = review_count | times: section.settings.autoplay_speed
  if autoplay_duration < 12
    assign autoplay_duration = 12
  endif
%}

<section
  id="iamw-review-loop-{{ section.id }}"
  class="iamw-review-loop"
  style="
    --iamw-review-bg: {{ section.settings.background }};
    --iamw-review-card-bg: {{ section.settings.card_background }};
    --iamw-review-text: {{ section.settings.text_color }};
    --iamw-review-muted: {{ section.settings.muted_color }};
    --iamw-review-purple: {{ section.settings.purple }};
    --iamw-review-border: {{ section.settings.border_color }};
    --iamw-review-gap: {{ section.settings.card_gap }}px;
    --iamw-review-card-width: {{ section.settings.card_width }}px;
    --iamw-review-card-width-mobile: {{ section.settings.card_width_mobile }}px;
    --iamw-review-radius: {{ section.settings.radius }}px;
    --iamw-review-duration: {{ autoplay_duration }}s;
  "
>
  <div class="iamw-review-loop__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="iamw-review-loop__header">
        {% if section.settings.eyebrow != blank %}
          <div class="iamw-review-loop__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="iamw-review-loop__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="iamw-review-loop__subheading rte">{{ section.settings.subheading }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if review_count > 0 %}
      <div class="iamw-review-loop__viewport{% if section.settings.autoplay %} is-autoplay{% endif %}">
        {% if section.settings.autoplay %}
          <div class="iamw-review-loop__marquee{% if section.settings.pause_on_hover %} pause-on-hover{% endif %}">
            {% for copy_index in (1..2) %}
              <div class="iamw-review-loop__group"{% if copy_index == 2 %} aria-hidden="true"{% endif %}>
                {% for block in section.blocks %}
                  <article class="iamw-review-card" {% if copy_index == 1 %}{{ block.shopify_attributes }}{% endif %}>
                    <div class="iamw-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                      {% for star in (1..5) %}
                        <span class="{% if star <= block.settings.rating %}is-filled{% endif %}" aria-hidden="true">★</span>
                      {% endfor %}
                    </div>

                    {% if block.settings.review != blank %}
                      <div class="iamw-review-card__quote">“{{ block.settings.review | escape }}”</div>
                    {% endif %}

                    {% if block.settings.name != blank or block.settings.location != blank %}
                      <div class="iamw-review-card__person">
                        {% if block.settings.name != blank %}
                          <strong>{{ block.settings.name | escape }}</strong>
                        {% endif %}
                        {% if block.settings.location != blank %}
                          <span>{{ block.settings.location | escape }}</span>
                        {% endif %}
                      </div>
                    {% endif %}
                  </article>
                {% endfor %}
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="iamw-review-loop__manual" tabindex="0" aria-label="Customer reviews">
            {% for block in section.blocks %}
              <article class="iamw-review-card" {{ block.shopify_attributes }}>
                <div class="iamw-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {% for star in (1..5) %}
                    <span class="{% if star <= block.settings.rating %}is-filled{% endif %}" aria-hidden="true">★</span>
                  {% endfor %}
                </div>

                {% if block.settings.review != blank %}
                  <div class="iamw-review-card__quote">“{{ block.settings.review | escape }}”</div>
                {% endif %}

                {% if block.settings.name != blank or block.settings.location != blank %}
                  <div class="iamw-review-card__person">
                    {% if block.settings.name != blank %}
                      <strong>{{ block.settings.name | escape }}</strong>
                    {% endif %}
                    {% if block.settings.location != blank %}
                      <span>{{ block.settings.location | escape }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="iamw-review-loop__empty">Add customer review blocks in the Theme Editor.</div>
    {% endif %}
  </div>
</section>

<style>
  #iamw-review-loop-{{ section.id }} {
    background: var(--iamw-review-bg);
    color: var(--iamw-review-text);
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__inner {
    width: min({{ section.settings.page_width }}px, 100%);
    margin: 0 auto;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__header {
    text-align: {{ section.settings.heading_alignment }};
    padding: 0 {{ section.settings.side_padding }}px;
    margin-bottom: {{ section.settings.header_gap }}px;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__eyebrow {
    color: var(--iamw-review-purple);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__heading {
    margin: 0;
    color: var(--iamw-review-text);
    font-size: clamp(26px, 3vw, {{ section.settings.heading_size }}px);
    line-height: 1.08;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__subheading {
    margin: 10px auto 0;
    color: var(--iamw-review-muted);
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.55;
    max-width: 760px;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__viewport {
    width: 100%;
    overflow: hidden;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__marquee {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: iamw-review-scroll-{{ section.id }} var(--iamw-review-duration) linear infinite;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__marquee.pause-on-hover:hover {
    animation-play-state: paused;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__group {
    display: flex;
    gap: var(--iamw-review-gap);
    flex: 0 0 auto;
    padding-right: var(--iamw-review-gap);
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__manual {
    display: flex;
    gap: var(--iamw-review-gap);
    overflow-x: auto;
    padding: 2px {{ section.settings.side_padding }}px 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-card {
    width: var(--iamw-review-card-width);
    flex: 0 0 var(--iamw-review-card-width);
    display: flex;
    flex-direction: column;
    min-height: {{ section.settings.card_min_height }}px;
    padding: {{ section.settings.card_padding }}px;
    border: 1px solid var(--iamw-review-border);
    border-radius: var(--iamw-review-radius);
    background: var(--iamw-review-card-bg);
    box-shadow: {% if section.settings.show_shadow %}0 8px 24px rgba(60, 10, 109, .08){% else %}none{% endif %};
    scroll-snap-align: start;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-card__stars {
    display: flex;
    gap: 3px;
    margin-bottom: 14px;
    font-size: 18px;
    line-height: 1;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-card__stars span {
    color: #d9d2de;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-card__stars span.is-filled {
    color: var(--iamw-review-purple);
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-card__quote {
    flex: 1;
    font-size: {{ section.settings.review_size }}px;
    line-height: 1.5;
    color: var(--iamw-review-text);
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-card__person {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--iamw-review-border);
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-card__person strong {
    color: var(--iamw-review-text);
    font-size: 14px;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-card__person span {
    color: var(--iamw-review-muted);
    font-size: 12px;
  }

  #iamw-review-loop-{{ section.id }} .iamw-review-loop__empty {
    margin: 0 {{ section.settings.side_padding }}px;
    padding: 24px;
    text-align: center;
    border: 1px dashed var(--iamw-review-border);
    border-radius: var(--iamw-review-radius);
    color: var(--iamw-review-muted);
  }

  @keyframes iamw-review-scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    #iamw-review-loop-{{ section.id }} .iamw-review-loop__marquee {
      animation: none;
    }
  }

  @media screen and (max-width: 749px) {
    #iamw-review-loop-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #iamw-review-loop-{{ section.id }} .iamw-review-loop__header {
      padding-left: {{ section.settings.side_padding_mobile }}px;
      padding-right: {{ section.settings.side_padding_mobile }}px;
    }

    #iamw-review-loop-{{ section.id }} .iamw-review-loop__manual {
      padding-left: {{ section.settings.side_padding_mobile }}px;
      padding-right: {{ section.settings.side_padding_mobile }}px;
    }

    #iamw-review-loop-{{ section.id }} .iamw-review-card {
      width: var(--iamw-review-card-width-mobile);
      flex-basis: var(--iamw-review-card-width-mobile);
    }

    #iamw-review-loop-{{ section.id }} .iamw-review-loop__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
  }
</style>

{% schema %}
{
  "name": "IAMW Review Loop",
  "tag": "section",
  "class": "section-iamw-review-loop",
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PARENT APPROVED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real routines. Real feedback. Real families."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>What parents are saying about I Am Well.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Desktop heading size",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 22,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Mobile heading size",
      "default": 30
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Seconds per review",
      "default": 5,
      "info": "Higher values make the loop move more slowly."
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Review cards"
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 240,
      "max": 440,
      "step": 10,
      "unit": "px",
      "label": "Desktop card width",
      "default": 320
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "min": 240,
      "max": 340,
      "step": 10,
      "unit": "px",
      "label": "Mobile card width",
      "default": 280
    },
    {
      "type": "range",
      "id": "card_min_height",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "label": "Minimum card height",
      "default": 220
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 16,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 22
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "review_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Review text size",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Show card shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1c1930"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text color",
      "default": "#6c6670"
    },
    {
      "type": "color",
      "id": "purple",
      "label": "Stars / accent color",
      "default": "#42106b"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#e5daeb"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Maximum width",
      "default": 1320
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Desktop side padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Mobile side padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "Great taste and easy to include in our daily routine."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Dubai, UAE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IAMW Review Loop",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "review": "My child actually looks forward to taking these every day. Easy routine and great taste.",
            "name": "Aisha R.",
            "location": "Dubai, UAE"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "review": "We’ve been very happy with the routine. Simple to give and my little one enjoys the gummies.",
            "name": "Fatima K.",
            "location": "Abu Dhabi, UAE"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "review": "A convenient daily supplement that fits easily into our family routine.",
            "name": "Mariam S.",
            "location": "Sharjah, UAE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
