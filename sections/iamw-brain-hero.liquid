
{{ 'iamw-brain-landing.css' | asset_url | stylesheet_tag }}
<section class="iamw-brain-section iamw-brain-hero" style="--iamw-bg:{{ section.settings.background }};--iamw-text:{{ section.settings.text_color }};--iamw-accent:{{ section.settings.accent_color }};--iamw-radius:{{ section.settings.border_radius }}px;--iamw-content:{{ section.settings.content_width }}px;--iamw-pad-desktop:{{ section.settings.padding_desktop }}px;--iamw-pad-mobile:{{ section.settings.padding_mobile }}px;--iamw-heading-desktop:{{ section.settings.heading_size_desktop }}px;--iamw-heading-mobile:{{ section.settings.heading_size_mobile }}px;{% if section.settings.button_color != blank %}--iamw-button:{{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}--iamw-button-text:{{ section.settings.button_text_color }};{% endif %}" >
  <div class="iamw-brain-wrap">
    <div class="iamw-brain-hero__card iamw-brain-card">
      <div class="iamw-brain-hero__copy">
        {% if section.settings.eyebrow != blank %}<div class="iamw-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
        {% if section.settings.heading != blank %}<h1 class="iamw-heading">{{ section.settings.heading }}</h1>{% endif %}
        {% if section.settings.description != blank %}<div class="iamw-copy iamw-muted">{{ section.settings.description }}</div>{% endif %}
        {% if section.settings.button_text != blank %}
          <a class="iamw-btn{% if section.settings.button_style == 'outline' %} iamw-btn--outline{% endif %}" href="{{ section.settings.button_link | default: '#brain-product-offer' }}">{{ section.settings.button_text }} <span aria-hidden="true">→</span></a>
        {% endif %}
        {% if section.blocks.size > 0 %}
          <div class="iamw-brain-hero__benefits">
            {% for block in section.blocks %}
              {% if block.settings.text != blank %}
                <div class="iamw-brain-hero__benefit" {{ block.shopify_attributes }}>
                  <div class="iamw-iconbox">
                    {% if block.settings.icon_image != blank %}
                      {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40,60,80', alt: block.settings.icon_alt }}
                    {% else %}
                      {% render 'iamw-icon', name: block.settings.icon, color: section.settings.text_color %}
                    {% endif %}
                  </div>
                  <span>{{ block.settings.text }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <div class="iamw-brain-hero__media">
        {% if section.settings.hero_image != blank %}
          <picture>
            {% if section.settings.mobile_image != blank %}
              <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
            {% endif %}
            {{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '720,960,1200,1500,1800', sizes: '(min-width: 768px) 50vw, 100vw', alt: section.settings.image_alt, class: 'iamw-brain-hero__image' }}
          </picture>
        {% else %}
          <div class="iamw-placeholder">Choose a hero image</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
<style>
#shopify-section-{{ section.id }} .iamw-brain-hero__card{display:grid;grid-template-columns:1fr;overflow:hidden}
#shopify-section-{{ section.id }} .iamw-brain-hero__copy{padding:28px;text-align:{{ section.settings.text_alignment }}}
#shopify-section-{{ section.id }} .iamw-brain-hero__copy .iamw-btn{margin-top:22px}
#shopify-section-{{ section.id }} .iamw-brain-hero__media{min-height:300px;background:#eee5f7}
#shopify-section-{{ section.id }} .iamw-brain-hero__image{display:block;width:100%;height:100%;min-height:300px;object-fit:cover;object-position:{{ section.settings.mobile_image_position }}}
#shopify-section-{{ section.id }} .iamw-brain-hero__benefits{display:grid;grid-template-columns:1fr;gap:12px;margin-top:22px}
#shopify-section-{{ section.id }} .iamw-brain-hero__benefit{display:flex;gap:10px;align-items:center;font-size:13px;font-weight:700;text-align:left}
#shopify-section-{{ section.id }} .iamw-brain-hero__benefit .iamw-iconbox img{width:24px;height:24px;object-fit:contain}
@media(min-width:768px){
  #shopify-section-{{ section.id }} .iamw-brain-hero__card{grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr)}
  #shopify-section-{{ section.id }} .iamw-brain-hero__copy{padding:54px 44px;display:flex;flex-direction:column;justify-content:center}
  #shopify-section-{{ section.id }} .iamw-brain-hero__image{min-height:520px;object-position:{{ section.settings.desktop_image_position }}}
  #shopify-section-{{ section.id }} .iamw-brain-hero__benefits{grid-template-columns:repeat(3,minmax(0,1fr))}
}
</style>

{% schema %}
{
  "name": "IAMW Brain Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BRIGHT MINDS. BRIGHTER DAYS."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Daily brain support for growing kids"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Nutritional support to help fuel focus, learning, memory and everyday brain development, because their tomorrow starts with today.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Optional mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Happy child with IAMWELL products"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        },
        {
          "value": "center top",
          "label": "Top"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        },
        {
          "value": "center top",
          "label": "Top"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5ecff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4b168f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ff9a1f"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 24,
      "max": 52,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Padding desktop",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Padding mobile",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#5a1aa8"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "options": [
            {
              "value": "brain",
              "label": "Brain"
            },
            {
              "value": "memory",
              "label": "Memory"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "book",
              "label": "Book"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            }
          ],
          "default": "brain"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon"
        },
        {
          "type": "text",
          "id": "icon_alt",
          "label": "Icon alt text"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text",
          "default": "Supports Focus & Learning"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "IAMW Brain Hero",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "brain",
            "text": "Supports Focus & Learning"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "memory",
            "text": "Helps Support Memory"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "text": "Everyday Nutrition Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
