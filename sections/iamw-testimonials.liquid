<section class="iamw-testimonials iamw-testimonials--{{ section.id }}">
  <div class="iamw-testimonials__inner">
    <header class="iamw-testimonials__header">
      {% if section.settings.eyebrow != blank %}<div class="iamw-testimonials__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.intro != blank %}<div class="iamw-testimonials__intro rte">{{ section.settings.intro }}</div>{% endif %}
    </header>

    <div class="iamw-testimonials__track">
      {% for block in section.blocks %}
        <article class="iamw-testimonial" {{ block.shopify_attributes }}>
          <div class="iamw-testimonial__stars">{{ block.settings.stars }}</div>
          <div class="iamw-testimonial__quote">{{ block.settings.quote }}</div>
          <div class="iamw-testimonial__author"><strong>{{ block.settings.name }}</strong>{% if block.settings.meta != blank %}<span>{{ block.settings.meta }}</span>{% endif %}</div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
.iamw-testimonials--{{ section.id }}{background:{{ section.settings.background }};padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;color:{{ section.settings.text_color }}}.iamw-testimonials--{{ section.id }} *{box-sizing:border-box}.iamw-testimonials--{{ section.id }} .iamw-testimonials__inner{max-width:1240px;margin:0 auto}.iamw-testimonials--{{ section.id }} .iamw-testimonials__header{text-align:center;max-width:840px;margin:0 auto 28px}.iamw-testimonials--{{ section.id }} .iamw-testimonials__eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:900;color:{{ section.settings.purple }};margin-bottom:8px}.iamw-testimonials--{{ section.id }} h2{font-size:clamp(32px,4vw,46px);line-height:1.05;letter-spacing:-.035em;margin:0}.iamw-testimonials--{{ section.id }} .iamw-testimonials__intro{color:{{ section.settings.muted }};margin-top:10px}.iamw-testimonials--{{ section.id }} .iamw-testimonials__track{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.iamw-testimonials--{{ section.id }} .iamw-testimonial{padding:20px;border:1px solid {{ section.settings.border_color }};border-radius:14px;background:#fff;display:flex;flex-direction:column;gap:12px;min-height:190px}.iamw-testimonials--{{ section.id }} .iamw-testimonial__stars{color:{{ section.settings.orange }};letter-spacing:2px}.iamw-testimonials--{{ section.id }} .iamw-testimonial__quote{font-size:14px;line-height:1.55;flex:1}.iamw-testimonials--{{ section.id }} .iamw-testimonial__author{display:flex;flex-direction:column;font-size:12px}.iamw-testimonials--{{ section.id }} .iamw-testimonial__author span{color:{{ section.settings.muted }}}
@media(max-width:899px){.iamw-testimonials--{{ section.id }}{padding-left:16px;padding-right:16px}.iamw-testimonials--{{ section.id }} .iamw-testimonials__track{display:flex;overflow:auto;scroll-snap-type:x mandatory}.iamw-testimonials--{{ section.id }} .iamw-testimonial{flex:0 0 78vw;scroll-snap-align:start}}
{% endstyle %}

{% schema %}
{
  "name":"IAMW Testimonials",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PARENT APPROVED"},
    {"type":"text","id":"heading","label":"Heading","default":"Real routines. Real feedback. Real families."},
    {"type":"richtext","id":"intro","label":"Intro"},
    {"type":"color","id":"background","label":"Background","default":"#ffffff"},
    {"type":"color","id":"purple","label":"Purple","default":"#42106b"},
    {"type":"color","id":"orange","label":"Orange","default":"#ff9d16"},
    {"type":"color","id":"text_color","label":"Text","default":"#17131f"},
    {"type":"color","id":"muted","label":"Muted text","default":"#655f69"},
    {"type":"color","id":"border_color","label":"Border","default":"#e6ddeb"},
    {"type":"range","id":"padding_top","label":"Top spacing","min":20,"max":120,"step":4,"unit":"px","default":48},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":20,"max":120,"step":4,"unit":"px","default":48}
  ],
  "blocks":[
    {"type":"testimonial","name":"Testimonial","limit":12,"settings":[
      {"type":"text","id":"stars","label":"Stars","default":"★★★★★"},
      {"type":"textarea","id":"quote","label":"Quote","default":"Add a verified customer review here."},
      {"type":"text","id":"name","label":"Customer name","default":"I Am Well parent"},
      {"type":"text","id":"meta","label":"Meta","default":"UAE"}
    ]}
  ],
  "presets":[{"name":"IAMW Testimonials","blocks":[{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"}]}]
}
{% endschema %}
