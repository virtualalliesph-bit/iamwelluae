{% doc %}
  @prompt
    create a multicolumn block that can be up to 6 columns. desktop can be set how many column, while mobile is carousel or slideshow and can be set how many column. each column would have an image
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multicolumn-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-multicolumn-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-multicolumn-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.column_gap }}px;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
  }

  .ai-multicolumn-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-multicolumn-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multicolumn-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-multicolumn-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-multicolumn-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-multicolumn-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-multicolumn-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-multicolumn-grid-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'carousel' %}
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: {{ block.settings.column_gap }}px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      {% else %}
        grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      {% endif %}
    }

    {% if block.settings.mobile_layout == 'carousel' %}
      .ai-multicolumn-grid-{{ ai_gen_id }}::-webkit-scrollbar {
        display: none;
      }

      .ai-multicolumn-column-{{ ai_gen_id }} {
        flex: 0 0 calc((100% - {{ block.settings.column_gap }}px * ({{ block.settings.columns_mobile }} - 1)) / {{ block.settings.columns_mobile }});
        scroll-snap-align: start;
      }
    {% endif %}
  }
{% endstyle %}

<multicolumn-block-{{ ai_gen_id }}
  class="ai-multicolumn-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-multicolumn-container-{{ ai_gen_id }}">
    <div class="ai-multicolumn-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign column_enabled_key = 'column_' | append: i | append: '_enabled'
          assign column_image_key = 'column_' | append: i | append: '_image'
          assign column_heading_key = 'column_' | append: i | append: '_heading'
          assign column_text_key = 'column_' | append: i | append: '_text'

          assign column_enabled = block.settings[column_enabled_key]
          assign column_image = block.settings[column_image_key]
          assign column_heading = block.settings[column_heading_key]
          assign column_text = block.settings[column_text_key]
        %}

        {% if column_enabled %}
          <div class="ai-multicolumn-column-{{ ai_gen_id }}">
            <div class="ai-multicolumn-image-wrapper-{{ ai_gen_id }}">
              {% if column_image %}
                <img
                  src="{{ column_image | image_url: width: 800 }}"
                  alt="{{ column_image.alt | escape }}"
                  loading="lazy"
                  width="{{ column_image.width }}"
                  height="{{ column_image.height }}"
                  class="ai-multicolumn-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-multicolumn-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if column_heading != blank %}
              <h3 class="ai-multicolumn-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
            {% endif %}

            {% if column_text != blank %}
              <div class="ai-multicolumn-text-{{ ai_gen_id }}">{{ column_text }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</multicolumn-block-{{ ai_gen_id }}>

<script>
  (function() {
    class MulticolumnBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.grid = this.querySelector('.ai-multicolumn-grid-{{ ai_gen_id }}');
        
        if (window.innerWidth <= 749 && this.grid) {
          this.setupMobileCarousel();
        }
      }

      setupMobileCarousel() {
        const isMobileCarousel = '{{ block.settings.mobile_layout }}' === 'carousel';
        
        if (isMobileCarousel) {
          this.grid.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
        }
      }

      handleTouchStart(e) {
        this.touchStartX = e.touches[0].clientX;
      }
    }

    customElements.define('multicolumn-block-{{ ai_gen_id }}', MulticolumnBlock{{ ai_gen_id }});
  })();
</script>

