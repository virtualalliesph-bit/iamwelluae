{% doc %}
  @prompt
    a radio variant picker block that connects to the products variant when applicable. each variant must show in grid with customizable border color and should be a radio button. it should show the variant image, variant title and price. when click it should link to the right variant and should switch accordingly the price. each variant in desktop must show in column and can set how manu column is visible. while in mobile, it must be responsive where the variants are stacked. , make sure to link the variants to the actual variants so that it would fetch the data and it will show the right variant when click on buy it now
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-radio-variant-picker-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-radio-variant-picker__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-radio-variant-picker__option-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-radio-variant-picker__input-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ai-radio-variant-picker__label-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: {{ block.settings.card_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    height: 100%;
  }

  .ai-radio-variant-picker__label-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-radio-variant-picker__input-{{ ai_gen_id }}:checked + .ai-radio-variant-picker__label-{{ ai_gen_id }} {
    background-color: {{ block.settings.selected_background_color }};
    border-color: {{ block.settings.selected_border_color }};
    border-width: {{ block.settings.selected_border_width }}px;
  }

  .ai-radio-variant-picker__input-{{ ai_gen_id }}:disabled + .ai-radio-variant-picker__label-{{ ai_gen_id }} {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-radio-variant-picker__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 12px;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-radio-variant-picker__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    object-fit: cover;
  }

  .ai-radio-variant-picker__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-radio-variant-picker__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-radio-variant-picker__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.text_color }};
    text-align: center;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .ai-radio-variant-picker__input-{{ ai_gen_id }}:checked + .ai-radio-variant-picker__label-{{ ai_gen_id }} .ai-radio-variant-picker__title-{{ ai_gen_id }} {
    color: {{ block.settings.selected_text_color }};
  }

  .ai-radio-variant-picker__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: {{ block.settings.price_font_weight }};
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-radio-variant-picker__input-{{ ai_gen_id }}:checked + .ai-radio-variant-picker__label-{{ ai_gen_id }} .ai-radio-variant-picker__price-{{ ai_gen_id }} {
    color: {{ block.settings.selected_text_color }};
  }

  .ai-radio-variant-picker__sold-out-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: rgba(255, 255, 255, 0.9);
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    color: #000000;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-radio-variant-picker__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<radio-variant-picker-{{ ai_gen_id }}
  class="ai-radio-variant-picker-{{ ai_gen_id }}"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
  {{ block.shopify_attributes }}
>
  {% if product.variants.size > 1 %}
    <div class="ai-radio-variant-picker__grid-{{ ai_gen_id }}">
      {% for variant in product.variants %}
        <div class="ai-radio-variant-picker__option-{{ ai_gen_id }}">
          <input
            type="radio"
            id="variant-{{ ai_gen_id }}-{{ variant.id }}"
            name="variant-{{ ai_gen_id }}"
            value="{{ variant.id }}"
            class="ai-radio-variant-picker__input-{{ ai_gen_id }}"
            data-variant-id="{{ variant.id }}"
            data-variant-url="{{ variant.url }}"
            data-variant-price="{{ variant.price | money }}"
            data-variant-available="{{ variant.available }}"
            {% if variant.id == product.selected_or_first_available_variant.id %}checked{% endif %}
            {% unless variant.available %}disabled{% endunless %}
          >
          <label
            for="variant-{{ ai_gen_id }}-{{ variant.id }}"
            class="ai-radio-variant-picker__label-{{ ai_gen_id }}"
          >
            <div class="ai-radio-variant-picker__image-wrapper-{{ ai_gen_id }}">
              {% if variant.featured_image %}
                <img
                  src="{{ variant.featured_image | image_url: width: 600 }}"
                  alt="{{ variant.featured_image.alt | escape }}"
                  class="ai-radio-variant-picker__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% elsif product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-radio-variant-picker__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-radio-variant-picker__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              {% unless variant.available %}
                <div class="ai-radio-variant-picker__sold-out-{{ ai_gen_id }}">
                  Sold out
                </div>
              {% endunless %}
            </div>
            <div class="ai-radio-variant-picker__title-{{ ai_gen_id }}">
              {{ variant.title }}
            </div>
            <div class="ai-radio-variant-picker__price-{{ ai_gen_id }}">
              {{ variant.price | money }}
            </div>
          </label>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-radio-variant-picker__grid-{{ ai_gen_id }}">
      <div class="ai-radio-variant-picker__option-{{ ai_gen_id }}">
        <input
          type="radio"
          id="variant-{{ ai_gen_id }}-{{ product.selected_or_first_available_variant.id }}"
          name="variant-{{ ai_gen_id }}"
          value="{{ product.selected_or_first_available_variant.id }}"
          class="ai-radio-variant-picker__input-{{ ai_gen_id }}"
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          data-variant-url="{{ product.selected_or_first_available_variant.url }}"
          data-variant-price="{{ product.selected_or_first_available_variant.price | money }}"
          data-variant-available="{{ product.selected_or_first_available_variant.available }}"
          checked
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
        <label
          for="variant-{{ ai_gen_id }}-{{ product.selected_or_first_available_variant.id }}"
          class="ai-radio-variant-picker__label-{{ ai_gen_id }}"
        >
          <div class="ai-radio-variant-picker__image-wrapper-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="ai-radio-variant-picker__image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-radio-variant-picker__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
            {% unless product.selected_or_first_available_variant.available %}
              <div class="ai-radio-variant-picker__sold-out-{{ ai_gen_id }}">
                Sold out
              </div>
            {% endunless %}
          </div>
          <div class="ai-radio-variant-picker__title-{{ ai_gen_id }}">
            {{ product.selected_or_first_available_variant.title }}
          </div>
          <div class="ai-radio-variant-picker__price-{{ ai_gen_id }}">
            {{ product.selected_or_first_available_variant.price | money }}
          </div>
        </label>
      </div>
    </div>
  {% endif %}
</radio-variant-picker-{{ ai_gen_id }}>

<script>
  (function() {
    class RadioVariantPicker{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productId = this.dataset.productId;
        this.sectionId = this.dataset.sectionId;
      }

      connectedCallback() {
        this.inputs = this.querySelectorAll('.ai-radio-variant-picker__input-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.inputs.forEach((input) => {
          input.addEventListener('change', (event) => {
            if (event.target.checked) {
              this.handleVariantChange(event.target);
            }
          });
        });
      }

      handleVariantChange(selectedInput) {
        const variantId = selectedInput.dataset.variantId;
        const variantUrl = selectedInput.dataset.variantUrl;
        const variantPrice = selectedInput.dataset.variantPrice;
        const variantAvailable = selectedInput.dataset.variantAvailable === 'true';

        if (variantUrl) {
          window.history.replaceState({}, '', variantUrl);
        }

        this.updateVariantInputs(variantId);
        this.updatePriceDisplay(variantPrice);
        this.updateAddToCartButtons(variantAvailable);
        this.updateProductMedia(variantId);
        this.dispatchVariantChangeEvent(variantId, variantPrice, variantAvailable);
      }

      updateVariantInputs(variantId) {
        const variantIdInputs = document.querySelectorAll('input[name="id"]');
        variantIdInputs.forEach((input) => {
          input.value = variantId;
        });

        const variantSelects = document.querySelectorAll('select[name="id"]');
        variantSelects.forEach((select) => {
          select.value = variantId;
        });
      }

      updatePriceDisplay(variantPrice) {
        const priceSelectors = [
          '.price__regular .price-item--regular',
          '.price .price-item--regular',
          '[data-price]',
          '.product__price'
        ];

        priceSelectors.forEach((selector) => {
          const priceElements = document.querySelectorAll(selector);
          priceElements.forEach((priceEl) => {
            if (priceEl.closest(`[data-section-id="${this.sectionId}"]`) || 
                priceEl.closest('.product-form') ||
                priceEl.closest('.product')) {
              priceEl.textContent = variantPrice;
            }
          });
        });
      }

      updateAddToCartButtons(variantAvailable) {
        const addToCartButtons = document.querySelectorAll('button[name="add"], .product-form__submit');
        addToCartButtons.forEach((button) => {
          if (button.closest(`[data-section-id="${this.sectionId}"]`) || 
              button.closest('.product-form')) {
            if (variantAvailable) {
              button.disabled = false;
              button.textContent = button.dataset.addToCartText || 'Add to cart';
            } else {
              button.disabled = true;
              button.textContent = button.dataset.soldOutText || 'Sold out';
            }
          }
        });
      }

      updateProductMedia(variantId) {
        const mediaGallery = document.querySelector('media-gallery');
        if (mediaGallery) {
          const variantMedia = mediaGallery.querySelector(`[data-media-id="${variantId}"]`);
          if (variantMedia) {
            mediaGallery.setActiveMedia(variantMedia.dataset.mediaId);
          }
        }

        const productImages = document.querySelectorAll('[data-variant-id]');
        productImages.forEach((img) => {
          if (img.dataset.variantId === variantId) {
            img.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }

      dispatchVariantChangeEvent(variantId, variantPrice, variantAvailable) {
        const event = new CustomEvent('variant:change', {
          detail: {
            variantId: variantId,
            variantPrice: variantPrice,
            variantAvailable: variantAvailable,
            productId: this.productId
          },
          bubbles: true
        });
        this.dispatchEvent(event);

        document.dispatchEvent(new CustomEvent('variant:changed', {
          detail: {
            variantId: variantId,
            variantPrice: variantPrice,
            variantAvailable: variantAvailable,
            productId: this.productId
          }
        }));
      }
    }

    customElements.define('radio-variant-picker-{{ ai_gen_id }}', RadioVariantPicker{{ ai_gen_id }});
  })();
</script>

