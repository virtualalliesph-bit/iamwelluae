      "label": "Label",
      "default": "Ingredient 1"
    },
    {
      "type": "header",
      "content": "Ingredient 2"
    },
    {
      "type": "image_picker",
      "id": "ingredient_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ingredient_2_label",
      "label": "Label",
      "default": "Ingredient 2"
    },
    {
      "type": "header",
      "content": "Ingredient 3"
    },
    {
      "type": "image_picker",
      "id": "ingredient_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ingredient_3_label",
      "label": "Label",
      "default": "Ingredient 3"
    },
    {
      "type": "header",
      "content": "Ingredient 4"
    },
    {
      "type": "image_picker",
      "id": "ingredient_4_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ingredient_4_label",
      "label": "Label",
      "default": "Ingredient 4"
    },
    {
      "type": "header",
      "content": "Ingredient 5"
    },
    {
      "type": "image_picker",
      "id": "ingredient_5_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ingredient_5_label",
      "label": "Label",
      "default": "Ingredient 5"
    },
    {
      "type": "header",
      "content": "Ingredient 6"
    },
    {
      "type": "image_picker",
      "id": "ingredient_6_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ingredient_6_label",
