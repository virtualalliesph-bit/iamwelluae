{% doc %}
  @prompt
     testimonial block where can add a slider bubble of reviews or feedback. each slides should have a star and a featured image,and the comment. each block can have max of 10 reviews. the slider can have navigation of left and right and must be responsive in mobile. it should be optimize to show per feedback or bubble in mobile.
    
    the padding can be adjusted even in mobile where it should only have small space in the edge so it is not too long to read. 
    the desktop view can also customize how many feedback should show every slide. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_desktop }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonial-slider__container-{{ ai_gen_id }} {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-testimonial-slider__track-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-testimonial-slider__slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
  }

  .ai-testimonial-slider__slide-{{ ai_gen_id }} {
    flex: 0 0 calc(100% / {{ block.settings.slides_per_view_desktop }});
    padding: 0 {{ block.settings.slide_gap }}px;
    box-sizing: border-box;
  }

  .ai-testimonial-slider__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-testimonial-slider__header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-testimonial-slider__image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #f0f0f0;
  }

  .ai-testimonial-slider__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-slider__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #e0e0e0;
  }

  .ai-testimonial-slider__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-testimonial-slider__author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonial-slider__author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
  }

  .ai-testimonial-slider__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-testimonial-slider__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonial-slider__star--empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-testimonial-slider__comment-{{ ai_gen_id }} {
    font-size: {{ block.settings.comment_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    flex-grow: 1;
  }

  .ai-testimonial-slider__navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
  }

  .ai-testimonial-slider__nav-button-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_background }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-testimonial-slider__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover }};
  }

  .ai-testimonial-slider__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonial-slider__nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.nav_button_icon_color }};
  }

  .ai-testimonial-slider__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-testimonial-slider__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-testimonial-slider__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-slider-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_mobile }}px;
    }

    .ai-testimonial-slider__slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-testimonial-slider__card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding_mobile }}px;
    }
  }
{% endstyle %}

<testimonial-slider-{{ ai_gen_id }} class="ai-testimonial-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonial-slider__container-{{ ai_gen_id }}">
    <div class="ai-testimonial-slider__track-{{ ai_gen_id }}">
      <div class="ai-testimonial-slider__slides-{{ ai_gen_id }}">
        {% for i in (1..10) %}
          {% liquid
            assign review_enabled_key = 'review_' | append: i | append: '_enabled'
            assign author_name_key = 'review_' | append: i | append: '_author_name'
            assign author_image_key = 'review_' | append: i | append: '_author_image'
            assign rating_key = 'review_' | append: i | append: '_rating'
            assign comment_key = 'review_' | append: i | append: '_comment'

            assign review_enabled = block.settings[review_enabled_key]
            assign author_name = block.settings[author_name_key]
            assign author_image = block.settings[author_image_key]
            assign rating = block.settings[rating_key]
            assign comment = block.settings[comment_key]
          %}

          {% if review_enabled %}
            <div class="ai-testimonial-slider__slide-{{ ai_gen_id }}" data-slide-index="{{ forloop.index0 }}">
              <div class="ai-testimonial-slider__card-{{ ai_gen_id }}">
                <div class="ai-testimonial-slider__header-{{ ai_gen_id }}">
                  <div class="ai-testimonial-slider__image-wrapper-{{ ai_gen_id }}">
                    {% if author_image %}
                      <img
                        src="{{ author_image | image_url: width: 200 }}"
                        alt="{{ author_name | escape }}"
                        class="ai-testimonial-slider__image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="200"
                        height="200"
                      >
                    {% else %}
                      <div class="ai-testimonial-slider__image-placeholder-{{ ai_gen_id }}">
                        {{ 'image' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-testimonial-slider__author-info-{{ ai_gen_id }}">
                    {% if author_name != blank %}
                      <h3 class="ai-testimonial-slider__author-name-{{ ai_gen_id }}">{{ author_name }}</h3>
                    {% endif %}
                    <div class="ai-testimonial-slider__stars-{{ ai_gen_id }}">
                      {% for star in (1..5) %}
                        {% if star <= rating %}
                          <svg class="ai-testimonial-slider__star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        {% else %}
                          <svg class="ai-testimonial-slider__star-{{ ai_gen_id }} ai-testimonial-slider__star--empty-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
                {% if comment != blank %}
                  <div class="ai-testimonial-slider__comment-{{ ai_gen_id }}">{{ comment }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-testimonial-slider__navigation-{{ ai_gen_id }}">
      <button
        class="ai-testimonial-slider__nav-button-{{ ai_gen_id }} ai-testimonial-slider__nav-button--prev-{{ ai_gen_id }}"
        aria-label="Previous testimonial"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>

      <div class="ai-testimonial-slider__dots-{{ ai_gen_id }}"></div>

      <button
        class="ai-testimonial-slider__nav-button-{{ ai_gen_id }} ai-testimonial-slider__nav-button--next-{{ ai_gen_id }}"
        aria-label="Next testimonial"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
        </svg>
      </button>
    </div>
  </div>
</testimonial-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = {{ block.settings.slides_per_view_desktop }};
        this.isMobile = window.innerWidth < 750;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-testimonial-slider__slides-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-testimonial-slider__slide-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-testimonial-slider__nav-button--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-testimonial-slider__nav-button--next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-testimonial-slider__dots-{{ ai_gen_id }}');

        this.totalSlides = this.slides.length;

        if (this.totalSlides === 0) return;

        this.updateSlidesPerView();
        this.createDots();
        this.updateSlider();
        this.attachEventListeners();

        window.addEventListener('resize', () => {
          const wasMobile = this.isMobile;
          this.isMobile = window.innerWidth < 750;
          if (wasMobile !== this.isMobile) {
            this.updateSlidesPerView();
            this.currentIndex = 0;
            this.createDots();
            this.updateSlider();
          }
        });
      }

      updateSlidesPerView() {
        this.slidesPerView = this.isMobile ? 1 : {{ block.settings.slides_per_view_desktop }};
        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        const totalPages = Math.ceil(this.totalSlides / this.slidesPerView);

        for (let i = 0; i < totalPages; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-testimonial-slider__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i * this.slidesPerView));
          this.dotsContainer.appendChild(dot);
        }

        this.dots = Array.from(this.dotsContainer.querySelectorAll('.ai-testimonial-slider__dot-{{ ai_gen_id }}'));
      }

      attachEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.next();
            } else {
              this.prev();
            }
          }
          isDragging = false;
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex = Math.max(0, this.currentIndex - this.slidesPerView);
          this.updateSlider();
        }
      }

      next() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex = Math.min(this.maxIndex, this.currentIndex + this.slidesPerView);
          this.updateSlider();
        }
      }

      goToSlide(index) {
        this.currentIndex = Math.min(index, this.maxIndex);
        this.updateSlider();
      }

      updateSlider() {
        const slideWidth = 100 / this.slidesPerView;
        const offset = -(this.currentIndex * slideWidth);
        this.track.style.transform = `translateX(${offset}%)`;

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= this.maxIndex;

        const activeDotIndex = Math.floor(this.currentIndex / this.slidesPerView);
        this.dots.forEach((dot, index) => {
          if (index === activeDotIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('testimonial-slider-{{ ai_gen_id }}', TestimonialSlider{{ ai_gen_id }});
  })();
</script>

