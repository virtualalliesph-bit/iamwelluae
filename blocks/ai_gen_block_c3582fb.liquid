{% doc %}
  @prompt
    A BLOCK THAT HAS 2 COLUMNS IN DESKTOP, ONE COLUMN SHOWCASE THE IMAGE - THEN THE SECOND COLUMN SHOWCASE THE PRODUCT CHECKLIST
    THE CHECKLIST MUST BE IN BULLET POINTS - WHERE I CAN CHOOSE AN ICON TO USE FOR EACH BULLET. IT MUST ALSO BE CUSTOMIZABLE IN SIZE, COLOR AND PADDING OR MARGIN. IT MUST BE RSPONSIVE IN MOBILE. IN MOBILE IT CAN BE STACKED, WHERE THE COLUMNS WILL BECOME TWO ROWS. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-checklist-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-checklist__image-column-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-checklist__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-image-checklist__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-checklist__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-image-checklist__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-image-checklist__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-checklist__content-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-image-checklist__heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-image-checklist__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-image-checklist__item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-image-checklist__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-top: {{ block.settings.icon_margin_top }}px;
  }

  .ai-image-checklist__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-image-checklist__text-{{ ai_gen_id }} {
    flex: 1;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-image-checklist-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_row_gap }}px;
    }

    {% if block.settings.mobile_image_first %}
      .ai-image-checklist__image-column-{{ ai_gen_id }} {
        order: 1;
      }

      .ai-image-checklist__content-column-{{ ai_gen_id }} {
        order: 2;
      }
    {% else %}
      .ai-image-checklist__image-column-{{ ai_gen_id }} {
        order: 2;
      }

      .ai-image-checklist__content-column-{{ ai_gen_id }} {
        order: 1;
      }
    {% endif %}

    .ai-image-checklist__content-column-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_content_padding }}px;
    }

    .ai-image-checklist__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-image-checklist__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-image-checklist__icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }
  }
{% endstyle %}

<div class="ai-image-checklist-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-checklist__image-column-{{ ai_gen_id }}">
    <div class="ai-image-checklist__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-image-checklist__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-checklist__image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-image-checklist__empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="ai-image-checklist__content-column-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-image-checklist__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <ul class="ai-image-checklist__list-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign item_enabled_key = 'item_' | append: i | append: '_enabled'
          assign item_text_key = 'item_' | append: i | append: '_text'
          assign item_icon_key = 'item_' | append: i | append: '_icon'

          assign item_enabled = block.settings[item_enabled_key]
          assign item_text = block.settings[item_text_key]
          assign item_icon = block.settings[item_icon_key]
        %}

        {% if item_enabled and item_text != blank %}
          <li class="ai-image-checklist__item-{{ ai_gen_id }}">
            <div class="ai-image-checklist__icon-{{ ai_gen_id }}">
              {% case item_icon %}
                {% when 'checkmark' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                {% when 'star' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                {% when 'heart' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                {% when 'circle' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"/>
                  </svg>
                {% when 'arrow' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                  </svg>
                {% when 'plus' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                  </svg>
              {% endcase %}
            </div>
            <div class="ai-image-checklist__text-{{ ai_gen_id }}">{{ item_text }}</div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

