{% doc %}
  @prompt
    a testimonial block where can add a slider bubble of reviews or feedback. each slides should have a star and a featured image,and the comment. each block can have max of 10 reviews. the slider can have navigation of left and right and must be responsive in mobile. it should be optimize to show per feedback or bubble in mobile. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonial-slider__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-testimonial-slider__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-testimonial-slider__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-testimonial-slider__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-testimonial-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin: 0 60px;
  }

  .ai-testimonial-slider__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-testimonial-slider__slide-{{ ai_gen_id }} {
    min-width: 100%;
    padding: 0 10px;
    box-sizing: border-box;
  }

  .ai-testimonial-slider__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow }};
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 300px;
  }

  .ai-testimonial-slider__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  .ai-testimonial-slider__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-slider__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-slider__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-testimonial-slider__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 15px;
  }

  .ai-testimonial-slider__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonial-slider__star--empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-testimonial-slider__comment-{{ ai_gen_id }} {
    font-size: {{ block.settings.comment_size }}px;
    color: {{ block.settings.comment_color }};
    line-height: 1.6;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .ai-testimonial-slider__author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_size }}px;
    color: {{ block.settings.author_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-testimonial-slider__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_background }};
    color: {{ block.settings.nav_color }};
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .ai-testimonial-slider__nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_hover_background }};
    color: {{ block.settings.nav_hover_color }};
  }

  .ai-testimonial-slider__nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonial-slider__nav--prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-testimonial-slider__nav--next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-testimonial-slider__nav-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
  }

  .ai-testimonial-slider__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 30px;
  }

  .ai-testimonial-slider__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .ai-testimonial-slider__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  @media screen and (min-width: 750px) {
    .ai-testimonial-slider__slide-{{ ai_gen_id }} {
      min-width: calc(100% / {{ block.settings.slides_per_view_desktop }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-slider__wrapper-{{ ai_gen_id }} {
      margin: 0 50px;
    }

    .ai-testimonial-slider__slide-{{ ai_gen_id }} {
      min-width: 100%;
    }

    .ai-testimonial-slider__nav-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .ai-testimonial-slider__nav-icon-{{ ai_gen_id }} {
      width: 16px;
      height: 16px;
    }

    .ai-testimonial-slider__card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<testimonial-slider-{{ ai_gen_id }} class="ai-testimonial-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonial-slider__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-testimonial-slider__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-testimonial-slider__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-testimonial-slider__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-testimonial-slider__wrapper-{{ ai_gen_id }}">
      <button
        class="ai-testimonial-slider__nav-{{ ai_gen_id }} ai-testimonial-slider__nav--prev-{{ ai_gen_id }}"
        aria-label="Previous testimonial"
        data-nav="prev"
      >
        <svg class="ai-testimonial-slider__nav-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-testimonial-slider__track-{{ ai_gen_id }}" data-track>
        {% for i in (1..10) %}
          {% liquid
            assign review_enabled_key = 'review_' | append: i | append: '_enabled'
            assign review_image_key = 'review_' | append: i | append: '_image'
            assign review_name_key = 'review_' | append: i | append: '_name'
            assign review_rating_key = 'review_' | append: i | append: '_rating'
            assign review_comment_key = 'review_' | append: i | append: '_comment'

            assign review_enabled = block.settings[review_enabled_key]
            assign review_image = block.settings[review_image_key]
            assign review_name = block.settings[review_name_key]
            assign review_rating = block.settings[review_rating_key]
            assign review_comment = block.settings[review_comment_key]
          %}

          {% if review_enabled %}
            <div class="ai-testimonial-slider__slide-{{ ai_gen_id }}">
              <div class="ai-testimonial-slider__card-{{ ai_gen_id }}">
                <div class="ai-testimonial-slider__image-wrapper-{{ ai_gen_id }}">
                  {% if review_image %}
                    <img
                      src="{{ review_image | image_url: width: 200 }}"
                      alt="{{ review_name | escape }}"
                      class="ai-testimonial-slider__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {% else %}
                    <div class="ai-testimonial-slider__image-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                <div class="ai-testimonial-slider__stars-{{ ai_gen_id }}">
                  {% for star in (1..5) %}
                    {% if star <= review_rating %}
                      <svg class="ai-testimonial-slider__star-{{ ai_gen_id }}" viewBox="0 0 24 24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% else %}
                      <svg class="ai-testimonial-slider__star-{{ ai_gen_id }} ai-testimonial-slider__star--empty-{{ ai_gen_id }}" viewBox="0 0 24 24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% endif %}
                  {% endfor %}
                </div>

                {% if review_comment != blank %}
                  <div class="ai-testimonial-slider__comment-{{ ai_gen_id }}">
                    {{ review_comment }}
                  </div>
                {% endif %}

                {% if review_name != blank %}
                  <p class="ai-testimonial-slider__author-{{ ai_gen_id }}">{{ review_name }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button
        class="ai-testimonial-slider__nav-{{ ai_gen_id }} ai-testimonial-slider__nav--next-{{ ai_gen_id }}"
        aria-label="Next testimonial"
        data-nav="next"
      >
        <svg class="ai-testimonial-slider__nav-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-testimonial-slider__dots-{{ ai_gen_id }}" data-dots></div>
  </div>
</testimonial-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = 1;
        this.totalSlides = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.slides = Array.from(this.querySelectorAll('.ai-testimonial-slider__slide-{{ ai_gen_id }}'));
        this.prevBtn = this.querySelector('[data-nav="prev"]');
        this.nextBtn = this.querySelector('[data-nav="next"]');
        this.dotsContainer = this.querySelector('[data-dots]');

        this.totalSlides = this.slides.length;

        if (this.totalSlides === 0) return;

        this.updateSlidesPerView();
        this.createDots();
        this.setupEventListeners();
        this.updateSlider();

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.createDots();
          this.updateSlider();
        });
      }

      updateSlidesPerView() {
        if (window.innerWidth >= 750) {
          this.slidesPerView = {{ block.settings.slides_per_view_desktop }};
        } else {
          this.slidesPerView = 1;
        }
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        const totalDots = Math.ceil(this.totalSlides / this.slidesPerView);

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-testimonial-slider__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }

        this.dots = Array.from(this.dotsContainer.querySelectorAll('.ai-testimonial-slider__dot-{{ ai_gen_id }}'));
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.prev());
        this.nextBtn.addEventListener('click', () => this.next());

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.next();
            } else {
              this.prev();
            }
          }
          isDragging = false;
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSlider();
        }
      }

      next() {
        const maxIndex = Math.ceil(this.totalSlides / this.slidesPerView) - 1;
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateSlider();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateSlider();
      }

      updateSlider() {
        const slideWidth = 100 / this.slidesPerView;
        const offset = -this.currentIndex * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        const maxIndex = Math.ceil(this.totalSlides / this.slidesPerView) - 1;
        this.prevBtn.disabled = this.currentIndex === 0;
        this.nextBtn.disabled = this.currentIndex === maxIndex;

        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('testimonial-slider-{{ ai_gen_id }}', TestimonialSlider{{ ai_gen_id }});
  })();
</script>

