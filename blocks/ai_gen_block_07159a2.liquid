{% doc %}
  @prompt
    a hologram product card with a buy now button. the buy now must have small cart icon. the colors and size must be customizable. it can only be one card. the block must be responsive in mobile too
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hologram-card-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ block.settings.card_max_width }}px;
    margin: 0 auto;
  }

  .ai-hologram-card__container-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    overflow: hidden;
  }

  .ai-hologram-card__container-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      45deg,
      transparent 30%,
      {{ block.settings.hologram_color_1 }} 40%,
      {{ block.settings.hologram_color_2 }} 50%,
      {{ block.settings.hologram_color_3 }} 60%,
      transparent 70%
    );
    opacity: {{ block.settings.hologram_opacity | divided_by: 100.0 }};
    animation: ai-hologram-shine-{{ ai_gen_id }} {{ block.settings.hologram_speed }}s linear infinite;
    pointer-events: none;
  }

  @keyframes ai-hologram-shine-{{ ai_gen_id }} {
    0% {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    100% {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  .ai-hologram-card__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-hologram-card__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-hologram-card__image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hologram-card__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-hologram-card__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-hologram-card__info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-hologram-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-hologram-card__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: 500;
    color: {{ block.settings.price_color }};
  }

  .ai-hologram-card__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
  }

  .ai-hologram-card__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
  }

  .ai-hologram-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-hologram-card__cart-icon-{{ ai_gen_id }} {
    width: {{ block.settings.cart_icon_size }}px;
    height: {{ block.settings.cart_icon_size }}px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-hologram-card__container-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }

    .ai-hologram-card__content-{{ ai_gen_id }} {
      gap: {{ block.settings.content_gap | times: 0.75 }}px;
    }

    .ai-hologram-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.85 }}px;
    }

    .ai-hologram-card__price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_font_size | times: 0.85 }}px;
    }

    .ai-hologram-card__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size | times: 0.85 }}px;
    }

    .ai-hologram-card__button-{{ ai_gen_id }} {
      padding: {{ block.settings.button_padding_vertical | times: 0.85 }}px {{ block.settings.button_padding_horizontal | times: 0.85 }}px;
      font-size: {{ block.settings.button_font_size | times: 0.85 }}px;
    }

    .ai-hologram-card__cart-icon-{{ ai_gen_id }} {
      width: {{ block.settings.cart_icon_size | times: 0.85 }}px;
      height: {{ block.settings.cart_icon_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<hologram-product-card-{{ ai_gen_id }} class="ai-hologram-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hologram-card__container-{{ ai_gen_id }}">
    <div class="ai-hologram-card__content-{{ ai_gen_id }}">
      <div class="ai-hologram-card__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.product and block.settings.product.featured_image %}
          <img
            src="{{ block.settings.product.featured_image | image_url: width: 800 }}"
            alt="{{ block.settings.product.featured_image.alt | escape }}"
            loading="lazy"
            width="800"
            height="800"
          >
        {% else %}
          <div class="ai-hologram-card__image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-hologram-card__info-{{ ai_gen_id }}">
        <h3 class="ai-hologram-card__title-{{ ai_gen_id }}">
          {% if block.settings.product %}
            {{ block.settings.product.title }}
          {% else %}
            Product title
          {% endif %}
        </h3>

        <div class="ai-hologram-card__price-{{ ai_gen_id }}">
          {% if block.settings.product %}
            {{ block.settings.product.price | money }}
          {% else %}
            ₱0.00
          {% endif %}
        </div>

        {% if block.settings.show_description %}
          <div class="ai-hologram-card__description-{{ ai_gen_id }}">
            {% if block.settings.product and block.settings.product.description != blank %}
              {{ block.settings.product.description | strip_html | truncate: 120 }}
            {% else %}
              Add a product to display its description
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if block.settings.product %}
        <a
          href="{{ block.settings.product.url }}"
          class="ai-hologram-card__button-{{ ai_gen_id }}"
        >
          <svg
            class="ai-hologram-card__cart-icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          {{ block.settings.button_text }}
        </a>
      {% else %}
        <button class="ai-hologram-card__button-{{ ai_gen_id }}" disabled>
          <svg
            class="ai-hologram-card__cart-icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          {{ block.settings.button_text }}
        </button>
      {% endif %}
    </div>
  </div>
</hologram-product-card-{{ ai_gen_id }}>

<script>
  (function() {
    class HologramProductCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('hologram-product-card-{{ ai_gen_id }}', HologramProductCard{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Hologram product card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_max_width",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Maximum width",
      "default": 400
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#1a1a2e"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding",
      "default": 25
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Content spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Hologram effect"
    },
    {
      "type": "color",
      "id": "hologram_color_1",
      "label": "Color 1",
      "default": "#ff00ff"
    },
    {
      "type": "color",
      "id": "hologram_color_2",
      "label": "Color 2",
      "default": "#00ffff"
    },
    {
      "type": "color",
      "id": "hologram_color_3",
      "label": "Color 3",
      "default": "#ffff00"
    },
    {
      "type": "range",
      "id": "hologram_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacity",
      "default": 30
    },
    {
      "type": "range",
      "id": "hologram_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Animation speed",
      "default": 6
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "min": 12,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 18
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color",
      "default": "#00ffff"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Buy Now"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background",
      "default": "#ff00ff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background",
      "default": "#cc00cc"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Cart icon"
    },
    {
      "type": "range",
      "id": "cart_icon_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Hologram product card"
    }
  ]
}
{% endschema %}